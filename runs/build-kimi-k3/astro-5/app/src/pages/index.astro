---
import Layout from '../layouts/Layout.astro';
import PokemonCard from '../components/PokemonCard.astro';
import { getHomeData } from '../lib/data.js';
import { API_BASE } from '../lib/api.js';

const PER_PAGE = 48;

const { list, types, generations } = await getHomeData();
const typeNames = Object.fromEntries(types.map((t) => [t.name, t.english]));

const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim();
const type = params.get('type') ?? '';
const generation = params.get('generation') ?? '';

const matches = list.filter((s) => {
  if (q && !s.human.toLowerCase().includes(q.toLowerCase())) return false;
  if (type && !s.types.includes(type)) return false;
  if (generation && s.generation !== generation) return false;
  return true;
});

const totalPages = Math.ceil(matches.length / PER_PAGE);
let page = parseInt(params.get('page') ?? '1', 10);
if (!Number.isFinite(page) || page < 1) page = 1;
if (totalPages > 0 && page > totalPages) page = totalPages;
const pageItems = matches.slice((page - 1) * PER_PAGE, page * PER_PAGE);

const pageUrl = (n: number) => {
  const p = new URLSearchParams();
  if (q) p.set('q', q);
  if (type) p.set('type', type);
  if (generation) p.set('generation', generation);
  if (n > 1) p.set('page', String(n));
  const s = p.toString();
  return s ? `/?${s}` : '/';
};

const clientData = JSON.stringify({
  apiBase: API_BASE,
  perPage: PER_PAGE,
  typeNames,
  species: list,
}).replace(/</g, '\\u003c');
---

<Layout title="Pokédex">
  <h1>Pokémon</h1>

  <div class="controls">
    <div class="control">
      <label for="search">Search</label>
      <input type="search" id="search" name="q" value={q} autocomplete="off" />
    </div>
    <div class="control">
      <label for="type-filter">Type</label>
      <select id="type-filter">
        <option value="">All types</option>
        {types.map((t) => <option value={t.name} selected={t.name === type}>{t.english}</option>)}
      </select>
    </div>
    <div class="control">
      <label for="generation-filter">Generation</label>
      <select id="generation-filter">
        <option value="">All generations</option>
        {generations.map((g) => <option value={g.name} selected={g.name === generation}>{g.english}</option>)}
      </select>
    </div>
  </div>

  <p class="count" id="result-count">{matches.length} Pokémon</p>

  <div id="grid-container">
    {
      pageItems.length > 0 ? (
        <ul class="card-grid">
          {pageItems.map((s) => (
            <PokemonCard
              id={s.id}
              name={s.name}
              types={s.types.map((t) => ({ name: t, english: typeNames[t] ?? t }))}
            />
          ))}
        </ul>
      ) : (
        <p class="empty">No Pokémon found</p>
      )
    }
  </div>

  <div class="pagination" id="pagination">
    {
      totalPages > 0 && (
        <>
          {page > 1 && (
            <a class="page-link" href={pageUrl(page - 1)}>
              Previous page
            </a>
          )}
          <span class="page-status">
            Page {page} of {totalPages}
          </span>
          {page < totalPages && (
            <a class="page-link" href={pageUrl(page + 1)}>
              Next page
            </a>
          )}
        </>
      )
    }
  </div>

  <script id="home-data" type="application/json" set:html={clientData}></script>

  <script>
    const dataEl = document.getElementById('home-data');
    if (dataEl) {
      const { apiBase, perPage, typeNames, species } = JSON.parse(dataEl.textContent);
      const searchInput = document.getElementById('search');
      const typeSel = document.getElementById('type-filter');
      const genSel = document.getElementById('generation-filter');
      const countEl = document.getElementById('result-count');
      const gridEl = document.getElementById('grid-container');
      const pageEl = document.getElementById('pagination');

      const esc = (s) =>
        String(s).replace(
          /[&<>"']/g,
          (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
        );

      const state = {
        q: searchInput.value,
        type: typeSel.value,
        generation: genSel.value,
        page: Math.max(1, parseInt(new URLSearchParams(location.search).get('page') ?? '1', 10) || 1),
      };

      const filtered = () => {
        const q = state.q.trim().toLowerCase();
        return species.filter((s) => {
          if (q && !s.human.toLowerCase().includes(q)) return false;
          if (state.type && !s.types.includes(state.type)) return false;
          if (state.generation && s.generation !== state.generation) return false;
          return true;
        });
      };

      const buildUrl = (page) => {
        const p = new URLSearchParams();
        if (state.q.trim()) p.set('q', state.q.trim());
        if (state.type) p.set('type', state.type);
        if (state.generation) p.set('generation', state.generation);
        if (page > 1) p.set('page', String(page));
        const s = p.toString();
        return s ? `/?${s}` : '/';
      };

      const cardHTML = (s) => {
        const badges = s.types
          .map((t) => `<span class="badge type-${esc(t)}">${esc(typeNames[t] ?? t)}</span>`)
          .join('');
        return (
          `<li class="poke-card"><a href="/pokemon/${esc(s.name)}">` +
          `<img src="${apiBase}/media/sprites/pokemon/${s.id}.png" alt="" width="96" height="96" loading="lazy">` +
          `<span class="dex">#${String(s.id).padStart(4, '0')}</span>` +
          `<span class="poke-name">${esc(s.human)}</span>` +
          (badges ? `<span class="badges">${badges}</span>` : '') +
          `</a></li>`
        );
      };

      const render = (historyMode) => {
        const matches = filtered();
        const totalPages = Math.ceil(matches.length / perPage);
        if (totalPages > 0 && state.page > totalPages) state.page = totalPages;
        if (state.page < 1) state.page = 1;
        const items = matches.slice((state.page - 1) * perPage, state.page * perPage);

        countEl.textContent = `${matches.length} Pokémon`;
        gridEl.innerHTML = items.length
          ? `<ul class="card-grid">${items.map(cardHTML).join('')}</ul>`
          : `<p class="empty">No Pokémon found</p>`;
        pageEl.innerHTML =
          totalPages === 0
            ? ''
            : (state.page > 1
                ? `<a class="page-link" href="${buildUrl(state.page - 1)}">Previous page</a>`
                : '') +
              `<span class="page-status">Page ${state.page} of ${totalPages}</span>` +
              (state.page < totalPages
                ? `<a class="page-link" href="${buildUrl(state.page + 1)}">Next page</a>`
                : '');

        const url = buildUrl(state.page);
        if (historyMode === 'push') history.pushState(null, '', url);
        else if (historyMode === 'replace') history.replaceState(null, '', url);
      };

      let timer;
      searchInput.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          state.q = searchInput.value;
          state.page = 1;
          render('replace');
        }, 150);
      });
      typeSel.addEventListener('change', () => {
        state.type = typeSel.value;
        state.page = 1;
        render('push');
      });
      genSel.addEventListener('change', () => {
        state.generation = genSel.value;
        state.page = 1;
        render('push');
      });
      window.addEventListener('popstate', () => location.reload());
    }
  </script>
</Layout>
