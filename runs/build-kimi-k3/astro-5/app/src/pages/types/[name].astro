---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import NotFound from '../../components/NotFound.astro';
import { getTypeData } from '../../lib/data.js';

const { name } = Astro.params;
const data = await getTypeData(name ?? '');
if (!data) {
  Astro.response.status = 404;
}
---

{
  data === null ? (
    <NotFound />
  ) : (
    <Layout title={`${data.english} – Pokédex`}>
      <h1>{data.english}</h1>

      <Section id="damage-relations" title="Damage relations">
        <dl class="relations">
          {data.relations.map(([term, links]) => (
            <div>
              <dt>{term}</dt>
              <dd>
                {links.length > 0
                  ? links.map((l) => (
                      <TypeBadge name={l.name} english={l.english} href={`/types/${l.name}`} />
                    ))
                  : 'None'}
              </dd>
            </div>
          ))}
        </dl>
      </Section>

      <Section id="pokemon" title="Pokémon">
        <p class="count">{data.mons.length} Pokémon</p>
        <ul class="card-grid">
          {data.mons.map((s) => (
            <PokemonCard id={s.id} name={s.name} />
          ))}
        </ul>
      </Section>

      <Section id="moves" title="Moves">
        <p class="count">{data.moves.length} moves</p>
        <ul class="move-list">
          {data.moves.map((m) => (
            <li>
              <a href={`/moves/${m.name}`}>{m.human}</a>
            </li>
          ))}
        </ul>
      </Section>
    </Layout>
  )
}
