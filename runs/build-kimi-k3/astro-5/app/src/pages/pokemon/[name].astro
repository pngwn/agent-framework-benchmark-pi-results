---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import EvoNode from '../../components/EvoNode.astro';
import NotFound from '../../components/NotFound.astro';
import { getPokemonData, getMoveTables, evolutionTree } from '../../lib/data.js';
import {
  dexNumber,
  englishName,
  humanize,
  latestEnglishFlavor,
  missing,
  STAT_LABELS,
} from '../../lib/util.js';

const { name } = Astro.params;
const data = await getPokemonData(name ?? '');

let page = null;
if (data) {
  const { species, pokemon, chain, groups, typeNames } = data;
  const enName = englishName(species);
  const genus = (species.genera ?? []).find((g) => g.language?.name === 'en')?.genus ?? null;
  const flavor = latestEnglishFlavor(species.flavor_text_entries);
  const height = (pokemon.height / 10).toFixed(1);
  const weight = (pokemon.weight / 10).toFixed(1);
  const artwork =
    pokemon.sprites?.other?.['official-artwork']?.front_default ?? pokemon.sprites?.front_default ?? null;
  const pokeTypes = [...(pokemon.types ?? [])]
    .sort((a, b) => a.slot - b.slot)
    .map((t) => ({ name: t.type.name, english: typeNames[t.type.name] ?? humanize(t.type.name) }));
  const stats = (pokemon.stats ?? []).map((s) => ({
    label: STAT_LABELS[s.stat.name] ?? humanize(s.stat.name),
    value: s.base_stat,
  }));
  const total = stats.reduce((sum, s) => sum + s.value, 0);
  const abilities = [...(pokemon.abilities ?? [])]
    .sort((a, b) => a.slot - b.slot)
    .map((a) => ({ name: a.ability.name, human: humanize(a.ability.name), hidden: !!a.is_hidden }));
  const evo = evolutionTree(chain);

  const gameParam = Astro.url.searchParams.get('game') ?? '';
  const selected = groups.find((g) => g.name === gameParam) ?? groups[groups.length - 1] ?? null;
  const tables = selected ? await getMoveTables(pokemon, selected.name, typeNames) : [];

  page = {
    enName,
    genus,
    flavor,
    height,
    weight,
    artwork,
    pokeTypes,
    stats,
    total,
    abilities,
    evo,
    groups,
    selected,
    tables,
    speciesId: species.id,
  };
} else {
  Astro.response.status = 404;
}
---

{
  page === null ? (
    <NotFound />
  ) : (
    <Layout title={`${page.enName} – Pokédex`}>
      <div class="panel summary">
        {page.artwork && (
          <img class="artwork" src={page.artwork} alt={page.enName} width="288" height="288" />
        )}
        <div class="summary-body">
          <p class="dex">{dexNumber(page.speciesId)}</p>
          <h1>{page.enName}</h1>
          {page.genus && <p class="genus">{page.genus}</p>}
          <p class="type-links">
            {page.pokeTypes.map((t) => (
              <TypeBadge name={t.name} english={t.english} href={`/types/${t.name}`} />
            ))}
          </p>
          <dl class="fact-list">
            <div>
              <dt>Height</dt>
              <dd>{page.height} m</dd>
            </div>
            <div>
              <dt>Weight</dt>
              <dd>{page.weight} kg</dd>
            </div>
          </dl>
          {page.flavor && <p class="flavor">{page.flavor}</p>}
        </div>
      </div>

      <Section id="stats" title="Base stats">
        <table class="stats-table">
          <tbody>
            {page.stats.map((s) => (
              <tr>
                <th scope="row">{s.label}</th>
                <td class="num">{s.value}</td>
                <td class="bar" aria-hidden="true">
                  <span class="track">
                    <span class="fill" style={`width: ${Math.min(100, (s.value / 255) * 100)}%`} />
                  </span>
                </td>
              </tr>
            ))}
            <tr class="total">
              <th scope="row">Total</th>
              <td class="num">{page.total}</td>
              <td class="bar" aria-hidden="true">
                <span class="track">
                  <span class="fill" style={`width: ${Math.min(100, (page.total / 255) * 100)}%`} />
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </Section>

      <Section id="abilities" title="Abilities">
        <ul class="link-list">
          {page.abilities.map((a) => (
            <li>
              <a href={`/abilities/${a.name}`}>{a.human}</a>
              {a.hidden && <span class="hidden-note"> (hidden)</span>}
            </li>
          ))}
        </ul>
      </Section>

      {page.evo && (
        <Section id="evolution" title="Evolution">
          <ul class="link-list">
            <EvoNode node={page.evo} />
          </ul>
        </Section>
      )}

      <Section id="moves" title="Moves">
        {page.selected && (
          <div class="game-picker">
            <label for="game-select">Game</label>
            <select id="game-select" data-default={page.groups[page.groups.length - 1]?.name ?? ''}>
              {page.groups.map((g) => (
                <option value={g.name} selected={page.selected && g.name === page.selected.name}>
                  {g.human}
                </option>
              ))}
            </select>
          </div>
        )}
        {page.tables.map((table) => (
          <table class="moves-table">
            <caption>{table.human}</caption>
            <thead>
              <tr>
                {table.method === 'level-up' && (
                  <th scope="col" data-type="number">
                    <button type="button">Level</button>
                  </th>
                )}
                <th scope="col">
                  <button type="button">Move</button>
                </th>
                <th scope="col">
                  <button type="button">Type</button>
                </th>
                <th scope="col">
                  <button type="button">Category</button>
                </th>
                <th scope="col" data-type="number">
                  <button type="button">Power</button>
                </th>
                <th scope="col" data-type="number">
                  <button type="button">Accuracy</button>
                </th>
                <th scope="col" data-type="number">
                  <button type="button">PP</button>
                </th>
              </tr>
            </thead>
            <tbody>
              {table.rows.map((r) => (
                <tr>
                  {table.method === 'level-up' && <td data-v={String(r.level)}>{r.level}</td>}
                  <td data-v={r.english}>
                    <a href={`/moves/${r.name}`}>{r.english}</a>
                  </td>
                  <td data-v={r.typeEnglish}>
                    <TypeBadge name={r.type} english={r.typeEnglish} href={`/types/${r.type}`} />
                  </td>
                  <td data-v={r.category}>{r.category}</td>
                  <td data-v={r.power === null ? '' : String(r.power)}>{missing(r.power)}</td>
                  <td data-v={r.accuracy === null ? '' : String(r.accuracy)}>{missing(r.accuracy)}</td>
                  <td data-v={r.pp === null ? '' : String(r.pp)}>{missing(r.pp)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ))}
      </Section>

      <script>
        const gameSelect = document.getElementById('game-select');
        if (gameSelect) {
          gameSelect.addEventListener('change', () => {
            const url = new URL(window.location.href);
            url.hash = '';
            url.search = '';
            if (gameSelect.value && gameSelect.value !== gameSelect.dataset.default) {
              url.searchParams.set('game', gameSelect.value);
            }
            window.location.assign(url.toString());
          });
        }

        for (const table of document.querySelectorAll('table.moves-table')) {
          const heads = [...table.querySelectorAll('thead th')];
          const tbody = table.tBodies[0];
          if (!tbody) continue;
          let sortCol = -1;
          let dir = 1;
          heads.forEach((th, i) => {
            const trigger = th.querySelector('button') ?? th;
            trigger.addEventListener('click', () => {
              dir = sortCol === i ? -dir : 1;
              sortCol = i;
              heads.forEach((h) => h.removeAttribute('aria-sort'));
              th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
              const numeric = th.dataset.type === 'number';
              const rows = [...tbody.rows];
              rows.sort((a, b) => {
                const av = a.cells[i]?.dataset.v ?? '';
                const bv = b.cells[i]?.dataset.v ?? '';
                if (av === '' && bv === '') return 0;
                if (av === '') return 1; // missing values sort last in both directions
                if (bv === '') return -1;
                const cmp = numeric ? Number(av) - Number(bv) : av.localeCompare(bv);
                return cmp * dir;
              });
              for (const r of rows) tbody.appendChild(r);
            });
          });
        }
      </script>
    </Layout>
  )
}
