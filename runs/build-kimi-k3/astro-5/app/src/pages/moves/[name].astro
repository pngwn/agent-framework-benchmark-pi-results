---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import NotFound from '../../components/NotFound.astro';
import { getMoveData } from '../../lib/data.js';
import { humanize, missing } from '../../lib/util.js';

const { name } = Astro.params;
const data = await getMoveData(name ?? '');
if (!data) {
  Astro.response.status = 404;
}
---

{
  data === null ? (
    <NotFound />
  ) : (
    <Layout title={`${data.english} – Pokédex`}>
      <h1>{data.english}</h1>

      <div class="panel">
        <dl class="fact-list">
          <div>
            <dt>Type</dt>
            <dd>
              <TypeBadge
                name={data.typeName}
                english={data.typeEnglish}
                href={`/types/${data.typeName}`}
              />
            </dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd>{humanize(data.move.damage_class?.name ?? '')}</dd>
          </div>
          <div>
            <dt>Power</dt>
            <dd>{missing(data.move.power)}</dd>
          </div>
          <div>
            <dt>Accuracy</dt>
            <dd>{missing(data.move.accuracy)}</dd>
          </div>
          <div>
            <dt>PP</dt>
            <dd>{missing(data.move.pp)}</dd>
          </div>
        </dl>
      </div>

      <Section id="effect" title="Effect">
        <p>{data.effect}</p>
      </Section>

      <Section id="learned-by" title="Learned by">
        <p class="count">{data.learners.length} Pokémon</p>
        <ul class="card-grid">
          {data.learners.map((s) => (
            <PokemonCard id={s.id} name={s.name} />
          ))}
        </ul>
      </Section>
    </Layout>
  )
}
