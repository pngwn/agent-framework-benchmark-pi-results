---
import TypeBadge from './TypeBadge.astro';
import { media } from '../lib/api.js';
import { dexNumber, humanize } from '../lib/util.js';

interface Props {
  id: number;
  name: string;
  types?: { name: string; english: string }[];
  hidden?: boolean;
}

const { id, name, types = [], hidden = false } = Astro.props;
---

<li class="poke-card">
  <a href={`/pokemon/${name}`}>
    <img src={media(`sprites/pokemon/${id}.png`)} alt="" width="96" height="96" loading="lazy" />
    <span class="dex">{dexNumber(id)}</span>
    <span class="poke-name">{humanize(name)}</span>
    {
      types.length > 0 && (
        <span class="badges">
          {types.map((t) => (
            <TypeBadge name={t.name} english={t.english} />
          ))}
        </span>
      )
    }
    {hidden && <span class="hidden-note">Hidden ability</span>}
  </a>
</li>
