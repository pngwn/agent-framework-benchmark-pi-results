---
interface Props {
  name: string;
  english: string;
  href?: string;
}

const { name, english, href } = Astro.props;
---

{
  href ? (
    <a class:list={['badge', `type-${name}`]} href={href}>
      {english}
    </a>
  ) : (
    <span class:list={['badge', `type-${name}`]}>{english}</span>
  )
}
