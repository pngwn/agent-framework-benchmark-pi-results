---
import EvoNode from './EvoNode.astro';
import { humanize } from '../lib/util.js';

interface Props {
  node: { name: string; children: { name: string; children: unknown[] }[] };
}

const { node } = Astro.props;
---

<li>
  <a href={`/pokemon/${node.name}`}>{humanize(node.name)}</a>
  {
    node.children.length > 0 && (
      <ul>
        {node.children.map((child) => (
          <EvoNode node={child} />
        ))}
      </ul>
    )
  }
</li>
