---
interface Props {
  name: string; // type API name (used for the color class)
  label: string; // displayed text (English name)
  href?: string;
}

const { name, label, href } = Astro.props;
const cls = `type-badge type-${name}`;
---

{href ? <a class={cls} href={href}>{label}</a> : <span class={cls}>{label}</span>}
