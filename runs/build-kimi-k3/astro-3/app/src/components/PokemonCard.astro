---
import { humanize, dexNumber } from '../lib/format.js';
import { spriteFor } from '../lib/api.js';

interface Props {
  id: number; // species (== default Pokémon) id
  name: string; // species API name
  types?: { name: string; label: string }[];
  hidden?: boolean;
}

const { id, name, types, hidden } = Astro.props;
---

<li class="card">
  <a class="card-link" href={`/pokemon/${name}`}>
    <img class="card-sprite" src={spriteFor(id)} alt="" width="96" height="96" loading="lazy" />
    <span class="card-dex">{dexNumber(id)}</span>
    <span class="card-name">{humanize(name)}</span>
    {
      types && types.length > 0 && (
        <span class="card-types">
          {types.map((t) => (
            <span class={`type-badge type-${t.name}`}>{t.label}</span>
          ))}
        </span>
      )
    }
    {hidden && <span class="card-hidden">Hidden ability</span>}
  </a>
</li>
