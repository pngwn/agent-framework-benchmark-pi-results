---
import Layout from '../../components/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { fetchJson } from '../../lib/api.js';
import { EXCLUDED_TYPES, getTypeNameMap, pokemonRefsToSpecies } from '../../lib/data.js';
import { humanize, englishName } from '../../lib/format.js';

const { name } = Astro.params;

const RELATIONS: [string, string][] = [
  ['Super effective against', 'double_damage_to'],
  ['Not very effective against', 'half_damage_to'],
  ['No effect against', 'no_damage_to'],
  ['Weak to', 'double_damage_from'],
  ['Resists', 'half_damage_from'],
  ['Immune to', 'no_damage_from'],
];

let data: any = null;
if (EXCLUDED_TYPES.has(name!)) {
  Astro.response.status = 404;
} else {
  try {
    const type = await fetchJson(`/type/${name}/`);
    const typeNames = await getTypeNameMap();
    const pokemon = await pokemonRefsToSpecies((type.pokemon ?? []).map((p: any) => p.pokemon));
    const moves = (type.moves ?? [])
      .map((m: any) => m.name as string)
      .sort((a: string, b: string) => humanize(a).localeCompare(humanize(b)));

    data = {
      enName: englishName(type.names) ?? humanize(type.name),
      relations: RELATIONS.map(([label, key]) => ({
        label,
        types: (type.damage_relations?.[key] ?? []).map((t: any) => t.name as string),
      })),
      pokemon,
      moves,
      typeNames,
    };
  } catch (err: any) {
    if (err?.status === 404) {
      Astro.response.status = 404;
    } else {
      throw err;
    }
  }
}
---

<Layout title={data ? `${data.enName} – Pokédex` : 'Not found – Pokédex'}>
  {
    data ? (
      <>
        <h1>{data.enName}</h1>

        <section class="panel" aria-labelledby="relations-heading">
          <h2 id="relations-heading">Damage relations</h2>
          <dl class="relations">
            {data.relations.map((r: any) => (
              <>
                <dt>{r.label}</dt>
                <dd>
                  {r.types.length > 0 ? (
                    <span class="relation-types">
                      {r.types.map((t: string) => (
                        <TypeBadge
                          name={t}
                          label={data.typeNames.get(t) ?? humanize(t)}
                          href={`/types/${t}`}
                        />
                      ))}
                    </span>
                  ) : (
                    'None'
                  )}
                </dd>
              </>
            ))}
          </dl>
        </section>

        <section class="panel" aria-labelledby="pokemon-heading">
          <h2 id="pokemon-heading">Pokémon</h2>
          <p class="result-count">{data.pokemon.length} Pokémon</p>
          <ul class="card-grid">
            {data.pokemon.map((p: any) => (
              <PokemonCard id={p.id} name={p.name} />
            ))}
          </ul>
        </section>

        <section class="panel" aria-labelledby="moves-heading">
          <h2 id="moves-heading">Moves</h2>
          <p class="result-count">{data.moves.length} moves</p>
          <ul class="move-list">
            {data.moves.map((m: string) => (
              <li>
                <a href={`/moves/${m}`}>{humanize(m)}</a>
              </li>
            ))}
          </ul>
        </section>
      </>
    ) : (
      <NotFound />
    )
  }
</Layout>
