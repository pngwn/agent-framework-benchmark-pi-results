---
import Layout from '../../components/Layout.astro';
import { getTypeRecords, getTypeNameMap } from '../../lib/data.js';

const [typeRecords, typeNames] = await Promise.all([getTypeRecords(), getTypeNameMap()]);
---

<Layout title="Types – Pokédex">
  <h1>Types</h1>
  <ul class="type-list">
    {
      typeRecords.map((t) => (
        <li>
          <a class={`type-${t.name}`} href={`/types/${t.name}`}>
            {typeNames.get(t.name)}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
