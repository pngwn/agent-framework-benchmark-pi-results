---
import Layout from '../../components/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { fetchJson } from '../../lib/api.js';
import { getTypeNameMap, pokemonRefsToSpecies } from '../../lib/data.js';
import {
  humanize,
  englishName,
  latestEnglishFlavor,
  orDash,
} from '../../lib/format.js';

const { name } = Astro.params;

let data: any = null;
try {
  const move = await fetchJson(`/move/${name}/`);
  const typeNames = await getTypeNameMap();

  const enEffects = (move.effect_entries ?? []).filter((e: any) => e.language?.name === 'en');
  const shortEffect = enEffects.length ? enEffects[enEffects.length - 1].short_effect : null;
  const effect = shortEffect ?? latestEnglishFlavor(move.flavor_text_entries) ?? '—';

  const learners = await pokemonRefsToSpecies(move.learned_by_pokemon ?? []);

  data = {
    enName: englishName(move.names) ?? humanize(move.name),
    type: move.type?.name ?? null,
    category: move.damage_class?.name ?? null,
    power: move.power,
    accuracy: move.accuracy,
    pp: move.pp,
    effect,
    learners,
    typeNames,
  };
} catch (err: any) {
  if (err?.status === 404) {
    Astro.response.status = 404;
  } else {
    throw err;
  }
}
---

<Layout title={data ? `${data.enName} – Pokédex` : 'Not found – Pokédex'}>
  {
    data ? (
      <>
        <h1>{data.enName}</h1>
        <div class="panel facts-panel">
          <dl class="facts facts-strip">
            <dt>Type</dt>
            <dd>
              {data.type ? (
                <TypeBadge
                  name={data.type}
                  label={data.typeNames.get(data.type) ?? humanize(data.type)}
                  href={`/types/${data.type}`}
                />
              ) : (
                '—'
              )}
            </dd>
            <dt>Category</dt>
            <dd>{data.category ? humanize(data.category) : '—'}</dd>
            <dt>Power</dt>
            <dd>{orDash(data.power)}</dd>
            <dt>Accuracy</dt>
            <dd>{orDash(data.accuracy)}</dd>
            <dt>PP</dt>
            <dd>{orDash(data.pp)}</dd>
          </dl>
        </div>

        <section class="panel" aria-labelledby="effect-heading">
          <h2 id="effect-heading">Effect</h2>
          <p>{data.effect}</p>
        </section>

        <section class="panel" aria-labelledby="learned-heading">
          <h2 id="learned-heading">Learned by</h2>
          <p class="result-count">{data.learners.length} Pokémon</p>
          <ul class="card-grid">
            {data.learners.map((l: any) => (
              <PokemonCard id={l.id} name={l.name} />
            ))}
          </ul>
        </section>
      </>
    ) : (
      <NotFound />
    )
  }
</Layout>
