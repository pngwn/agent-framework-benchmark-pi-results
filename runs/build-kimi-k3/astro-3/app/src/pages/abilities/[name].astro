---
import Layout from '../../components/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { fetchJson, mapAll } from '../../lib/api.js';
import { MAX_MAIN_ID } from '../../lib/data.js';
import { humanize, englishName, idFromUrl } from '../../lib/format.js';

const { name } = Astro.params;

let data: any = null;
try {
  const ability = await fetchJson(`/ability/${name}/`);

  const enEffects = (ability.effect_entries ?? []).filter((e: any) => e.language?.name === 'en');
  const effect = enEffects.length ? enEffects[enEffects.length - 1].short_effect : '—';

  const mains = (ability.pokemon ?? [])
    .map((e: any) => ({ entry: e, id: idFromUrl(e.pokemon.url) }))
    .filter((x: any) => x.id !== null && x.id <= MAX_MAIN_ID);
  const records = await mapAll(mains, (x: any) => fetchJson(`/pokemon/${x.id}/`));
  const bySpecies = new Map<number, any>();
  mains.forEach((x: any, i: number) => {
    const p = records[i];
    const sid = idFromUrl(p.species.url);
    if (sid === null || bySpecies.has(sid)) return;
    bySpecies.set(sid, { id: sid, name: p.species.name, hidden: x.entry.is_hidden });
  });
  const list = [...bySpecies.values()].sort((a, b) => a.id - b.id);

  data = {
    enName: englishName(ability.names) ?? humanize(ability.name),
    effect,
    list,
  };
} catch (err: any) {
  if (err?.status === 404) {
    Astro.response.status = 404;
  } else {
    throw err;
  }
}
---

<Layout title={data ? `${data.enName} – Pokédex` : 'Not found – Pokédex'}>
  {
    data ? (
      <>
        <h1>{data.enName}</h1>

        <section class="panel" aria-labelledby="effect-heading">
          <h2 id="effect-heading">Effect</h2>
          <p>{data.effect}</p>
        </section>

        <section class="panel" aria-labelledby="pokemon-heading">
          <h2 id="pokemon-heading">Pokémon</h2>
          <p class="result-count">{data.list.length} Pokémon</p>
          <ul class="card-grid">
            {data.list.map((l: any) => (
              <PokemonCard id={l.id} name={l.name} hidden={l.hidden} />
            ))}
          </ul>
        </section>
      </>
    ) : (
      <NotFound />
    )
  }
</Layout>
