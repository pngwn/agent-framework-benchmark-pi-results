---
import Layout from '../components/Layout.astro';
import PokemonCard from '../components/PokemonCard.astro';
import {
  getSpeciesList,
  getTypeRecords,
  getTypeNameMap,
  getPokemonTypesMap,
  getGenerationRecords,
} from '../lib/data.js';
import { humanize, englishName } from '../lib/format.js';

const PAGE_SIZE = 48;

const url = Astro.url;
const q = (url.searchParams.get('q') ?? '').trim();
const typeFilter = url.searchParams.get('type') ?? '';
const genFilter = url.searchParams.get('generation') ?? '';
let pageParam = parseInt(url.searchParams.get('page') ?? '1', 10);
if (!Number.isFinite(pageParam) || pageParam < 1) pageParam = 1;

const [species, typeRecords, typeNames, typesByPokemon, generations] = await Promise.all([
  getSpeciesList(),
  getTypeRecords(),
  getTypeNameMap(),
  getPokemonTypesMap(),
  getGenerationRecords(),
]);

const genMembership = new Map(
  generations.map((g) => [g.name, new Set((g.pokemon_species ?? []).map((s) => s.name))]),
);

const qLower = q.toLowerCase();
const filtered = species.filter((s) => {
  if (qLower && !humanize(s.name).toLowerCase().includes(qLower)) return false;
  if (typeFilter) {
    const types = typesByPokemon.get(s.id) ?? [];
    if (!types.some((t) => t.type === typeFilter)) return false;
  }
  if (genFilter) {
    const members = genMembership.get(genFilter);
    if (!members || !members.has(s.name)) return false;
  }
  return true;
});

const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const page = Math.min(pageParam, totalPages);
const pageItems = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

const pageUrl = (n: number) => {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (typeFilter) params.set('type', typeFilter);
  if (genFilter) params.set('generation', genFilter);
  if (n > 1) params.set('page', String(n));
  const qs = params.toString();
  return qs ? `/?${qs}` : '/';
};

const cardTypes = (id: number) =>
  (typesByPokemon.get(id) ?? []).map((t) => ({
    name: t.type,
    label: typeNames.get(t.type) ?? humanize(t.type),
  }));
---

<Layout title="Pokédex">
  <h1>Pokémon</h1>
  <form id="filters" class="filters" action="/" method="get">
    <div class="field">
      <label for="search">Search</label>
      <input type="search" id="search" name="q" value={q} />
    </div>
    <div class="field">
      <label for="type-filter">Type</label>
      <select id="type-filter" name="type">
        <option value="">All types</option>
        {
          typeRecords.map((t) => (
            <option value={t.name} selected={typeFilter === t.name}>
              {typeNames.get(t.name)}
            </option>
          ))
        }
      </select>
    </div>
    <div class="field">
      <label for="generation-filter">Generation</label>
      <select id="generation-filter" name="generation">
        <option value="">All generations</option>
        {
          generations.map((g) => (
            <option value={g.name} selected={genFilter === g.name}>
              {englishName(g.names)}
            </option>
          ))
        }
      </select>
    </div>
  </form>
  <div id="results">
    <p class="result-count">{filtered.length} Pokémon</p>
    {
      pageItems.length > 0 ? (
        <ul class="card-grid">
          {pageItems.map((s) => (
            <PokemonCard id={s.id} name={s.name} types={cardTypes(s.id)} />
          ))}
        </ul>
      ) : (
        <p class="no-results">No Pokémon found</p>
      )
    }
    {
      pageItems.length > 0 && (
        <div class="pagination">
          {page > 1 && (
            <a class="prev" href={pageUrl(page - 1)}>
              Previous page
            </a>
          )}
          <span class="page-status">
            Page {page} of {totalPages}
          </span>
          {page < totalPages && (
            <a class="next" href={pageUrl(page + 1)}>
              Next page
            </a>
          )}
        </div>
      )
    }
  </div>
  <script is:inline src="/js/home.js"></script>
</Layout>
