---
import Layout from '../layouts/Layout.astro';
import CardGrid from '../components/CardGrid.astro';
import { API_BASE } from '../lib/api';
import { getGenerations, getHomeData, getTypes } from '../lib/data';

const PER_PAGE = 48;

const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim();
const type = params.get('type') ?? '';
const generation = params.get('generation') ?? '';
const requestedPage = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);

const [all, types, generations] = await Promise.all([getHomeData(), getTypes(), getGenerations()]);

const filtered = all.filter(
  (entry) =>
    (!q || entry.human.toLowerCase().includes(q.toLowerCase())) &&
    (!type || entry.types?.some((t) => t.name === type)) &&
    (!generation || entry.generation === generation),
);

const totalPages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
const page = Math.min(requestedPage, totalPages);
const pageCards = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE);

const pageHref = (p: number): string => {
  const sp = new URLSearchParams();
  if (q) sp.set('q', q);
  if (type) sp.set('type', type);
  if (generation) sp.set('generation', generation);
  if (p > 1) sp.set('page', String(p));
  const query = sp.toString();
  return query ? `/?${query}` : '/';
};
---

<Layout title="Pokédex">
  <h1>Pokémon</h1>

  <div class="controls" id="filters">
    <div class="field">
      <label for="search">Search</label>
      <input type="search" id="search" name="q" value={q} autocomplete="off" />
    </div>
    <div class="field">
      <label for="type">Type</label>
      <select id="type" name="type">
        <option value="">All types</option>
        {types.map((t) => <option value={t.name} selected={t.name === type}>{t.english}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="generation">Generation</label>
      <select id="generation" name="generation">
        <option value="">All generations</option>
        {generations.map((g) => <option value={g.name} selected={g.name === generation}>{g.english}</option>)}
      </select>
    </div>
  </div>

  <p class="count" id="count">{filtered.length} Pokémon</p>

  <div id="results">
    {pageCards.length > 0 ? <CardGrid cards={pageCards} showTypes /> : <p>No Pokémon found</p>}
  </div>

  <div class="pagination" id="pagination">
    <span>Page {page} of {totalPages}</span>
    {page > 1 && <a href={pageHref(page - 1)}>Previous page</a>}
    {page < totalPages && <a href={pageHref(page + 1)}>Next page</a>}
  </div>

  <script
    type="application/json"
    id="species-data"
    data-media-base={API_BASE}
    set:html={JSON.stringify(all)}
  />
  <script>
    const dataEl = document.getElementById('species-data')!;
    const all = JSON.parse(dataEl.textContent!);
    const mediaBase = dataEl.dataset.mediaBase!;

    const searchInput = document.getElementById('search') as HTMLInputElement;
    const typeSelect = document.getElementById('type') as HTMLSelectElement;
    const generationSelect = document.getElementById('generation') as HTMLSelectElement;
    const countEl = document.getElementById('count')!;
    const resultsEl = document.getElementById('results')!;
    const paginationEl = document.getElementById('pagination')!;

    const PER_PAGE = 48;

    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    function hrefFor(state: { q: string; type: string; generation: string; page: number }): string {
      const sp = new URLSearchParams();
      if (state.q) sp.set('q', state.q);
      if (state.type) sp.set('type', state.type);
      if (state.generation) sp.set('generation', state.generation);
      if (state.page > 1) sp.set('page', String(state.page));
      const query = sp.toString();
      return query ? `/?${query}` : '/';
    }

    function cardHtml(card: any): string {
      const badges = (card.types ?? [])
        .map((t: any) => `<span class="badge type-${t.name}">${escapeHtml(t.english)}</span>`)
        .join('');
      return (
        `<li class="card"><a href="/pokemon/${encodeURIComponent(card.name)}">` +
        `<img src="${mediaBase}/media/sprites/pokemon/${card.id}.png" alt="" width="96" height="96" loading="lazy">` +
        `<span class="dex">#${String(card.id).padStart(4, '0')}</span>` +
        `<span class="card-name">${escapeHtml(card.human)}</span>` +
        (badges ? `<span class="badges">${badges}</span>` : '') +
        `</a></li>`
      );
    }

    function render() {
      const params = new URL(location.href).searchParams;
      const q = (params.get('q') ?? '').trim();
      const type = params.get('type') ?? '';
      const generation = params.get('generation') ?? '';
      const requestedPage = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);

      searchInput.value = q;
      typeSelect.value = type;
      generationSelect.value = generation;

      const filtered = all.filter(
        (entry: any) =>
          (!q || entry.human.toLowerCase().includes(q.toLowerCase())) &&
          (!type || (entry.types ?? []).some((t: any) => t.name === type)) &&
          (!generation || entry.generation === generation),
      );

      const totalPages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
      const page = Math.min(requestedPage, totalPages);
      const pageCards = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE);
      const state = { q, type, generation, page };

      countEl.textContent = `${filtered.length} Pokémon`;
      resultsEl.innerHTML = pageCards.length
        ? `<ul class="card-grid">${pageCards.map(cardHtml).join('')}</ul>`
        : '<p>No Pokémon found</p>';

      let pagination = `<span>Page ${page} of ${totalPages}</span>`;
      if (page > 1) pagination += `<a href="${hrefFor({ ...state, page: page - 1 })}">Previous page</a>`;
      if (page < totalPages) pagination += `<a href="${hrefFor({ ...state, page: page + 1 })}">Next page</a>`;
      paginationEl.innerHTML = pagination;
    }

    let debounce: ReturnType<typeof setTimeout> | undefined;
    searchInput.addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(applyFilters, 200);
    });
    typeSelect.addEventListener('change', applyFilters);
    generationSelect.addEventListener('change', applyFilters);

    function applyFilters() {
      // Changing a filter updates the URL and goes back to page 1.
      history.pushState(null, '', hrefFor({
        q: searchInput.value.trim(),
        type: typeSelect.value,
        generation: generationSelect.value,
        page: 1,
      }));
      render();
    }

    window.addEventListener('popstate', render);
  </script>
</Layout>
