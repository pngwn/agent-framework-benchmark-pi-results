---
import Layout from '../../layouts/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import CardGrid from '../../components/CardGrid.astro';
import { getRecord } from '../../lib/api';
import { getTypeByName, speciesCardsFromPokemonRefs } from '../../lib/data';
import { englishName, humanize } from '../../lib/format';

const { name } = Astro.params;

const type = await getRecord('type', name!);
let view: any = null;

if (type) {
  const typeByName = await getTypeByName();
  const english = englishName(type.names) ?? humanize(type.name);

  const RELATIONS: [string, string][] = [
    ['Super effective against', 'double_damage_to'],
    ['Not very effective against', 'half_damage_to'],
    ['No effect against', 'no_damage_to'],
    ['Weak to', 'double_damage_from'],
    ['Resists', 'half_damage_from'],
    ['Immune to', 'no_damage_from'],
  ];
  const relations = RELATIONS.map(([label, key]) => {
    const related = (type.damage_relations?.[key] ?? []).map((r: any) => {
      const info = typeByName.get(r.name);
      return { name: r.name, english: info?.english ?? humanize(r.name) };
    });
    return { label, related };
  });

  const cards = await speciesCardsFromPokemonRefs((type.pokemon ?? []).map((p: any) => p.pokemon));

  const moves = (type.moves ?? [])
    .map((m: any) => ({ name: m.name, human: humanize(m.name) }))
    .sort((a: any, b: any) => a.human.localeCompare(b.human));

  view = { english, relations, cards, moves };
}

if (!view) Astro.response.status = 404;
---

{
  !view ? (
    <NotFound />
  ) : (
    <Layout title={`${view.english} – Pokédex`}>
      <h1>{view.english}</h1>

      <section class="panel" aria-labelledby="relations-heading">
        <h2 id="relations-heading">Damage relations</h2>
        <dl class="relations">
          {view.relations.map((r: any) => (
            <div>
              <dt>{r.label}</dt>
              <dd class={r.related.length === 0 ? 'empty' : undefined}>
                {r.related.length === 0
                  ? 'None'
                  : r.related.map((t: any) => (
                      <a class={`badge type-${t.name}`} href={`/types/${t.name}`}>
                        {t.english}
                      </a>
                    ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="panel" aria-labelledby="pokemon-heading">
        <h2 id="pokemon-heading">Pokémon</h2>
        <p class="count">{view.cards.length} Pokémon</p>
        <CardGrid cards={view.cards} />
      </section>

      <section class="panel" aria-labelledby="moves-heading">
        <h2 id="moves-heading">Moves</h2>
        <p class="count">{view.moves.length} moves</p>
        <ul class="move-list">
          {view.moves.map((m: any) => (
            <li>
              <a href={`/moves/${m.name}`}>{m.human}</a>
            </li>
          ))}
        </ul>
      </section>
    </Layout>
  )
}
