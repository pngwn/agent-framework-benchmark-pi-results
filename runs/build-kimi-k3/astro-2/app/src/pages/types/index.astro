---
import Layout from '../../layouts/Layout.astro';
import { getTypes } from '../../lib/data';

const types = await getTypes();
---

<Layout title="Types – Pokédex">
  <h1>Types</h1>
  <ul class="type-list">
    {
      types.map((t) => (
        <li>
          <a class={`type-${t.name}`} href={`/types/${t.name}`}>
            {t.english}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
