---
import Layout from '../../layouts/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import CardGrid from '../../components/CardGrid.astro';
import { getRecord, idFromUrl } from '../../lib/api';
import { ALT_FORM_MIN_ID, getSpeciesIndex } from '../../lib/data';
import type { CardData } from '../../lib/data';
import { englishName, humanize } from '../../lib/format';

const { name } = Astro.params;

const ability = await getRecord('ability', name!);
let view: any = null;

if (ability) {
  const english = englishName(ability.names) ?? humanize(ability.name);
  const effectEntries = ability.effect_entries?.filter((e: any) => e.language.name === 'en') ?? [];
  const effect = effectEntries.length
    ? effectEntries[effectEntries.length - 1].short_effect
    : '—';

  const species = await getSpeciesIndex();
  const byId = new Map(species.map((s) => [s.id, s]));
  const grouped = new Map<number, { hidden: boolean }>();
  for (const entry of ability.pokemon ?? []) {
    const id = idFromUrl(entry.pokemon.url);
    if (id >= ALT_FORM_MIN_ID || !byId.has(id)) continue;
    const existing = grouped.get(id);
    // A species has the ability as hidden only if every entry says so.
    grouped.set(id, { hidden: existing ? existing.hidden && entry.is_hidden : entry.is_hidden });
  }
  const cards: CardData[] = [...grouped.entries()]
    .sort((a, b) => a[0] - b[0])
    .map(([id, info]) => ({
      id,
      name: byId.get(id)!.name,
      note: info.hidden ? 'Hidden ability' : undefined,
    }));

  view = { english, effect, cards };
}

if (!view) Astro.response.status = 404;
---

{
  !view ? (
    <NotFound />
  ) : (
    <Layout title={`${view.english} – Pokédex`}>
      <h1>{view.english}</h1>

      <section class="panel" aria-labelledby="effect-heading">
        <h2 id="effect-heading">Effect</h2>
        <p>{view.effect}</p>
      </section>

      <section class="panel" aria-labelledby="pokemon-heading">
        <h2 id="pokemon-heading">Pokémon</h2>
        <p class="count">{view.cards.length} Pokémon</p>
        <CardGrid cards={view.cards} />
      </section>
    </Layout>
  )
}
