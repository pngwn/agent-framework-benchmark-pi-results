---
import Layout from '../../layouts/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import CardGrid from '../../components/CardGrid.astro';
import { getRecord } from '../../lib/api';
import { getTypeByName, speciesCardsFromPokemonRefs } from '../../lib/data';
import { englishName, humanize, latestEnglishFlavor, orDash } from '../../lib/format';

const { name } = Astro.params;

const move = await getRecord('move', name!);
let view: any = null;

if (move) {
  const typeByName = await getTypeByName();
  const english = englishName(move.names) ?? humanize(move.name);
  const typeInfo = move.type?.name ? typeByName.get(move.type.name) : undefined;

  const effectEntries = move.effect_entries?.filter((e: any) => e.language.name === 'en') ?? [];
  const effect =
    (effectEntries.length ? effectEntries[effectEntries.length - 1].short_effect : undefined) ??
    latestEnglishFlavor(move.flavor_text_entries) ??
    '—';

  const cards = await speciesCardsFromPokemonRefs(move.learned_by_pokemon ?? []);

  view = {
    english,
    typeName: move.type?.name,
    typeEnglish: typeInfo?.english ?? (move.type?.name ? humanize(move.type.name) : '—'),
    category: move.damage_class?.name ? humanize(move.damage_class.name) : '—',
    power: orDash(move.power),
    accuracy: orDash(move.accuracy),
    pp: orDash(move.pp),
    effect,
    cards,
  };
}

if (!view) Astro.response.status = 404;
---

{
  !view ? (
    <NotFound />
  ) : (
    <Layout title={`${view.english} – Pokédex`}>
      <h1>{view.english}</h1>

      <div class="panel">
        <dl class="facts-dl">
          <div>
            <dt>Type</dt>
            <dd>
              {view.typeName ? (
                <a class={`badge type-${view.typeName}`} href={`/types/${view.typeName}`}>
                  {view.typeEnglish}
                </a>
              ) : (
                view.typeEnglish
              )}
            </dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd>{view.category}</dd>
          </div>
          <div>
            <dt>Power</dt>
            <dd>{view.power}</dd>
          </div>
          <div>
            <dt>Accuracy</dt>
            <dd>{view.accuracy}</dd>
          </div>
          <div>
            <dt>PP</dt>
            <dd>{view.pp}</dd>
          </div>
        </dl>
      </div>

      <section class="panel" aria-labelledby="effect-heading">
        <h2 id="effect-heading">Effect</h2>
        <p>{view.effect}</p>
      </section>

      <section class="panel" aria-labelledby="learned-by-heading">
        <h2 id="learned-by-heading">Learned by</h2>
        <p class="count">{view.cards.length} Pokémon</p>
        <CardGrid cards={view.cards} />
      </section>
    </Layout>
  )
}
