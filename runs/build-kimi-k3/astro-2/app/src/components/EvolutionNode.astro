---
import { humanize } from '../lib/format';

interface Props {
  node: {
    species: { name: string };
    evolves_to: any[];
  };
}

const { node } = Astro.props;
---

<li>
  <a href={`/pokemon/${node.species.name}`}>{humanize(node.species.name)}</a>
  {
    node.evolves_to.length > 0 && (
      <ul>
        {node.evolves_to.map((child) => (
          <Astro.self node={child} />
        ))}
      </ul>
    )
  }
</li>
