---
import { spriteUrl } from '../lib/api';
import { dexNumber, humanize } from '../lib/format';
import type { CardData } from '../lib/data';

interface Props {
  cards: CardData[];
  showTypes?: boolean;
}

const { cards, showTypes = false } = Astro.props;
---

<ul class="card-grid">
  {
    cards.map((card) => (
      <li class="card">
        <a href={`/pokemon/${card.name}`}>
          <img src={spriteUrl(card.id)} alt="" width="96" height="96" loading="lazy" />
          <span class="dex">{dexNumber(card.id)}</span>
          <span class="card-name">{humanize(card.name)}</span>
          {showTypes && card.types && card.types.length > 0 && (
            <span class="badges">
              {card.types.map((t) => (
                <span class={`badge type-${t.name}`}>{t.english}</span>
              ))}
            </span>
          )}
          {card.note && <span class="card-note">{card.note}</span>}
        </a>
      </li>
    ))
  }
</ul>
