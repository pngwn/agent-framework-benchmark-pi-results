{
  "name": "pokedex-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode ssr --port 3000",
    "build": "npm run build.client && npm run build.server",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/node-server/vite.config.ts",
    "start": "node server/entry.express.js"
  },
  "dependencies": {
    "@builder.io/qwik": "1.20.3",
    "@builder.io/qwik-city": "1.20.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.5"
  }
}
