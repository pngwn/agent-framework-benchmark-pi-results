---
import { humanize, dexNumber } from '../lib/pokeapi.js';

interface Props {
  id: number;
  name: string; // species API name
  sprite: string | null;
  types?: { name: string; label: string }[];
  hidden?: boolean;
}

const { id, name, sprite, types, hidden } = Astro.props;
---

<li class="poke-card">
  <a href={`/pokemon/${name}`}>
    {
      sprite ? (
        <img src={sprite} alt="" width="96" height="96" />
      ) : (
        <span class="no-sprite" aria-hidden="true" />
      )
    }
    <span class="dex">{dexNumber(id)}</span>
    <span class="name">{humanize(name)}</span>
    {
      types && types.length > 0 && (
        <span class="badges">
          {types.map((t) => (
            <span class={`type-badge type-${t.name}`}>{t.label}</span>
          ))}
        </span>
      )
    }
    {hidden && <span class="hidden-note">Hidden ability</span>}
  </a>
</li>
