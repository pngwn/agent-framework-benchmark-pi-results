---
import Layout from '../../components/Layout.astro';
import Section from '../../components/Section.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { apiFetch, enName, getSpeciesIds, idFromRef } from '../../lib/pokeapi.js';

const { name } = Astro.params;

let ability = null;
try {
  ability = await apiFetch(`/ability/${encodeURIComponent(name.toLowerCase())}/`);
} catch (err) {
  if (err.status !== 404) throw err;
}

let data = null;
if (ability) {
  const speciesIds = await getSpeciesIds();
  const entries = ability.pokemon
    .filter((entry) => speciesIds.has(idFromRef(entry.pokemon)))
    .sort((a, b) => idFromRef(a.pokemon) - idFromRef(b.pokemon));
  const records = await Promise.all(entries.map((entry) => apiFetch(`/pokemon/${idFromRef(entry.pokemon)}/`)));
  const bySpecies = new Map();
  records.forEach((pokemon, i) => {
    const speciesId = idFromRef(pokemon.species);
    if (bySpecies.has(speciesId)) return;
    bySpecies.set(speciesId, {
      id: speciesId,
      name: pokemon.species.name,
      sprite: pokemon.sprites?.front_default ?? null,
      hidden: entries[i].is_hidden,
    });
  });
  const cards = [...bySpecies.values()].sort((a, b) => a.id - b.id);
  data = {
    h1: enName(ability),
    effect: ability.effect_entries?.find((e) => e.language?.name === 'en')?.short_effect ?? '—',
    cards,
  };
} else {
  Astro.response.status = 404;
}
---

{
  !data ? (
    <Layout title="Not found – Pokédex">
      <NotFound />
    </Layout>
  ) : (
    <Layout title={`${data.h1} – Pokédex`}>
      <h1>{data.h1}</h1>

      <Section title="Effect">
        <p>{data.effect}</p>
      </Section>

      <Section title="Pokémon">
        <p class="count">{data.cards.length} Pokémon</p>
        <ul class="card-grid">
          {data.cards.map((card) => (
            <PokemonCard {...card} />
          ))}
        </ul>
      </Section>
    </Layout>
  )
}
