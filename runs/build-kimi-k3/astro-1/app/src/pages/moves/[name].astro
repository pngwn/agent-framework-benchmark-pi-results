---
import Layout from '../../components/Layout.astro';
import Section from '../../components/Section.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import {
  apiFetch,
  cardsFromPokemonRefs,
  enName,
  getTypeNameMap,
  humanize,
  latestEnglishFlavor,
} from '../../lib/pokeapi.js';

const { name } = Astro.params;

let move = null;
try {
  move = await apiFetch(`/move/${encodeURIComponent(name.toLowerCase())}/`);
} catch (err) {
  if (err.status !== 404) throw err;
}

let data = null;
if (move) {
  const typeNames = await getTypeNameMap();
  const effect =
    move.effect_entries?.find((e) => e.language?.name === 'en')?.short_effect ??
    latestEnglishFlavor(move.flavor_text_entries) ??
    '—';
  const cards = await cardsFromPokemonRefs(move.learned_by_pokemon ?? []);
  data = {
    h1: enName(move),
    typeName: move.type.name,
    typeLabel: typeNames.get(move.type.name) ?? humanize(move.type.name),
    category: move.damage_class ? humanize(move.damage_class.name) : '—',
    power: move.power ?? '—',
    accuracy: move.accuracy ?? '—',
    pp: move.pp ?? '—',
    effect,
    cards,
  };
} else {
  Astro.response.status = 404;
}
---

{
  !data ? (
    <Layout title="Not found – Pokédex">
      <NotFound />
    </Layout>
  ) : (
    <Layout title={`${data.h1} – Pokédex`}>
      <h1>{data.h1}</h1>
      <div class="panel">
        <dl class="facts facts-grid">
          <div>
            <dt>Type</dt>
            <dd>
              <a class={`type-badge type-${data.typeName}`} href={`/types/${data.typeName}`}>
                {data.typeLabel}
              </a>
            </dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd>{data.category}</dd>
          </div>
          <div>
            <dt>Power</dt>
            <dd>{data.power}</dd>
          </div>
          <div>
            <dt>Accuracy</dt>
            <dd>{data.accuracy}</dd>
          </div>
          <div>
            <dt>PP</dt>
            <dd>{data.pp}</dd>
          </div>
        </dl>
      </div>

      <Section title="Effect">
        <p>{data.effect}</p>
      </Section>

      <Section title="Learned by">
        <p class="count">{data.cards.length} Pokémon</p>
        <ul class="card-grid">
          {data.cards.map((card) => (
            <PokemonCard {...card} />
          ))}
        </ul>
      </Section>
    </Layout>
  )
}
