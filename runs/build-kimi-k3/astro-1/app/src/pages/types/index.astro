---
import Layout from '../../components/Layout.astro';
import { enName, getTypes } from '../../lib/pokeapi.js';

const types = await getTypes();
---

<Layout title="Types – Pokédex">
  <h1>Types</h1>
  <ul class="type-grid">
    {types.map((t) => (
      <li>
        <a class={`type-${t.name}`} href={`/types/${t.name}`}>
          {enName(t)}
        </a>
      </li>
    ))}
  </ul>
</Layout>
