---
import Layout from '../../components/Layout.astro';
import Section from '../../components/Section.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import {
  apiFetch,
  cardsFromPokemonRefs,
  enName,
  getTypeNameMap,
  humanize,
} from '../../lib/pokeapi.js';

const { name } = Astro.params;

let type = null;
try {
  type = await apiFetch(`/type/${encodeURIComponent(name.toLowerCase())}/`);
} catch (err) {
  if (err.status !== 404) throw err;
}

const RELATIONS = [
  ['Super effective against', 'double_damage_to'],
  ['Not very effective against', 'half_damage_to'],
  ['No effect against', 'no_damage_to'],
  ['Weak to', 'double_damage_from'],
  ['Resists', 'half_damage_from'],
  ['Immune to', 'no_damage_from'],
];

let data = null;
if (type) {
  const typeNames = await getTypeNameMap();
  const relations = RELATIONS.map(([label, key]) => ({
    label,
    types: (type.damage_relations?.[key] ?? []).map((ref) => ({
      name: ref.name,
      label: typeNames.get(ref.name) ?? humanize(ref.name),
    })),
  }));
  const cards = await cardsFromPokemonRefs((type.pokemon ?? []).map((p) => p.pokemon));
  const moves = (type.moves ?? [])
    .map((m) => ({ name: m.name, label: humanize(m.name) }))
    .sort((a, b) => a.label.localeCompare(b.label));
  data = { h1: enName(type), relations, cards, moves };
} else {
  Astro.response.status = 404;
}
---

{
  !data ? (
    <Layout title="Not found – Pokédex">
      <NotFound />
    </Layout>
  ) : (
    <Layout title={`${data.h1} – Pokédex`}>
      <h1>{data.h1}</h1>

      <Section title="Damage relations">
        <dl class="relations">
          {data.relations.map((relation) => (
            <div>
              <dt>{relation.label}</dt>
              <dd>
                {relation.types.length === 0
                  ? 'None'
                  : relation.types.map((t) => (
                      <a class={`type-badge type-${t.name}`} href={`/types/${t.name}`}>
                        {t.label}
                      </a>
                    ))}
              </dd>
            </div>
          ))}
        </dl>
      </Section>

      <Section title="Pokémon">
        <p class="count">{data.cards.length} Pokémon</p>
        <ul class="card-grid">
          {data.cards.map((card) => (
            <PokemonCard {...card} />
          ))}
        </ul>
      </Section>

      <Section title="Moves">
        <p class="count">{data.moves.length} moves</p>
        <ul class="move-list">
          {data.moves.map((m) => (
            <li>
              <a href={`/moves/${m.name}`}>{m.label}</a>
            </li>
          ))}
        </ul>
      </Section>
    </Layout>
  )
}
