---
import { spriteUrl } from '../lib/api.js';
import { dexNumber } from '../lib/format.js';

interface Props {
  id: number;
  name: string;
  human: string;
  types?: { name: string; en: string }[];
  note?: string;
}

const { id, name, human, types, note } = Astro.props;
---

<li>
  <a class="card" href={`/pokemon/${name}`}>
    <img src={spriteUrl(id)} alt="" width="96" height="96" loading="lazy" />
    <span class="card-dex">{dexNumber(id)}</span>
    <span class="card-name">{human}</span>
    {
      types && (
        <span class="card-types">
          {types.map((t) => <span class={`type-badge type-${t.name}`}>{t.en}</span>)}
        </span>
      )
    }
    {note && <span class="card-note">{note}</span>}
  </a>
</li>
