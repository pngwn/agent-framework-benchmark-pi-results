---
import Layout from '../layouts/Layout.astro';
import PokemonCard from '../components/PokemonCard.astro';
import {
  getSpeciesList,
  getGenerations,
  getTypes,
  getTypeEnNames,
  getSpeciesTypes,
  getGenerationOfSpecies,
} from '../lib/data.js';
import { humanize, enName } from '../lib/format.js';

const PAGE_SIZE = 48;

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const typeParam = params.get('type') ?? '';
const generationParam = params.get('generation') ?? '';

const [species, generations, typeEn, speciesTypes, generationOf] = await Promise.all([
  getSpeciesList(),
  getGenerations(),
  getTypeEnNames(),
  getSpeciesTypes(),
  getGenerationOfSpecies(),
]);

// Validate filter params against known values.
const type = typeEn.has(typeParam) ? typeParam : '';
const generation = generations.some((g) => g.name === generationParam) ? generationParam : '';

const all = species.map((s) => ({
  ...s,
  human: humanize(s.name),
  types: (speciesTypes.get(s.id) ?? []).map((t) => ({ name: t.type, en: typeEn.get(t.type) ?? humanize(t.type) })),
  generation: generationOf.get(s.id) ?? '',
}));

const qNorm = q.trim().toLowerCase();
const filtered = all.filter(
  (s) =>
    (!qNorm || s.human.toLowerCase().includes(qNorm)) &&
    (!type || s.types.some((t) => t.name === type)) &&
    (!generation || s.generation === generation),
);

const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const requestedPage = parseInt(params.get('page') ?? '1', 10);
const page = Math.min(Math.max(1, Number.isFinite(requestedPage) ? requestedPage : 1), totalPages);
const pageItems = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

function pageHref(p: number) {
  const sp = new URLSearchParams();
  if (q) sp.set('q', q);
  if (type) sp.set('type', type);
  if (generation) sp.set('generation', generation);
  if (p > 1) sp.set('page', String(p));
  const s = sp.toString();
  return s ? `/?${s}` : '/';
}

const typeOptions = (await getTypes()).map((t) => ({ value: t.name, label: enName(t.names, t.name) }));
const generationOptions = generations.map((g) => ({ value: g.name, label: enName(g.names, g.name) }));
---

<Layout title="Pokédex">
  <h1>Pokémon</h1>

  <form class="controls" method="get" action="/" data-controls>
    <div class="field">
      <label for="filter-search">Search</label>
      <input type="search" id="filter-search" name="q" value={q} autocomplete="off" />
    </div>
    <div class="field">
      <label for="filter-type">Type</label>
      <select id="filter-type" name="type">
        <option value="">All types</option>
        {typeOptions.map((t) => <option value={t.value} selected={t.value === type}>{t.label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="filter-generation">Generation</label>
      <select id="filter-generation" name="generation">
        <option value="">All generations</option>
        {generationOptions.map((g) => <option value={g.value} selected={g.value === generation}>{g.label}</option>)}
      </select>
    </div>
  </form>

  <p class="count">{filtered.length} Pokémon</p>

  {
    pageItems.length > 0 ? (
      <ul class="card-grid">
        {pageItems.map((s) => <PokemonCard id={s.id} name={s.name} human={s.human} types={s.types} />)}
      </ul>
    ) : (
      <p>No Pokémon found</p>
    )
  }

  <nav class="pagination" aria-label="Pagination">
    <p>Page {page} of {totalPages}</p>
    {page > 1 && <a href={pageHref(page - 1)}>Previous page</a>}
    {page < totalPages && <a href={pageHref(page + 1)}>Next page</a>}
  </nav>

  <script src="/js/home.js" defer></script>
</Layout>
