---
import Layout from '../../layouts/Layout.astro';
import { getTypes } from '../../lib/data.js';
import { enName } from '../../lib/format.js';

const types = (await getTypes()).map((t) => ({ name: t.name, en: enName(t.names, t.name) }));
---

<Layout title="Types – Pokédex">
  <h1>Types</h1>
  <ul class="type-list">
    {
      types.map((t) => (
        <li>
          <a class={`type-${t.name}`} href={`/types/${t.name}`}>
            {t.en}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
