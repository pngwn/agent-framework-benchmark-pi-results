---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import NotFoundBody from '../../components/NotFoundBody.astro';
import { apiFetch, NotFound } from '../../lib/api.js';
import { getTypes, toSpeciesCards, typeEnName } from '../../lib/data.js';
import { enName, humanize } from '../../lib/format.js';

const { name } = Astro.params;

const RELATIONS = [
  ['Super effective against', 'double_damage_to'],
  ['Not very effective against', 'half_damage_to'],
  ['No effect against', 'no_damage_to'],
  ['Weak to', 'double_damage_from'],
  ['Resists', 'half_damage_from'],
  ['Immune to', 'no_damage_from'],
] as const;

let data: any = null;
try {
  // Only the 18 types are in scope.
  const valid = new Set((await getTypes()).map((t) => t.name));
  if (!valid.has(name!.toLowerCase())) throw new NotFound(`type/${name}`);

  const type = await apiFetch(`type/${encodeURIComponent(name!.toLowerCase())}`);
  const relations = await Promise.all(
    RELATIONS.map(async ([label, key]) => ({
      label,
      types: await Promise.all(
        (type.damage_relations[key] ?? []).map(async (t: any) => ({
          name: t.name,
          en: await typeEnName(t.name),
        })),
      ),
    })),
  );
  const moves = (type.moves ?? [])
    .map((m: any) => ({ name: m.name, human: humanize(m.name) }))
    .sort((a: any, b: any) => a.human.localeCompare(b.human));
  data = {
    en: enName(type.names, type.name),
    relations,
    cards: await toSpeciesCards(type.pokemon ?? []),
    moves,
  };
} catch (err) {
  if (!(err instanceof NotFound)) throw err;
}

if (!data) Astro.response.status = 404;
const title = data ? `${data.en} – Pokédex` : 'Not found – Pokédex';
---

<Layout title={title}>
  {
    !data ? (
      <NotFoundBody />
    ) : (
      <>
        <h1>{data.en}</h1>

        <Section heading="Damage relations" headingId="relations-heading">
          <dl class="relations">
            {data.relations.map((r: any) => (
              <div>
                <dt>{r.label}</dt>
                <dd>
                  {r.types.length > 0 ? (
                    <span class="relation-types">
                      {r.types.map((t: any) => (
                        <a class={`type-badge type-${t.name}`} href={`/types/${t.name}`}>
                          {t.en}
                        </a>
                      ))}
                    </span>
                  ) : (
                    'None'
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </Section>

        <Section heading="Pokémon" headingId="pokemon-heading">
          <p class="count">{data.cards.length} Pokémon</p>
          <ul class="card-grid">
            {data.cards.map((c: any) => <PokemonCard id={c.id} name={c.name} human={c.human} />)}
          </ul>
        </Section>

        <Section heading="Moves" headingId="moves-heading">
          <p class="count">{data.moves.length} moves</p>
          <ul class="move-list">
            {data.moves.map((m: any) => (
              <li>
                <a href={`/moves/${m.name}`}>{m.human}</a>
              </li>
            ))}
          </ul>
        </Section>
      </>
    )
  }
</Layout>
