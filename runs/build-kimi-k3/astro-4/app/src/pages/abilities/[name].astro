---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import NotFoundBody from '../../components/NotFoundBody.astro';
import { apiFetch, NotFound } from '../../lib/api.js';
import { getSpeciesNameById } from '../../lib/data.js';
import { enName, humanize, idFromUrl } from '../../lib/format.js';

const { name } = Astro.params;

let data: any = null;
try {
  const ability = await apiFetch(`ability/${encodeURIComponent(name!.toLowerCase())}`);
  const speciesNameById = await getSpeciesNameById();
  const byId = new Map<number, any>();
  for (const entry of ability.pokemon ?? []) {
    const id = idFromUrl(entry.pokemon.url);
    if (id >= 10000) continue; // alternate forms are out of scope
    const speciesName = speciesNameById.get(id);
    if (!speciesName || byId.has(id)) continue;
    byId.set(id, {
      id,
      name: speciesName,
      human: humanize(speciesName),
      hidden: entry.is_hidden,
    });
  }
  const cards = [...byId.values()].sort((a, b) => a.id - b.id);
  data = {
    en: enName(ability.names, ability.name),
    effect: ability.effect_entries?.find((e: any) => e.language?.name === 'en')?.short_effect ?? '—',
    cards,
  };
} catch (err) {
  if (!(err instanceof NotFound)) throw err;
}

if (!data) Astro.response.status = 404;
const title = data ? `${data.en} – Pokédex` : 'Not found – Pokédex';
---

<Layout title={title}>
  {
    !data ? (
      <NotFoundBody />
    ) : (
      <>
        <h1>{data.en}</h1>

        <Section heading="Effect" headingId="effect-heading">
          <p>{data.effect}</p>
        </Section>

        <Section heading="Pokémon" headingId="pokemon-heading">
          <p class="count">{data.cards.length} Pokémon</p>
          <ul class="card-grid">
            {data.cards.map((c: any) => (
              <PokemonCard id={c.id} name={c.name} human={c.human} note={c.hidden ? 'Hidden ability' : undefined} />
            ))}
          </ul>
        </Section>
      </>
    )
  }
</Layout>
