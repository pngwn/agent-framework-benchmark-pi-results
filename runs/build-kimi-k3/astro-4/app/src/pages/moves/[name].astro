---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import NotFoundBody from '../../components/NotFoundBody.astro';
import { apiFetch, NotFound } from '../../lib/api.js';
import { toSpeciesCards, typeEnName } from '../../lib/data.js';
import { humanize, enName, latestEnFlavor } from '../../lib/format.js';

const { name } = Astro.params;

let data: any = null;
try {
  const move = await apiFetch(`move/${encodeURIComponent(name!.toLowerCase())}`);
  const effect =
    move.effect_entries?.find((e: any) => e.language?.name === 'en')?.short_effect ??
    latestEnFlavor(move.flavor_text_entries) ??
    '—';
  data = {
    en: enName(move.names, move.name),
    typeName: move.type?.name ?? '',
    typeEn: move.type ? await typeEnName(move.type.name) : '—',
    category: move.damage_class ? humanize(move.damage_class.name) : '—',
    power: move.power ?? null,
    accuracy: move.accuracy ?? null,
    pp: move.pp ?? null,
    effect,
    cards: await toSpeciesCards(move.learned_by_pokemon ?? []),
  };
} catch (err) {
  if (!(err instanceof NotFound)) throw err;
}

if (!data) Astro.response.status = 404;
const title = data ? `${data.en} – Pokédex` : 'Not found – Pokédex';
---

<Layout title={title}>
  {
    !data ? (
      <NotFoundBody />
    ) : (
      <>
        <h1>{data.en}</h1>
        <dl class="facts">
          <div>
            <dt>Type</dt>
            <dd>
              <a class={`type-badge type-${data.typeName}`} href={`/types/${data.typeName}`}>
                {data.typeEn}
              </a>
            </dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd>{data.category}</dd>
          </div>
          <div>
            <dt>Power</dt>
            <dd>{data.power ?? '—'}</dd>
          </div>
          <div>
            <dt>Accuracy</dt>
            <dd>{data.accuracy ?? '—'}</dd>
          </div>
          <div>
            <dt>PP</dt>
            <dd>{data.pp ?? '—'}</dd>
          </div>
        </dl>

        <Section heading="Effect" headingId="effect-heading">
          <p>{data.effect}</p>
        </Section>

        <Section heading="Learned by" headingId="learned-by-heading">
          <p class="count">{data.cards.length} Pokémon</p>
          <ul class="card-grid">
            {data.cards.map((c: any) => <PokemonCard id={c.id} name={c.name} human={c.human} />)}
          </ul>
        </Section>
      </>
    )
  }
</Layout>
