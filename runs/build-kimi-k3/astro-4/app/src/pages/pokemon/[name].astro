---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import EvoNode from '../../components/EvoNode.astro';
import NotFoundBody from '../../components/NotFoundBody.astro';
import { apiFetch, NotFound } from '../../lib/api.js';
import { getTypeEnNames, getVersionGroupOrder, typeEnName } from '../../lib/data.js';
import { humanize, enName, dexNumber, latestEnFlavor, idFromUrl } from '../../lib/format.js';

const STAT_LABELS: Record<string, string> = {
  hp: 'HP',
  attack: 'Attack',
  defense: 'Defense',
  'special-attack': 'Sp. Atk',
  'special-defense': 'Sp. Def',
  speed: 'Speed',
};

const METHOD_ORDER = ['level-up', 'machine', 'egg', 'tutor'];

const { name } = Astro.params;

let data: any = null;
try {
  const species = await apiFetch(`pokemon-species/${encodeURIComponent(name!.toLowerCase())}`);
  const variety = species.varieties.find((v: any) => v.is_default) ?? species.varieties[0];
  const [pokemon, chain, vgOrder] = await Promise.all([
    apiFetch(`pokemon/${idFromUrl(variety.pokemon.url)}`),
    apiFetch(`evolution-chain/${idFromUrl(species.evolution_chain.url)}`),
    getVersionGroupOrder(),
    getTypeEnNames(),
  ]);

  // Version groups in which this Pokémon learns moves, ordered by `order`.
  const games = [
    ...new Set(
      pokemon.moves.flatMap((m: any) => m.version_group_details.map((d: any) => d.version_group.name)),
    ),
  ].sort((a, b) => (vgOrder.get(a) ?? Infinity) - (vgOrder.get(b) ?? Infinity)) as string[];
  const gameParam = Astro.url.searchParams.get('game') ?? '';
  const game = games.includes(gameParam) ? gameParam : games[games.length - 1];

  // Learn entries for the selected game.
  const entries: { method: string; level: number; move: string }[] = [];
  for (const m of pokemon.moves) {
    for (const d of m.version_group_details) {
      if (d.version_group.name === game) {
        entries.push({ method: d.move_learn_method.name, level: d.level_learned_at, move: m.move.name });
      }
    }
  }
  const moveRecords = new Map(
    await Promise.all(
      [...new Set(entries.map((e) => e.move))].map(async (n) => [n, await apiFetch(`move/${n}`)] as const),
    ),
  );

  const byMethod = new Map<string, any[]>();
  for (const e of entries) {
    const rec: any = moveRecords.get(e.move);
    const row = {
      level: e.level,
      moveName: e.move,
      moveEn: enName(rec.names, rec.name),
      typeName: rec.type?.name ?? '',
      typeEn: rec.type ? await typeEnName(rec.type.name) : '—',
      category: rec.damage_class ? humanize(rec.damage_class.name) : '—',
      power: rec.power ?? null,
      accuracy: rec.accuracy ?? null,
      pp: rec.pp ?? null,
    };
    if (!byMethod.has(e.method)) byMethod.set(e.method, []);
    byMethod.get(e.method)!.push(row);
  }
  const methods = [...byMethod.keys()]
    .sort((a, b) => {
      const ia = METHOD_ORDER.indexOf(a);
      const ib = METHOD_ORDER.indexOf(b);
      return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || humanize(a).localeCompare(humanize(b));
    })
    .map((m) => {
      const rows = byMethod.get(m)!;
      rows.sort(
        m === 'level-up'
          ? (a, b) => a.level - b.level || a.moveEn.localeCompare(b.moveEn)
          : (a, b) => a.moveEn.localeCompare(b.moveEn),
      );
      return { name: m, human: humanize(m), rows };
    });

  const stats = pokemon.stats.map((s: any) => ({
    label: STAT_LABELS[s.stat.name] ?? humanize(s.stat.name),
    value: s.base_stat,
  }));
  const total = stats.reduce((sum: number, s: any) => sum + s.value, 0);

  data = {
    speciesName: species.name,
    en: enName(species.names, species.name),
    dex: dexNumber(species.id),
    genus: species.genera?.find((g: any) => g.language?.name === 'en')?.genus ?? '',
    flavor: latestEnFlavor(species.flavor_text_entries) ?? '—',
    artwork: pokemon.sprites?.other?.['official-artwork']?.front_default ?? null,
    height: (pokemon.height / 10).toFixed(1),
    weight: (pokemon.weight / 10).toFixed(1),
    types: await Promise.all(
      [...pokemon.types]
        .sort((a: any, b: any) => a.slot - b.slot)
        .map(async (t: any) => ({ name: t.type.name, en: await typeEnName(t.type.name) })),
    ),
    stats,
    total,
    abilities: [...pokemon.abilities]
      .sort((a: any, b: any) => a.slot - b.slot)
      .map((a: any) => ({ name: a.ability.name, human: humanize(a.ability.name), hidden: a.is_hidden })),
    chain: chain.chain,
    games,
    game,
    methods,
  };
} catch (err) {
  if (!(err instanceof NotFound)) throw err;
}

if (!data) Astro.response.status = 404;
const title = data ? `${data.en} – Pokédex` : 'Not found – Pokédex';
---

<Layout title={title}>
  {
    !data ? (
      <NotFoundBody />
    ) : (
      <>
        <div class="summary">
          <div class="artwork-card">
            {data.artwork && <img src={data.artwork} alt={data.en} width="288" height="288" />}
          </div>
          <div>
            <p class="summary-dex">{data.dex}</p>
            <h1>{data.en}</h1>
            <p class="genus">{data.genus}</p>
            <div class="summary-types">
              {data.types.map((t: any) => (
                <a class={`type-badge type-${t.name}`} href={`/types/${t.name}`}>
                  {t.en}
                </a>
              ))}
            </div>
            <dl class="facts">
              <div>
                <dt>Height</dt>
                <dd>{data.height} m</dd>
              </div>
              <div>
                <dt>Weight</dt>
                <dd>{data.weight} kg</dd>
              </div>
            </dl>
            <p class="flavor">{data.flavor}</p>
          </div>
        </div>

        <Section heading="Base stats" headingId="stats-heading">
          <table class="stats-table">
            <tbody>
              {data.stats.map((s: any) => (
                <tr>
                  <th scope="row">{s.label}</th>
                  <td class="stat-num">{s.value}</td>
                  <td>
                    <span class="stat-track">
                      <span class="stat-fill" style={`width:${Math.min(100, (s.value / 255) * 100)}%`} />
                    </span>
                  </td>
                </tr>
              ))}
              <tr>
                <th scope="row">Total</th>
                <td class="stat-num">{data.total}</td>
                <td>
                  <span class="stat-track">
                    <span class="stat-fill" style={`width:${Math.min(100, (data.total / 720) * 100)}%`} />
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </Section>

        <Section heading="Abilities" headingId="abilities-heading">
          <ul class="ability-list">
            {data.abilities.map((a: any) => (
              <li>
                <a href={`/abilities/${a.name}`}>{a.human}</a>
                {a.hidden && ' (hidden)'}
              </li>
            ))}
          </ul>
        </Section>

        <Section heading="Evolution" headingId="evolution-heading">
          <ul class="evo-tree">
            <EvoNode node={data.chain} />
          </ul>
        </Section>

        <Section heading="Moves" headingId="moves-heading" id="moves">
          <div class="game-picker">
            <label for="game-select">Game</label>
            <select id="game-select" data-game-select data-base={`/pokemon/${data.speciesName}`}>
              {data.games.map((g: string) => (
                <option value={g} selected={g === data.game}>
                  {humanize(g)}
                </option>
              ))}
            </select>
          </div>
          {data.methods.map((method: any) => (
            <div class="table-scroll">
              <table class="moves-table" data-sortable>
                <caption>{method.human}</caption>
                <thead>
                  <tr>
                    {method.name === 'level-up' && (
                      <th scope="col" data-sort-type="number">
                        <button type="button">Level</button>
                      </th>
                    )}
                    <th scope="col" data-sort-type="text">
                      <button type="button">Move</button>
                    </th>
                    <th scope="col" data-sort-type="text">
                      <button type="button">Type</button>
                    </th>
                    <th scope="col" data-sort-type="text">
                      <button type="button">Category</button>
                    </th>
                    <th scope="col" data-sort-type="number">
                      <button type="button">Power</button>
                    </th>
                    <th scope="col" data-sort-type="number">
                      <button type="button">Accuracy</button>
                    </th>
                    <th scope="col" data-sort-type="number">
                      <button type="button">PP</button>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {method.rows.map((r: any) => (
                    <tr>
                      {method.name === 'level-up' && <td data-v={r.level}>{r.level}</td>}
                      <td data-v={r.moveEn}>
                        <a href={`/moves/${r.moveName}`}>{r.moveEn}</a>
                      </td>
                      <td data-v={r.typeEn}>
                        <a class={`type-badge type-${r.typeName}`} href={`/types/${r.typeName}`}>
                          {r.typeEn}
                        </a>
                      </td>
                      <td data-v={r.category}>{r.category}</td>
                      <td data-v={r.power ?? ''}>{r.power ?? '—'}</td>
                      <td data-v={r.accuracy ?? ''}>{r.accuracy ?? '—'}</td>
                      <td data-v={r.pp ?? ''}>{r.pp ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </Section>
        <script src="/js/pokemon.js" defer></script>
      </>
    )
  }
</Layout>
