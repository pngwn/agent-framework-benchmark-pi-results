---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { NotFoundError, englishName, humanize, idFromUrl } from '../../lib/pokeapi';
import { getSpeciesIndex, getTypeDetail, getTypes } from '../../lib/data';

const name = Astro.params.name;
let notFound = false;
let type: any = null;

try {
  type = await getTypeDetail(name);
} catch (error) {
  if (error instanceof NotFoundError) {
    notFound = true;
    Astro.response.status = 404;
  } else {
    throw error;
  }
}

let displayName = '';
let relations: any[] = [];
let pokemonOfType: any[] = [];
let movesOfType: any[] = [];

if (!notFound) {
  displayName = englishName(type, type.name);
  const types = await getTypes();
  const typeLabels = new Map(types.map((entry) => [entry.name, entry.english]));

  const relationSpecs = [
    ['Super effective against', type.damage_relations?.double_damage_to],
    ['Not very effective against', type.damage_relations?.half_damage_to],
    ['No effect against', type.damage_relations?.no_damage_to],
    ['Weak to', type.damage_relations?.double_damage_from],
    ['Resists', type.damage_relations?.half_damage_from],
    ['Immune to', type.damage_relations?.no_damage_from],
  ];
  relations = relationSpecs.map(([label, entries]) => {
    const related = [...(entries || [])].map((entry) => ({
      name: entry.name,
      label: typeLabels.get(entry.name) || humanize(entry.name),
    }));
    return { label, related };
  });

  const ids = [
    ...new Set(
      (type.pokemon || [])
        .map((entry: any) => idFromUrl(entry.pokemon?.url || ''))
        .filter((id: number) => id > 0 && id <= 10000),
    ),
  ].sort((a, b) => a - b);
  const speciesIndex = await getSpeciesIndex();
  pokemonOfType = ids.map((id) => speciesIndex.get(id)).filter(Boolean);

  movesOfType = [...(type.moves || [])]
    .map((entry: any) => ({ name: entry.name, label: humanize(entry.name) }))
    .sort((a, b) => a.label.localeCompare(b.label, undefined, { sensitivity: 'base' }));
}
---
{notFound ? (
  <NotFound />
) : (
  <BaseLayout title={`${displayName} – Pokédex`}>
    <h1>{displayName}</h1>

    <section class="section" aria-labelledby="damage-relations-heading">
      <h2 id="damage-relations-heading">Damage relations</h2>
      <dl class="damage-relations">
        {relations.map((relation) => (
          <div class="relation">
            <dt>{relation.label}</dt>
            <dd>
              {relation.related.length > 0
                ? relation.related.map((related: any) => (
                    <a class="type-badge" data-type={related.name} href={`/types/${related.name}`}>{related.label}</a>
                  ))
                : 'None'}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="section" aria-labelledby="pokemon-heading">
      <h2 id="pokemon-heading">Pokémon</h2>
      <p class="result-count">{pokemonOfType.length} Pokémon</p>
      <ul class="card-grid">
        {pokemonOfType.map((species) => <PokemonCard species={species} />)}
      </ul>
    </section>

    <section class="section" aria-labelledby="moves-heading">
      <h2 id="moves-heading">Moves</h2>
      <p class="result-count">{movesOfType.length} moves</p>
      <ul class="move-links">
        {movesOfType.map((move) => (
          <li><a href={`/moves/${move.name}`}>{move.label}</a></li>
        ))}
      </ul>
    </section>
  </BaseLayout>
)}
