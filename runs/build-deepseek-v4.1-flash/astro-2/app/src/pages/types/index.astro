---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTypes } from '../../lib/data';

const types = await getTypes();
---
<BaseLayout title="Types – Pokédex">
  <h1 class="types-index-title">Types</h1>
  <ul class="type-links">
    {types.map((type) => (
      <li>
        <a class="type-link" data-type={type.name} href={`/types/${type.name}`}>{type.english}</a>
      </li>
    ))}
  </ul>
</BaseLayout>
