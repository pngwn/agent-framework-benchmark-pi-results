---
import BaseLayout from '../layouts/BaseLayout.astro';
import PokemonCard from '../components/PokemonCard.astro';
import { getHomeIndex } from '../lib/data';

const { species, generations, types } = await getHomeIndex();

const searchParams = Astro.url.searchParams;
const q = (searchParams.get('q') || '').trim();
const typeParam = searchParams.get('type') || '';
const generationParam = searchParams.get('generation') || '';

const selectedType = types.find((type) => type.name === typeParam)?.name || '';
const selectedGeneration = generations.find((generation) => generation.name === generationParam)?.name || '';

const query = q.toLowerCase();
let filtered = species;
if (query) {
  filtered = filtered.filter((entry) => entry.humanized.toLowerCase().includes(query));
}
if (selectedType) {
  filtered = filtered.filter((entry) => entry.types.some((type) => type.name === selectedType));
}
if (selectedGeneration) {
  filtered = filtered.filter((entry) => entry.generation === selectedGeneration);
}

const PAGE_SIZE = 48;
const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const rawPage = Number.parseInt(searchParams.get('page') || '1', 10);
const page = Math.min(Math.max(Number.isFinite(rawPage) ? rawPage : 1, 1), totalPages);
const pageEntries = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

function pageHref(targetPage: number): string {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (selectedType) params.set('type', selectedType);
  if (selectedGeneration) params.set('generation', selectedGeneration);
  if (targetPage > 1) params.set('page', String(targetPage));
  const queryString = params.toString();
  return queryString ? `/?${queryString}` : '/';
}
---
<BaseLayout title="Pokédex">
  <h1 class="home-title">Pokémon</h1>

  <form class="filters" id="filters" method="get" action="/">
    <div class="field search-field">
      <label for="search">Search</label>
      <input id="search" name="q" type="search" value={q} autocomplete="off" />
    </div>
    <div class="field">
      <label for="type-filter">Type</label>
      <select id="type-filter" name="type">
        <option value="" selected={!selectedType}>All types</option>
        {types.map((type) => (
          <option value={type.name} selected={selectedType === type.name}>{type.english}</option>
        ))}
      </select>
    </div>
    <div class="field">
      <label for="generation-filter">Generation</label>
      <select id="generation-filter" name="generation">
        <option value="" selected={!selectedGeneration}>All generations</option>
        {generations.map((generation) => (
          <option value={generation.name} selected={selectedGeneration === generation.name}>{generation.english}</option>
        ))}
      </select>
    </div>
  </form>

  <div id="results">
    <p class="result-count">{filtered.length} Pokémon</p>
    {filtered.length === 0 ? (
      <p class="empty-message">No Pokémon found</p>
    ) : (
      <ul class="card-grid">
        {pageEntries.map((entry) => (
          <PokemonCard species={entry} types={entry.types} />
        ))}
      </ul>
    )}
    <nav class="pagination" aria-label="Pagination">
      <span>Page {page} of {totalPages}</span>
      {page > 1 && <a href={pageHref(page - 1)}>Previous page</a>}
      {page < totalPages && <a href={pageHref(page + 1)}>Next page</a>}
    </nav>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('filters') as HTMLFormElement | null;
  const results = document.getElementById('results');

  if (form && results) {
    let timer: number | undefined;
    let requestId = 0;

    const navigate = async () => {
      const data = new FormData(form);
      const params = new URLSearchParams();
      const search = String(data.get('q') || '').trim();
      const type = String(data.get('type') || '');
      const generation = String(data.get('generation') || '');
      if (search) params.set('q', search);
      if (type) params.set('type', type);
      if (generation) params.set('generation', generation);
      const queryString = params.toString();
      const url = `${window.location.pathname}${queryString ? `?${queryString}` : ''}`;
      const thisRequest = ++requestId;
      try {
        const response = await fetch(url, { headers: { accept: 'text/html' } });
        if (!response.ok) return;
        const html = await response.text();
        if (thisRequest !== requestId) return;
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const nextResults = doc.getElementById('results');
        if (!nextResults) return;
        results.innerHTML = nextResults.innerHTML;
        window.history.pushState({}, '', url);
      } catch {
        // Leave the current results in place if the request fails.
      }
    };

    const searchInput = form.querySelector<HTMLInputElement>('input[name="q"]');
    searchInput?.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(navigate, 300);
    });

    for (const select of form.querySelectorAll<HTMLSelectElement>('select')) {
      select.addEventListener('change', () => {
        window.clearTimeout(timer);
        void navigate();
      });
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      window.clearTimeout(timer);
      void navigate();
    });
  }
</script>
