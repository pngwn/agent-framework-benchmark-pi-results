---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import {
  NotFoundError,
  englishName,
  englishShortEffect,
  formatMissing,
  getJson,
  humanize,
  idFromUrl,
  latestEnglishFlavorText,
} from '../../lib/pokeapi';
import { getSpeciesIndex, getTypeDetail } from '../../lib/data';

const name = Astro.params.name;
let notFound = false;
let move: any = null;

try {
  move = await getJson(`move/${encodeURIComponent(name)}`);
} catch (error) {
  if (error instanceof NotFoundError) {
    notFound = true;
    Astro.response.status = 404;
  } else {
    throw error;
  }
}

let displayName = '';
let typeName = '';
let typeLabel = '';
let category = '';
let effect = '';
let learnedBy: any[] = [];

if (!notFound) {
  displayName = englishName(move, move.name);
  typeName = move.type?.name || '';
  typeLabel = typeName ? englishName(await getTypeDetail(typeName), typeName) : '';
  category = move.damage_class?.name ? humanize(move.damage_class.name) : '—';
  effect =
    englishShortEffect(move.effect_entries) ||
    latestEnglishFlavorText(move.flavor_text_entries) ||
    '—';

  const ids = [
    ...new Set(
      (move.learned_by_pokemon || [])
        .map((entry: any) => idFromUrl(entry.url))
        .filter((id: number) => id > 0 && id <= 10000),
    ),
  ].sort((a, b) => a - b);
  const speciesIndex = await getSpeciesIndex();
  learnedBy = ids.map((id) => speciesIndex.get(id)).filter(Boolean);
}
---
{notFound ? (
  <NotFound />
) : (
  <BaseLayout title={`${displayName} – Pokédex`}>
    <h1 class="move-title">{displayName}</h1>

    <div class="panel">
      <dl class="detail-list">
        <div class="detail-item">
          <dt>Type</dt>
          <dd>
            {typeName ? (
              <a class="type-badge" data-type={typeName} href={`/types/${typeName}`}>{typeLabel}</a>
            ) : '—'}
          </dd>
        </div>
        <div class="detail-item">
          <dt>Category</dt>
          <dd>{category}</dd>
        </div>
        <div class="detail-item">
          <dt>Power</dt>
          <dd>{formatMissing(move.power)}</dd>
        </div>
        <div class="detail-item">
          <dt>Accuracy</dt>
          <dd>{formatMissing(move.accuracy)}</dd>
        </div>
        <div class="detail-item">
          <dt>PP</dt>
          <dd>{formatMissing(move.pp)}</dd>
        </div>
      </dl>
    </div>

    <section class="section" aria-labelledby="effect-heading">
      <h2 id="effect-heading">Effect</h2>
      <p class="detail-section-text">{effect}</p>
    </section>

    <section class="section" aria-labelledby="learned-by-heading">
      <h2 id="learned-by-heading">Learned by</h2>
      <p class="result-count">{learnedBy.length} Pokémon</p>
      <ul class="card-grid">
        {learnedBy.map((species) => <PokemonCard species={species} />)}
      </ul>
    </section>
  </BaseLayout>
)}
