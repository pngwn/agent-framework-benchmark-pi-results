---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import {
  NotFoundError,
  englishName,
  englishShortEffect,
  getJson,
  idFromUrl,
} from '../../lib/pokeapi';
import { getSpeciesIndex } from '../../lib/data';

const name = Astro.params.name;
let notFound = false;
let ability: any = null;

try {
  ability = await getJson(`ability/${encodeURIComponent(name)}`);
} catch (error) {
  if (error instanceof NotFoundError) {
    notFound = true;
    Astro.response.status = 404;
  } else {
    throw error;
  }
}

let displayName = '';
let effect = '';
let pokemonWithAbility: any[] = [];

if (!notFound) {
  displayName = englishName(ability, ability.name);
  effect = englishShortEffect(ability.effect_entries) || '—';

  const bySpecies = new Map<number, boolean>();
  for (const entry of ability.pokemon || []) {
    const id = idFromUrl(entry.pokemon?.url || '');
    if (!id || id > 10000) continue;
    bySpecies.set(id, Boolean(bySpecies.get(id)) || Boolean(entry.is_hidden));
  }

  const speciesIndex = await getSpeciesIndex();
  pokemonWithAbility = [...bySpecies.entries()]
    .sort((a, b) => a[0] - b[0])
    .map(([id, hidden]) => {
      const species = speciesIndex.get(id);
      return species ? { species, hidden } : null;
    })
    .filter(Boolean);
}
---
{notFound ? (
  <NotFound />
) : (
  <BaseLayout title={`${displayName} – Pokédex`}>
    <h1>{displayName}</h1>

    <section class="section" aria-labelledby="effect-heading">
      <h2 id="effect-heading">Effect</h2>
      <p class="detail-section-text">{effect}</p>
    </section>

    <section class="section" aria-labelledby="pokemon-heading">
      <h2 id="pokemon-heading">Pokémon</h2>
      <p class="result-count">{pokemonWithAbility.length} Pokémon</p>
      <ul class="card-grid">
        {pokemonWithAbility.map((entry) => (
          <PokemonCard species={entry.species} hidden={entry.hidden} />
        ))}
      </ul>
    </section>
  </BaseLayout>
)}
