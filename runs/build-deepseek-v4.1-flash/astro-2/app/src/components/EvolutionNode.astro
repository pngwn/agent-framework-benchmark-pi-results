---
import EvolutionNode from './EvolutionNode.astro';
import { humanize } from '../lib/pokeapi';

const { node } = Astro.props;
const label = humanize(node.species.name);
const children = node.evolves_to || [];
---
<li>
  <a href={`/pokemon/${node.species.name}`}>{label}</a>
  {children.length > 0 && (
    <ul>
      {children.map((child) => <EvolutionNode node={child} />)}
    </ul>
  )}
</li>
