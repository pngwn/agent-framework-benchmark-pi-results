---
import { humanize, spriteUrl, dexNumber } from '../lib/pokeapi';
import TypeBadge from './TypeBadge.astro';

const { species, types = [], hidden = false } = Astro.props;
const label = species.humanized || humanize(species.name);
---
<li class="pokemon-card">
  <a href={`/pokemon/${species.name}`}>
    <img class="card-sprite" src={spriteUrl(species.id)} alt="" width="96" height="96" />
    <span class="card-dex">{dexNumber(species.id)}</span>
    <span class="card-name">{label}</span>
    {types.length > 0 && (
      <span class="card-types">
        {types.map((type) => <TypeBadge name={type.name} label={type.english} />)}
      </span>
    )}
    {hidden && <span class="card-note">Hidden ability</span>}
  </a>
</li>
