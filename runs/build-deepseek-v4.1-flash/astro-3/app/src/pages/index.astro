---
import Base from '../layouts/Base.astro';
import PokemonCard from '../components/PokemonCard.astro';
import { getPokemonListModel } from '../lib/api.js';

const url = Astro.url;
const q = (url.searchParams.get('q') || '').trim();
const selectedType = url.searchParams.get('type') || '';
const selectedGeneration = url.searchParams.get('generation') || '';
const requestedPage = Number.parseInt(url.searchParams.get('page') || '1', 10);

const { species, types, generations } = await getPokemonListModel();
const normalizedQuery = q.toLowerCase();

const filtered = species.filter((entry) => {
  if (normalizedQuery && !entry.displayName.toLowerCase().includes(normalizedQuery)) return false;
  if (selectedType && !entry.types.some((type) => type.name === selectedType)) return false;
  if (selectedGeneration && entry.generation !== selectedGeneration) return false;
  return true;
});

const pageSize = 48;
const count = filtered.length;
const totalPages = count > 0 ? Math.ceil(count / pageSize) : 0;
const page = totalPages > 0
  ? Math.min(Math.max(Number.isFinite(requestedPage) ? requestedPage : 1, 1), totalPages)
  : 1;
const pageItems = filtered.slice((page - 1) * pageSize, page * pageSize);

function urlForPage(pageNumber) {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (selectedType) params.set('type', selectedType);
  if (selectedGeneration) params.set('generation', selectedGeneration);
  if (pageNumber > 1) params.set('page', String(pageNumber));
  const search = params.toString();
  return search ? `/?${search}` : '/';
}
---

<Base title="Pokédex">
  <h1>Pokémon</h1>

  <div class="filters">
    <div class="field search-field">
      <label for="pokemon-search">Search</label>
      <input id="pokemon-search" type="search" name="q" value={q} autocomplete="off" />
    </div>
    <div class="field">
      <label for="type-select">Type</label>
      <select id="type-select" name="type">
        <option value="">All types</option>
        {types.map((type) => (
          <option value={type.name} selected={type.name === selectedType}>{type.label}</option>
        ))}
      </select>
    </div>
    <div class="field">
      <label for="generation">Generation</label>
      <select id="generation" name="generation">
        <option value="">All generations</option>
        {generations.map((generation) => (
          <option value={generation.name} selected={generation.name === selectedGeneration}>
            {generation.label}
          </option>
        ))}
      </select>
    </div>
  </div>

  <p class="count">{count} Pokémon</p>

  {count > 0 ? (
    <>
      <ul class="pokemon-grid">
        {pageItems.map((pokemon) => (
          <PokemonCard
            id={pokemon.id}
            name={pokemon.name}
            label={pokemon.displayName}
            types={pokemon.types}
          />
        ))}
      </ul>

      <div class="pagination">
        <span>Page {page} of {totalPages}</span>
        {page > 1 && <a href={urlForPage(page - 1)}>Previous page</a>}
        {page < totalPages && <a href={urlForPage(page + 1)}>Next page</a>}
      </div>
    </>
  ) : (
    <p class="empty">No Pokémon found</p>
  )}
</Base>

<style>
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .field {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-1);
  }

  .field label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .field input,
  .field select {
    width: 100%;
    height: 2.5rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  .field input:focus,
  .field select:focus {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }

  .empty {
    padding: var(--space-6) 0;
    color: var(--color-text-muted);
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  @media (max-width: 760px) {
    .filters {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const search = document.getElementById('pokemon-search');
  const type = document.getElementById('type-select');
  const generation = document.getElementById('generation');
  let timer;

  function navigate() {
    const target = new URL(window.location.href);
    const query = document.getElementById('pokemon-search')?.value.trim() || '';
    const typeValue = document.getElementById('type-select')?.value || '';
    const generationValue = document.getElementById('generation')?.value || '';

    if (query) target.searchParams.set('q', query);
    else target.searchParams.delete('q');
    if (typeValue) target.searchParams.set('type', typeValue);
    else target.searchParams.delete('type');
    if (generationValue) target.searchParams.set('generation', generationValue);
    else target.searchParams.delete('generation');
    target.searchParams.delete('page');

    const next = `${target.pathname}${target.search}${target.hash}`;
    const current = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (next !== current) window.location.assign(next);
  }

  search?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(navigate, 250);
  });

  type?.addEventListener('change', navigate);
  generation?.addEventListener('change', navigate);
</script>
