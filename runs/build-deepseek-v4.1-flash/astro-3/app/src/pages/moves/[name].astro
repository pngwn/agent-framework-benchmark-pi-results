---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { getMove, getSpeciesNameMap } from '../../lib/api.js';
import {
  DAMAGE_CLASS_LABELS,
  displayValue,
  englishName,
  humanize,
  idFromUrl,
  latestEnglishFlavorText,
} from '../../lib/format.js';

export const prerender = false;

const { name } = Astro.params;
const move = await getMove(name);
const notFound = !move;

let heading = 'Not found';
let typeName = '';
let typeLabel = '';
let category = '';
let power = '—';
let accuracy = '—';
let pp = '—';
let effect = '—';
let learnedBy = [];

if (move) {
  heading = englishName(move, move.name);
  typeName = move.type?.name || '';
  typeLabel = humanize(typeName);
  category = DAMAGE_CLASS_LABELS[move.damage_class?.name] || humanize(move.damage_class?.name || '');
  power = displayValue(move.power);
  accuracy = displayValue(move.accuracy);
  pp = displayValue(move.pp);

  const englishEffect = move.effect_entries?.find((entry) => entry.language?.name === 'en')?.short_effect;
  effect = englishEffect || latestEnglishFlavorText(move.flavor_text_entries) || '—';

  const speciesMap = await getSpeciesNameMap();
  const seen = new Set();
  learnedBy = (move.learned_by_pokemon || [])
    .map((entry) => ({ id: idFromUrl(entry.url), fallbackName: entry.name }))
    .filter((entry) => entry.id !== null && entry.id <= 10000)
    .filter((entry) => {
      if (seen.has(entry.id)) return false;
      seen.add(entry.id);
      return true;
    })
    .sort((a, b) => a.id - b.id)
    .map((entry) => {
      const species = speciesMap.get(entry.id);
      return {
        id: entry.id,
        name: species?.name || entry.fallbackName,
        label: humanize(species?.name || entry.fallbackName),
      };
    });
}

if (notFound) Astro.response.status = 404;
const title = notFound ? 'Not found – Pokédex' : `${heading} – Pokédex`;
---

<Base title={title}>
  {notFound ? (
    <NotFound />
  ) : (
    <>
      <h1>{heading}</h1>

      <dl class="move-details">
        <div>
          <dt>Type</dt>
          <dd>
            {typeName ? (
              <a class="type-badge" style={`--badge-color: var(--type-${typeName})`} href={`/types/${typeName}`}>
                {typeLabel}
              </a>
            ) : '—'}
          </dd>
        </div>
        <div>
          <dt>Category</dt>
          <dd>{category || '—'}</dd>
        </div>
        <div>
          <dt>Power</dt>
          <dd>{power}</dd>
        </div>
        <div>
          <dt>Accuracy</dt>
          <dd>{accuracy}</dd>
        </div>
        <div>
          <dt>PP</dt>
          <dd>{pp}</dd>
        </div>
      </dl>

      <section class="panel" aria-labelledby="effect-heading">
        <h2 id="effect-heading">Effect</h2>
        <p>{effect}</p>
      </section>

      <section class="panel" aria-labelledby="learned-by-heading">
        <h2 id="learned-by-heading">Learned by</h2>
        <p class="count">{learnedBy.length} Pokémon</p>
        <ul class="pokemon-grid">
          {learnedBy.map((pokemon) => (
            <PokemonCard id={pokemon.id} name={pokemon.name} label={pokemon.label} />
          ))}
        </ul>
      </section>
    </>
  )}
</Base>

<style>
  .move-details {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
    max-width: 36rem;
    margin-bottom: var(--space-5);
  }

  .move-details dt {
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
  }

  .move-details dd {
    font-size: var(--text-base);
  }

  @media (max-width: 640px) {
    .move-details {
      gap: var(--space-2);
    }

    .move-details dd {
      font-size: var(--text-sm);
    }
  }
</style>
