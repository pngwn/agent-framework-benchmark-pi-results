---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { getAbility, getSpeciesNameMap } from '../../lib/api.js';
import { englishName, humanize, idFromUrl } from '../../lib/format.js';

export const prerender = false;

const { name } = Astro.params;
const ability = await getAbility(name);
const notFound = !ability;

let heading = 'Not found';
let effect = '—';
let pokemonWithAbility = [];

if (ability) {
  heading = englishName(ability, ability.name);
  effect =
    ability.effect_entries?.find((entry) => entry.language?.name === 'en')?.short_effect ||
    '—';

  const speciesMap = await getSpeciesNameMap();
  const seen = new Set();
  pokemonWithAbility = (ability.pokemon || [])
    .map((entry) => ({
      id: idFromUrl(entry.pokemon?.url),
      fallbackName: entry.pokemon?.name,
      hidden: Boolean(entry.is_hidden),
    }))
    .filter((entry) => entry.id !== null && entry.id <= 10000)
    .filter((entry) => {
      if (seen.has(entry.id)) return false;
      seen.add(entry.id);
      return true;
    })
    .sort((a, b) => a.id - b.id)
    .map((entry) => {
      const species = speciesMap.get(entry.id);
      return {
        id: entry.id,
        name: species?.name || entry.fallbackName,
        label: humanize(species?.name || entry.fallbackName),
        hidden: entry.hidden,
      };
    });
}

if (notFound) Astro.response.status = 404;
const title = notFound ? 'Not found – Pokédex' : `${heading} – Pokédex`;
---

<Base title={title}>
  {notFound ? (
    <NotFound />
  ) : (
    <>
      <h1>{heading}</h1>

      <section class="panel" aria-labelledby="effect-heading">
        <h2 id="effect-heading">Effect</h2>
        <p>{effect}</p>
      </section>

      <section class="panel" aria-labelledby="ability-pokemon-heading">
        <h2 id="ability-pokemon-heading">Pokémon</h2>
        <p class="count">{pokemonWithAbility.length} Pokémon</p>
        <ul class="pokemon-grid">
          {pokemonWithAbility.map((pokemon) => (
            <PokemonCard
              id={pokemon.id}
              name={pokemon.name}
              label={pokemon.label}
              hidden={pokemon.hidden}
            />
          ))}
        </ul>
      </section>
    </>
  )}
</Base>
