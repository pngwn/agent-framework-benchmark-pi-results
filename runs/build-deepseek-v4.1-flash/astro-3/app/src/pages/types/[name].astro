---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { getSpeciesNameMap, getType } from '../../lib/api.js';
import { englishName, humanize, idFromUrl } from '../../lib/format.js';

export const prerender = false;

const { name } = Astro.params;
const type = await getType(name);
const notFound = !type;

let heading = 'Not found';
let relations = [];
let pokemonOfType = [];
let movesOfType = [];

if (type) {
  heading = englishName(type, type.name);
  const damage = type.damage_relations || {};
  const relationTerms = [
    ['Super effective against', 'double_damage_to'],
    ['Not very effective against', 'half_damage_to'],
    ['No effect against', 'no_damage_to'],
    ['Weak to', 'double_damage_from'],
    ['Resists', 'half_damage_from'],
    ['Immune to', 'no_damage_from'],
  ];
  relations = relationTerms.map(([term, key]) => ({
    term,
    types: (damage[key] || []).map((related) => ({
      name: related.name,
      label: humanize(related.name),
    })),
  }));

  const speciesMap = await getSpeciesNameMap();
  const seen = new Set();
  pokemonOfType = (type.pokemon || [])
    .map((entry) => ({ id: idFromUrl(entry.pokemon?.url), fallbackName: entry.pokemon?.name }))
    .filter((entry) => entry.id !== null && entry.id <= 10000)
    .filter((entry) => {
      if (seen.has(entry.id)) return false;
      seen.add(entry.id);
      return true;
    })
    .sort((a, b) => a.id - b.id)
    .map((entry) => {
      const species = speciesMap.get(entry.id);
      return {
        id: entry.id,
        name: species?.name || entry.fallbackName,
        label: humanize(species?.name || entry.fallbackName),
      };
    });

  movesOfType = (type.moves || [])
    .map((move) => ({ name: move.name, label: humanize(move.name) }))
    .sort((a, b) => a.label.localeCompare(b.label, undefined, { sensitivity: 'base' }));
}

if (notFound) Astro.response.status = 404;
const title = notFound ? 'Not found – Pokédex' : `${heading} – Pokédex`;
---

<Base title={title}>
  {notFound ? (
    <NotFound />
  ) : (
    <>
      <h1>{heading}</h1>

      <section class="panel" aria-labelledby="damage-relations-heading">
        <h2 id="damage-relations-heading">Damage relations</h2>
        <dl class="relations">
          {relations.map((relation) => (
            <div class="relation">
              <dt>{relation.term}</dt>
              <dd>
                {relation.types.length > 0 ? (
                  <span class="relation-types">
                    {relation.types.map((related) => (
                      <a
                        class="type-badge"
                        style={`--badge-color: var(--type-${related.name})`}
                        href={`/types/${related.name}`}
                      >{related.label}</a>
                    ))}
                  </span>
                ) : 'None'}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="panel" aria-labelledby="type-pokemon-heading">
        <h2 id="type-pokemon-heading">Pokémon</h2>
        <p class="count">{pokemonOfType.length} Pokémon</p>
        <ul class="pokemon-grid">
          {pokemonOfType.map((pokemon) => (
            <PokemonCard id={pokemon.id} name={pokemon.name} label={pokemon.label} />
          ))}
        </ul>
      </section>

      <section class="panel" aria-labelledby="type-moves-heading">
        <h2 id="type-moves-heading">Moves</h2>
        <p class="count">{movesOfType.length} moves</p>
        <ul class="move-list">
          {movesOfType.map((move) => (
            <li><a href={`/moves/${move.name}`}>{move.label}</a></li>
          ))}
        </ul>
      </section>
    </>
  )}
</Base>

<style>
  .relations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-6);
  }

  .relation dt {
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
  }

  .relation-types {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .move-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .relations {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
