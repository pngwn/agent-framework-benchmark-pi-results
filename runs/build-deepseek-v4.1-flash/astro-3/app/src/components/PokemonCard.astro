---
import { absoluteApiUrl } from '../lib/api.js';
import { dexNumber } from '../lib/format.js';

const { id, name, label, types = null, hidden = false } = Astro.props;
const sprite = absoluteApiUrl(`/media/sprites/pokemon/${id}.png`);
---

<li class="pokemon-card">
  <a class="pokemon-card-link" href={`/pokemon/${name}`}>
    <img class="pokemon-sprite" src={sprite} alt={`${label} sprite`} width="96" height="96" loading="lazy" />
    <span class="pokemon-number">{dexNumber(id)}</span>
    <span class="pokemon-name">{label}</span>
    {types && types.length > 0 && (
      <span class="pokemon-types">
        {types.map((type) => (
          <span class="type-badge" style={`--badge-color: var(--type-${type.name})`}>{type.label}</span>
        ))}
      </span>
    )}
  </a>
  {hidden && <span class="hidden-ability">Hidden ability</span>}
</li>
