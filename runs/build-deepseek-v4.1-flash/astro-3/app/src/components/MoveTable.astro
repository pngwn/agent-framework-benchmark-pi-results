---
import { displayValue } from '../lib/format.js';

const { table } = Astro.props;
const isLevelUp = table.method === 'level-up';

const columns = [
  ...(isLevelUp ? [{ label: 'Level', type: 'number' }] : []),
  { label: 'Move', type: 'text' },
  { label: 'Type', type: 'text' },
  { label: 'Category', type: 'text' },
  { label: 'Power', type: 'number' },
  { label: 'Accuracy', type: 'number' },
  { label: 'PP', type: 'number' },
];
---

<div class="table-wrap">
  <table class="move-table" data-sortable>
    <caption>{table.label}</caption>
    <thead>
      <tr>
        {columns.map((column) => (
          <th scope="col" data-type={column.type} aria-sort="none">
            <button type="button">{column.label}</button>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {table.rows.map((row) => (
        <tr>
          {isLevelUp && (
            <td data-sort={row.level ?? ''} data-missing={row.level == null ? 'true' : undefined}>
              {displayValue(row.level)}
            </td>
          )}
          <td data-sort={row.moveLabel}>
            <a href={`/moves/${row.moveName}`}>{row.moveLabel}</a>
          </td>
          <td data-sort={row.typeLabel}>
            <a
              class="type-badge"
              style={`--badge-color: var(--type-${row.typeName})`}
              href={`/types/${row.typeName}`}
            >{row.typeLabel}</a>
          </td>
          <td data-sort={row.categoryLabel}>{row.categoryLabel}</td>
          <td data-sort={row.power ?? ''} data-missing={row.power == null ? 'true' : undefined}>
            {displayValue(row.power)}
          </td>
          <td data-sort={row.accuracy ?? ''} data-missing={row.accuracy == null ? 'true' : undefined}>
            {displayValue(row.accuracy)}
          </td>
          <td data-sort={row.pp ?? ''} data-missing={row.pp == null ? 'true' : undefined}>
            {displayValue(row.pp)}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
