---
import EvolutionList from '../../components/EvolutionList.astro';
import Layout from '../../components/Layout.astro';
import MovesTable from '../../components/MovesTable.astro';
import NotFound from '../../components/NotFound.astro';
import { getPokemonPage, mediaUrl, NotFoundError } from '../../lib/pokeapi';

let data = null;
let notFound = false;
try {
  data = await getPokemonPage(Astro.params.name ?? '', Astro.url.searchParams.get('game'));
} catch (error) {
  if (error instanceof NotFoundError) notFound = true;
  else throw error;
}
if (notFound || !data) {
  Astro.response.status = 404;
}

const title = data?.englishName ?? 'Not found';
---

{data ? (
  <Layout title={title}>
    <article class="pokemon-hero">
      <div class="hero-artwork-wrap">
        {data.artwork && (
          <img class="hero-artwork" src={mediaUrl(data.artwork)} alt={data.englishName} />
        )}
      </div>
      <div class="hero-info">
        <div class="dex-number">#{String(data.id).padStart(4, '0')}</div>
        <h1 class="hero-title">{data.englishName}</h1>
        <p class="genus">{data.genus}</p>
        <div class="hero-types">
          {data.types.map((type) => (
            <a class={`type-badge type-${type.name}`} href={`/types/${type.name}`}>{type.label}</a>
          ))}
        </div>
        <dl class="measures">
          <div class="measure">
            <dt>Height</dt>
            <dd>{(Number(data.pokemon.height) / 10).toFixed(1)} m</dd>
          </div>
          <div class="measure">
            <dt>Weight</dt>
            <dd>{(Number(data.pokemon.weight) / 10).toFixed(1)} kg</dd>
          </div>
        </dl>
        <p class="flavor-text">{data.flavorText}</p>
      </div>
    </article>

    <section class="panel" aria-labelledby="stats-heading">
      <h2 id="stats-heading">Base stats</h2>
      <table class="stats-table">
        <tbody>
          {data.stats.map((stat) => (
            <tr>
              <th scope="row" class="stat-row-header">{stat.label}</th>
              <td class="stat-value">{stat.value}</td>
              <td class="stat-bar-cell">
                <span class="stat-track">
                  <span
                    class="stat-fill"
                    style={`width: ${Math.max(3, Math.min(100, (stat.value / 255) * 100))}%`}
                  ></span>
                </span>
              </td>
            </tr>
          ))}
          <tr>
            <th scope="row" class="stat-row-header">Total</th>
            <td class="stat-value">{data.statTotal}</td>
            <td class="stat-bar-cell">
              <span class="stat-track">
                <span
                  class="stat-fill"
                  style={`width: ${Math.max(3, Math.min(100, (data.statTotal / 1530) * 100))}%`}
                ></span>
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="panel" aria-labelledby="abilities-heading">
      <h2 id="abilities-heading">Abilities</h2>
      <ul class="simple-list">
        {data.abilities.map((ability) => (
          <li>
            <a href={`/abilities/${ability.name}`}>{ability.label}</a>
            {ability.hidden && <span class="hidden-tag"> (hidden)</span>}
          </li>
        ))}
      </ul>
    </section>

    <section class="panel" aria-labelledby="evolution-heading">
      <h2 id="evolution-heading">Evolution</h2>
      <ul class="evolution-list">
        <EvolutionList node={data.evolutionChain} />
      </ul>
    </section>

    <section class="panel" id="moves" aria-labelledby="moves-heading">
      <h2 id="moves-heading">Moves</h2>
      {data.versionGroups.length > 0 && (
        <div class="game-field">
          <label for="game-select">Game</label>
          <select id="game-select">
            {data.versionGroups.map((group) => (
              <option value={group.name} selected={group.name === data.selectedGame}>
                {group.label}
              </option>
            ))}
          </select>
        </div>
      )}
      {data.moveTables.map((table) => <MovesTable table={table} />)}
    </section>
  </Layout>
) : (
  <NotFound />
)}

<script is:inline>
  (() => {
    function cellText(row, index) {
      const cell = row.cells[index];
      return cell ? cell.textContent.trim() : '';
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest('button.sort-button');
      if (!button) return;
      const table = button.closest('table');
      const header = button.closest('th');
      if (!table || !header || !table.tBodies.length) return;

      const headers = Array.from(header.parentElement.children);
      const index = headers.indexOf(header);
      const label = button.textContent.trim();
      const numeric = ['Level', 'Power', 'Accuracy', 'PP'].includes(label);
      const direction = header.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
      const body = table.tBodies[0];
      const rows = Array.from(table.tBodies[0].rows);
      const missing = (value) => value === '' || value === '—';

      rows.sort((a, b) => {
        const aText = cellText(a, index);
        const bText = cellText(b, index);
        const aMissing = missing(aText);
        const bMissing = missing(bText);
        if (aMissing && bMissing) return 0;
        if (aMissing) return 1;
        if (bMissing) return -1;
        let cmp = 0;
        if (numeric) {
          const aNumber = Number(aText);
          const bNumber = Number(bText);
          cmp = Number.isFinite(aNumber) && Number.isFinite(bNumber)
            ? aNumber - bNumber
            : aText.localeCompare(bText);
        } else {
          cmp = aText.localeCompare(bText);
        }
        return direction === 'ascending' ? cmp : -cmp;
      });

      for (const row of rows) body.appendChild(row);
      for (const other of headers) other.removeAttribute('aria-sort');
      header.setAttribute('aria-sort', direction);
    });

    document.addEventListener('change', async (event) => {
      const target = event.target;
      if (!(target instanceof Element) || target.id !== 'game-select') return;
      const url = new URL(window.location.href);
      url.searchParams.set('game', target.value);
      history.pushState(null, '', `${url.pathname}${url.search}${url.hash}`);
      try {
        const response = await fetch(`${url.pathname}${url.search}`, {
          headers: { 'X-Requested-With': 'fetch' },
        });
        if (!response.ok) throw new Error('Request failed');
        const html = await response.text();
        const documentCopy = new DOMParser().parseFromString(html, 'text/html');
        const next = documentCopy.getElementById('moves');
        const current = document.getElementById('moves');
        if (!next || !current) throw new Error('Missing moves section');
        current.replaceWith(next);
      } catch {
        window.location.href = url.toString();
      }
    });

    window.addEventListener('popstate', () => window.location.reload());
  })();
</script>
