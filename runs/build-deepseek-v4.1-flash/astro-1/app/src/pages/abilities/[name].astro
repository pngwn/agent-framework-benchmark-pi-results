---
import Layout from '../../components/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { getAbilityPage, NotFoundError } from '../../lib/pokeapi';

let data = null;
let notFound = false;
try {
  data = await getAbilityPage(Astro.params.name ?? '');
} catch (error) {
  if (error instanceof NotFoundError) notFound = true;
  else throw error;
}
if (notFound || !data) {
  Astro.response.status = 404;
}
const title = data?.englishName ?? 'Not found';
---

{data ? (
  <Layout title={title}>
    <h1 class="page-heading">{data.englishName}</h1>

    <section class="panel" aria-labelledby="effect-heading">
      <h2 id="effect-heading">Effect</h2>
      <p>{data.effect}</p>
    </section>

    <section class="panel" aria-labelledby="pokemon-heading">
      <h2 id="pokemon-heading">Pokémon</h2>
      <p class="count-label">{data.pokemon.length} Pokémon</p>
      <ul class="card-grid">
        {data.pokemon.map((species) => (
          <PokemonCard
            id={species.id}
            name={species.name}
            displayName={species.displayName}
            hidden={species.hidden}
          />
        ))}
      </ul>
    </section>
  </Layout>
) : (
  <NotFound />
)}
