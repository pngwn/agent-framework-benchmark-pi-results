---
import Layout from '../../components/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { displayNumber, getMovePage, NotFoundError } from '../../lib/pokeapi';

let data = null;
let notFound = false;
try {
  data = await getMovePage(Astro.params.name ?? '');
} catch (error) {
  if (error instanceof NotFoundError) notFound = true;
  else throw error;
}
if (notFound || !data) {
  Astro.response.status = 404;
}
const title = data?.englishName ?? 'Not found';
---

{data ? (
  <Layout title={title}>
    <h1 class="page-heading move-heading">{data.englishName}</h1>

    <div class="panel facts-panel">
      <dl class="fact-list">
      <div class="fact">
        <dt>Type</dt>
        <dd><a class={`type-badge type-${data.typeName}`} href={`/types/${data.typeName}`}>{data.typeLabel}</a></dd>
      </div>
      <div class="fact">
        <dt>Category</dt>
        <dd>{data.category}</dd>
      </div>
      <div class="fact">
        <dt>Power</dt>
        <dd>{displayNumber(data.power)}</dd>
      </div>
      <div class="fact">
        <dt>Accuracy</dt>
        <dd>{displayNumber(data.accuracy)}</dd>
      </div>
        <div class="fact">
          <dt>PP</dt>
          <dd>{displayNumber(data.pp)}</dd>
        </div>
      </dl>
    </div>

    <section class="panel" aria-labelledby="effect-heading">
      <h2 id="effect-heading">Effect</h2>
      <p>{data.effect}</p>
    </section>

    <section class="panel" aria-labelledby="learned-by-heading">
      <h2 id="learned-by-heading">Learned by</h2>
      <p class="count-label">{data.pokemon.length} Pokémon</p>
      <ul class="card-grid">
        {data.pokemon.map((species) => (
          <PokemonCard id={species.id} name={species.name} displayName={species.displayName} />
        ))}
      </ul>
    </section>
  </Layout>
) : (
  <NotFound />
)}
