---
import Layout from '../../components/Layout.astro';
import { getTypes } from '../../lib/pokeapi';

const { list } = await getTypes();
---

<Layout title="Types">
  <h1 class="page-heading">Types</h1>
  <ul class="type-grid">
    {list.map((type) => (
      <li>
        <a class={`type-badge type-${type.name}`} href={`/types/${type.name}`}>{type.label}</a>
      </li>
    ))}
  </ul>
</Layout>
