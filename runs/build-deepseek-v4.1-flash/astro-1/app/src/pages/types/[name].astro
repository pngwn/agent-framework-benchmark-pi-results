---
import Layout from '../../components/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { getTypePage, NotFoundError } from '../../lib/pokeapi';

let data = null;
let notFound = false;
try {
  data = await getTypePage(Astro.params.name ?? '');
} catch (error) {
  if (error instanceof NotFoundError) notFound = true;
  else throw error;
}
if (notFound || !data) {
  Astro.response.status = 404;
}
const title = data?.englishName ?? 'Not found';
---

{data ? (
  <Layout title={title}>
    <h1 class="page-heading">{data.englishName}</h1>

    <section class="panel" aria-labelledby="damage-heading">
      <h2 id="damage-heading">Damage relations</h2>
      <dl class="damage-relations">
        {data.relations.map((relation) => (
          <div class="relation">
            <dt>{relation.term}</dt>
            <dd>
              {relation.types.length > 0
                ? relation.types.map((type) => (
                    <a class={`type-badge type-${type.name}`} href={`/types/${type.name}`}>{type.label}</a>
                  ))
                : 'None'}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="panel" aria-labelledby="pokemon-heading">
      <h2 id="pokemon-heading">Pokémon</h2>
      <p class="count-label">{data.pokemon.length} Pokémon</p>
      <ul class="card-grid">
        {data.pokemon.map((species) => (
          <PokemonCard id={species.id} name={species.name} displayName={species.displayName} />
        ))}
      </ul>
    </section>

    <section class="panel" aria-labelledby="moves-heading">
      <h2 id="moves-heading">Moves</h2>
      <p class="count-label">{data.moves.length} moves</p>
      <ul class="move-links">
        {data.moves.map((move) => (
          <li><a href={`/moves/${move.name}`}>{move.label}</a></li>
        ))}
      </ul>
    </section>
  </Layout>
) : (
  <NotFound />
)}
