---
import { displayNumber } from '../lib/pokeapi';

interface Props {
  table: {
    methodName: string;
    label: string;
    columns: string[];
    rows: {
      level?: number | null;
      moveName: string;
      moveLabel: string;
      typeName: string;
      typeLabel: string;
      category: string;
      power: number | null;
      accuracy: number | null;
      pp: number | null;
    }[];
  };
}

const { table } = Astro.props;
---

<div class="table-scroll">
  <table class="moves-table">
    <caption>{table.label}</caption>
    <thead>
      <tr>
        {table.columns.map((column) => (
          <th scope="col">
            <button type="button" class="sort-button">{column}</button>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {table.rows.map((row) => (
        <tr>
          {table.columns.map((column) => {
            if (column === 'Level') return <td>{displayNumber(row.level)}</td>;
            if (column === 'Move')
              return (
                <td>
                  <a class="move-link" href={`/moves/${row.moveName}`}>{row.moveLabel}</a>
                </td>
              );
            if (column === 'Type')
              return (
                <td>
                  <a class={`type-badge type-${row.typeName}`} href={`/types/${row.typeName}`}>
                    {row.typeLabel}
                  </a>
                </td>
              );
            if (column === 'Category') return <td>{row.category}</td>;
            if (column === 'Power') return <td>{displayNumber(row.power)}</td>;
            if (column === 'Accuracy') return <td>{displayNumber(row.accuracy)}</td>;
            if (column === 'PP') return <td>{displayNumber(row.pp)}</td>;
            return <td></td>;
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
