---
import { humanize, mediaUrl } from '../lib/pokeapi';

interface Props {
  id: number;
  name: string;
  displayName?: string;
  types?: { name: string; label: string }[];
  hidden?: boolean;
}

const { id, name, displayName, types = [], hidden = false } = Astro.props;
const label = displayName ?? humanize(name);
const sprite = mediaUrl(`/media/sprites/pokemon/${id}.png`);
---

<li class="card-item">
  <a class="pokemon-card" href={`/pokemon/${name}`}>
    <img class="card-sprite" src={sprite} alt={label} width="72" height="72" loading="lazy" />
    <span class="card-number">#{String(id).padStart(4, '0')}</span>
    <span class="card-name">{label}</span>
    {types.length > 0 && (
      <span class="card-types">
        {types.map((type) => (
          <span class={`type-badge type-${type.name}`}>{type.label}</span>
        ))}
      </span>
    )}
    {hidden && <span class="card-hidden">Hidden ability</span>}
  </a>
</li>
