---
import { humanize, idFromUrl } from '../lib/pokeapi';

interface Props {
  node: any;
}

const { node } = Astro.props;
const id = idFromUrl(node?.species?.url);
const name = String(node?.species?.name ?? '');
const children = Array.isArray(node?.evolves_to) ? node.evolves_to : [];
---

<li>
  {id !== null && id <= 10000 ? (
    <a href={`/pokemon/${name}`}>{humanize(name)}</a>
  ) : (
    <span>{humanize(name)}</span>
  )}
  {children.length > 0 && (
    <ul class="evolution-list">
      {children.map((child: any) => <Astro.self node={child} />)}
    </ul>
  )}
</li>
