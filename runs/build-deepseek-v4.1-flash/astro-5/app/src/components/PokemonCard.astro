---
import { humanize, mediaUrl } from '../lib/pokeapi';

interface Props {
  id: number;
  name: string;
  types?: string[];
  showTypes?: boolean;
  hidden?: boolean;
  sprite?: string | null;
}

const { id, name, types = [], showTypes = false, hidden = false, sprite } = Astro.props;
const dexNumber = `#${String(id).padStart(4, '0')}`;
const displayName = humanize(name);
const imageSrc = sprite ?? mediaUrl(`/media/sprites/pokemon/${id}.png`);
---

<li>
  <a class="pokemon-card" href={`/pokemon/${name}`}>
    <img
      class="card-sprite"
      src={imageSrc ?? ''}
      alt=""
      width="96"
      height="96"
      loading="lazy"
      decoding="async"
    />
    <span class="card-id">{dexNumber}</span>
    <span class="card-name">{displayName}</span>
    {showTypes && types.length > 0 && (
      <span class="card-badges">
        {types.map((type) => (
          <span class="badge" data-type={type}>{humanize(type)}</span>
        ))}
      </span>
    )}
    {hidden && <span class="card-hidden">Hidden ability</span>}
  </a>
</li>
