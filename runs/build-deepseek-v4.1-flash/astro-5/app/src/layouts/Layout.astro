---
import '../styles/global.css';

interface Props {
  title: string;
  isHome?: boolean;
}

const { title, isHome = false } = Astro.props;
const documentTitle = isHome ? 'Pokédex' : `${title} – Pokédex`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta
      name="description"
      content="A browsable encyclopedia of Pokémon, moves, abilities and types."
    />
    <title>{documentTitle}</title>
  </head>
  <body>
    <header class="banner">
      <div class="container banner-inner">
        <a class="brand" href="/">Pokédex</a>
        <nav class="nav" aria-label="Main">
          <a href="/">Pokémon</a>
          <a href="/types">Types</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer>
      <div class="container">
        Data from PokéAPI. Pokémon and Pokémon character names are trademarks of Nintendo.
      </div>
    </footer>
  </body>
</html>
