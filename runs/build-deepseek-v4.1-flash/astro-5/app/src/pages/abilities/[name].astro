---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import NotFoundContent from '../../components/NotFoundContent.astro';
import {
  api,
  englishName,
  humanize,
  isNotFound,
  mapPokemonToSpecies,
} from '../../lib/pokeapi';

export const prerender = false;

const { name } = Astro.params;

let ability: any = null;
let notFound = false;
try {
  ability = await api<any>(`ability/${encodeURIComponent(name)}`);
} catch (error) {
  if (isNotFound(error)) notFound = true;
  else throw error;
}

if (notFound) {
  Astro.response.status = 404;
}

let pokemon: Array<Awaited<ReturnType<typeof mapPokemonToSpecies>>[number] & { hidden: boolean }> = [];
if (ability) {
  const mapped = await mapPokemonToSpecies((ability.pokemon ?? []).map((entry: any) => entry.pokemon));
  const hiddenById = new Map<number, boolean>();
  for (const entry of ability.pokemon ?? []) {
    const id = Number(String(entry.pokemon?.url ?? '').match(/\/(\d+)\/?$/)?.[1]);
    if (Number.isFinite(id)) hiddenById.set(id, Boolean(entry.is_hidden));
  }
  pokemon = mapped.map((entry) => ({ ...entry, hidden: hiddenById.get(entry.id) === true }));
}

const english = ability ? englishName(ability.names, humanize(ability.name)) : 'Not found';
const effect = ability?.effect_entries?.find((entry: any) => entry.language?.name === 'en')?.short_effect ?? '—';
---

<Layout title={notFound ? 'Not found' : english}>
  {!ability ? (
    <NotFoundContent />
  ) : (
    <article>
      <h1>{english}</h1>

      <Section headingId="effect-heading" heading="Effect">
        <p>{effect}</p>
      </Section>

      <Section headingId="pokemon-heading" heading="Pokémon">
        <p class="result-count">{pokemon.length} Pokémon</p>
        <ul class="card-grid">
          {pokemon.map((entry) => (
            <PokemonCard id={entry.id} name={entry.speciesName} hidden={entry.hidden} />
          ))}
        </ul>
      </Section>
    </article>
  )}
</Layout>
