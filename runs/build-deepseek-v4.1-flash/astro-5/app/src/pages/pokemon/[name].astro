---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import EvolutionTree from '../../components/EvolutionTree.astro';
import NotFoundContent from '../../components/NotFoundContent.astro';
import {
  api,
  dash,
  getPokemonMovesData,
  getPokemonPageData,
  humanize,
  isNotFound,
  mediaUrl,
} from '../../lib/pokeapi';

export const prerender = false;

const { name } = Astro.params;

let data: Awaited<ReturnType<typeof getPokemonPageData>> | null = null;
let notFound = false;
try {
  data = await getPokemonPageData(name);
} catch (error) {
  if (isNotFound(error)) notFound = true;
  else throw error;
}

if (notFound) {
  Astro.response.status = 404;
}

let movesData: Awaited<ReturnType<typeof getPokemonMovesData>> | null = null;
let evolutionChain: any = null;

if (data) {
  const game = Astro.url.searchParams.get('game');
  const [moves, evolution] = await Promise.all([
    getPokemonMovesData(data.pokemon, game),
    data.species.evolution_chain?.url
      ? api<any>(data.species.evolution_chain.url)
      : Promise.resolve(null),
  ]);
  movesData = moves;
  evolutionChain = evolution?.chain ?? null;
}

const pokemon = data?.pokemon;
const species = data?.species;
const english = data?.englishName ?? 'Not found';
const dexNumber = species ? `#${String(species.id).padStart(4, '0')}` : '';

const artwork = pokemon
  ? mediaUrl(
      pokemon.sprites?.other?.['official-artwork']?.front_default ??
        pokemon.sprites?.front_default ??
        `/media/sprites/pokemon/${pokemon.id}.png`,
    )
  : null;

const statLabels: Record<string, string> = {
  hp: 'HP',
  attack: 'Attack',
  defense: 'Defense',
  'special-attack': 'Sp. Atk',
  'special-defense': 'Sp. Def',
  speed: 'Speed',
};

const stats = (pokemon?.stats ?? []).map((entry: any) => ({
  key: entry.stat?.name ?? '',
  label: statLabels[entry.stat?.name ?? ''] ?? humanize(entry.stat?.name ?? ''),
  value: Number(entry.base_stat) || 0,
}));
const statTotal = stats.reduce((sum: number, stat: any) => sum + stat.value, 0);

const abilities = (pokemon?.abilities ?? [])
  .slice()
  .sort((a: any, b: any) => (a.slot ?? 0) - (b.slot ?? 0));
---

<Layout title={notFound ? 'Not found' : english}>
  {notFound || !data ? (
    <NotFoundContent />
  ) : (
    <article>
      <div class="pokemon-summary">
        <img class="artwork" src={artwork ?? ''} alt={english} width="288" height="288" />
        <div class="summary-info">
          <span class="summary-id">{dexNumber}</span>
          <h1>{english}</h1>
          {data.genus && <p class="genus">{data.genus}</p>}

          <div class="type-row">
            {data.types.map((type) => (
              <a class="badge" data-type={type.name} href={`/types/${type.name}`}>{type.label}</a>
            ))}
          </div>

          <dl class="measurements">
            <div>
              <dt>Height</dt>
              <dd>{(pokemon.height / 10).toFixed(1)} m</dd>
            </div>
            <div>
              <dt>Weight</dt>
              <dd>{(pokemon.weight / 10).toFixed(1)} kg</dd>
            </div>
          </dl>

          {data.flavorText && <p class="flavor-text">{data.flavorText}</p>}
        </div>
      </div>

      <Section headingId="stats-heading" heading="Base stats">
        <table class="stats-table">
          <tbody>
            {stats.map((stat: any) => (
              <tr>
                <th scope="row">{stat.label}</th>
                <td class="stat-value">{stat.value}</td>
                <td class="stat-bar-cell">
                  <div class="stat-track">
                    <div
                      class="stat-fill"
                      style={`width: ${Math.min(100, Math.round((stat.value / 255) * 100))}%`}
                    />
                  </div>
                </td>
              </tr>
            ))}
            <tr>
              <th scope="row">Total</th>
              <td class="stat-value">{statTotal}</td>
              <td class="stat-bar-cell">
                <div class="stat-track">
                  <div
                    class="stat-fill"
                    style={`width: ${Math.min(100, Math.round((statTotal / (255 * Math.max(stats.length, 1))) * 100))}%`}
                  />
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </Section>

      <Section headingId="abilities-heading" heading="Abilities">
        <ul class="plain-list">
          {abilities.map((ability: any) => (
            <li>
              <a href={`/abilities/${ability.ability.name}`}>{humanize(ability.ability.name)}</a>
              {ability.is_hidden ? ' (hidden)' : ''}
            </li>
          ))}
        </ul>
      </Section>

      <Section headingId="evolution-heading" heading="Evolution">
        {evolutionChain ? <EvolutionTree chain={evolutionChain} /> : <p>—</p>}
      </Section>

      <Section id="moves" headingId="moves-heading" heading="Moves">
        {movesData && movesData.versionGroups.length > 0 ? (
          <>
            <div class="game-field">
              <label for="game">Game</label>
              <select id="game" data-game-select>
                {movesData.versionGroups.map((group) => (
                  <option value={group.name} selected={group.name === movesData.selectedGame}>
                    {group.label}
                  </option>
                ))}
              </select>
            </div>

            {movesData.methodGroups.map((group) => (
              <div class="table-wrap">
                <table class="moves-table" data-moves-table data-method={group.methodName}>
                  <caption>{group.label}</caption>
                  <thead>
                    <tr>
                      {group.methodName === 'level-up' && (
                        <th scope="col" data-sort="level">
                          <button class="sort-button" type="button">Level</button>
                        </th>
                      )}
                      <th scope="col" data-sort="move">
                        <button class="sort-button" type="button">Move</button>
                      </th>
                      <th scope="col" data-sort="type">
                        <button class="sort-button" type="button">Type</button>
                      </th>
                      <th scope="col" data-sort="category">
                        <button class="sort-button" type="button">Category</button>
                      </th>
                      <th scope="col" data-sort="power">
                        <button class="sort-button" type="button">Power</button>
                      </th>
                      <th scope="col" data-sort="accuracy">
                        <button class="sort-button" type="button">Accuracy</button>
                      </th>
                      <th scope="col" data-sort="pp">
                        <button class="sort-button" type="button">PP</button>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.rows.map((row) => (
                      <tr>
                        {group.methodName === 'level-up' && <td>{dash(row.level)}</td>}
                        <td><a href={`/moves/${row.moveName}`}>{row.moveLabel}</a></td>
                        <td>
                          <a class="badge" data-type={row.typeName} href={`/types/${row.typeName}`}>
                            {row.typeLabel}
                          </a>
                        </td>
                        <td>{row.category}</td>
                        <td>{dash(row.power)}</td>
                        <td>{dash(row.accuracy)}</td>
                        <td>{dash(row.pp)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </>
        ) : (
          <p>—</p>
        )}
      </Section>
    </article>
  )}
</Layout>

<script>
  const gameSelect = document.querySelector('[data-game-select]');
  if (gameSelect) {
    gameSelect.addEventListener('change', () => {
      const url = new URL(window.location.href);
      url.searchParams.set('game', gameSelect.value);
      window.location.assign(url.pathname + url.search + url.hash);
    });
  }

  function sortTable(table, header) {
    const key = header.dataset.sort;
    const previous = header.getAttribute('aria-sort');
    const direction = previous === 'ascending' ? 'descending' : 'ascending';

    for (const other of table.querySelectorAll('th[data-sort]')) {
      other.removeAttribute('aria-sort');
    }
    header.setAttribute('aria-sort', direction);

    const headerCells = [...table.querySelectorAll('thead th')];
    const index = headerCells.indexOf(header);
    const body = table.querySelector('tbody');
    if (!body || index === -1) return;

    const numeric = new Set(['level', 'power', 'accuracy', 'pp']);
    const rows = [...body.querySelectorAll('tr')];

    rows.sort((a, b) => {
      const aText = (a.cells[index]?.textContent ?? '').trim();
      const bText = (b.cells[index]?.textContent ?? '').trim();
      const aMissing = aText === '' || aText === '—';
      const bMissing = bText === '' || bText === '—';
      if (aMissing && bMissing) return 0;
      if (aMissing) return 1;
      if (bMissing) return -1;

      let comparison;
      if (numeric.has(key)) comparison = Number(aText) - Number(bText);
      else comparison = aText.localeCompare(bText, undefined, { sensitivity: 'base' });
      return direction === 'ascending' ? comparison : -comparison;
    });

    for (const row of rows) body.appendChild(row);
  }

  for (const table of document.querySelectorAll('table[data-moves-table]')) {
    for (const header of table.querySelectorAll('th[data-sort]')) {
      header.addEventListener('click', () => sortTable(table, header));
    }
  }
</script>
