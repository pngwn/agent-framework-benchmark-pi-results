---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import NotFoundContent from '../../components/NotFoundContent.astro';
import {
  api,
  dash,
  englishName,
  humanize,
  isNotFound,
  latestEnglishFlavorText,
  mapPokemonToSpecies,
} from '../../lib/pokeapi';

export const prerender = false;

const { name } = Astro.params;

let move: any = null;
let notFound = false;
try {
  move = await api<any>(`move/${encodeURIComponent(name)}`);
} catch (error) {
  if (isNotFound(error)) notFound = true;
  else throw error;
}

if (notFound) {
  Astro.response.status = 404;
}

let learnedBy: Awaited<ReturnType<typeof mapPokemonToSpecies>> = [];
if (move) {
  learnedBy = await mapPokemonToSpecies(move.learned_by_pokemon ?? []);
}

const english = move ? englishName(move.names, humanize(move.name)) : 'Not found';
const englishEffect = move?.effect_entries?.find((entry: any) => entry.language?.name === 'en')?.short_effect;
const effect = englishEffect || latestEnglishFlavorText(move?.flavor_text_entries) || '—';
const category = move ? humanize(move.damage_class?.name ?? '') : '';
const typeName = move?.type?.name ?? '';
---

<Layout title={notFound ? 'Not found' : english}>
  {!move ? (
    <NotFoundContent />
  ) : (
    <article>
      <h1 class="compact-heading">{english}</h1>

      <dl class="facts">
        <div class="fact">
          <dt>Type</dt>
          <dd>
            <a class="badge" data-type={typeName} href={`/types/${typeName}`}>{humanize(typeName)}</a>
          </dd>
        </div>
        <div class="fact">
          <dt>Category</dt>
          <dd>{category}</dd>
        </div>
        <div class="fact">
          <dt>Power</dt>
          <dd>{dash(move.power)}</dd>
        </div>
        <div class="fact">
          <dt>Accuracy</dt>
          <dd>{dash(move.accuracy)}</dd>
        </div>
        <div class="fact">
          <dt>PP</dt>
          <dd>{dash(move.pp)}</dd>
        </div>
      </dl>

      <Section headingId="effect-heading" heading="Effect">
        <p>{effect}</p>
      </Section>

      <Section headingId="learned-by-heading" heading="Learned by">
        <p class="result-count">{learnedBy.length} Pokémon</p>
        <ul class="card-grid">
          {learnedBy.map((entry) => (
            <PokemonCard id={entry.id} name={entry.speciesName} />
          ))}
        </ul>
      </Section>
    </article>
  )}
</Layout>
