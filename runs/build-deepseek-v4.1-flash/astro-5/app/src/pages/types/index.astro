---
import Layout from '../../layouts/Layout.astro';
import { getTypes } from '../../lib/pokeapi';

export const prerender = false;

const types = await getTypes();
---

<Layout title="Types">
  <h1 class="compact-heading">Types</h1>
  <ul class="type-grid">
    {types.map((type) => (
      <li>
        <a data-type={type.name} href={`/types/${type.name}`}>{type.englishName}</a>
      </li>
    ))}
  </ul>
</Layout>
