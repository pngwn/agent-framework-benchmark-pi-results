---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import NotFoundContent from '../../components/NotFoundContent.astro';
import {
  api,
  englishName,
  humanize,
  isNotFound,
  mapPokemonToSpecies,
} from '../../lib/pokeapi';

export const prerender = false;

const { name } = Astro.params;

let type: any = null;
let notFound = false;
try {
  type = await api<any>(`type/${encodeURIComponent(name)}`);
} catch (error) {
  if (isNotFound(error)) notFound = true;
  else throw error;
}

if (notFound) {
  Astro.response.status = 404;
}

let pokemon: Awaited<ReturnType<typeof mapPokemonToSpecies>> = [];
if (type) {
  pokemon = await mapPokemonToSpecies((type.pokemon ?? []).map((entry: any) => entry.pokemon));
}

const english = type ? englishName(type.names, humanize(type.name)) : 'Not found';

const relations = [
  ['Super effective against', 'double_damage_to'],
  ['Not very effective against', 'half_damage_to'],
  ['No effect against', 'no_damage_to'],
  ['Weak to', 'double_damage_from'],
  ['Resists', 'half_damage_from'],
  ['Immune to', 'no_damage_from'],
] as const;

const damageRelations = relations.map(([label, key]) => ({
  label,
  types: (type?.damage_relations?.[key] ?? []).map((entry: any) => ({
    name: entry.name,
    label: humanize(entry.name),
  })),
}));

const moves = (type?.moves ?? [])
  .map((move: any) => ({ name: move.name, label: humanize(move.name) }))
  .sort((a: any, b: any) => a.label.localeCompare(b.label));
---

<Layout title={notFound ? 'Not found' : english}>
  {!type ? (
    <NotFoundContent />
  ) : (
    <article>
      <h1>{english}</h1>

      <Section headingId="damage-relations-heading" heading="Damage relations">
        <dl class="damage-grid">
          {damageRelations.map((relation) => (
            <div class="relation">
              <dt>{relation.label}</dt>
              <dd>
                {relation.types.length === 0 ? (
                  'None'
                ) : (
                  relation.types.map((related: any) => (
                    <a class="badge" data-type={related.name} href={`/types/${related.name}`}>
                      {related.label}
                    </a>
                  ))
                )}
              </dd>
            </div>
          ))}
        </dl>
      </Section>

      <Section headingId="pokemon-heading" heading="Pokémon">
        <p class="result-count">{pokemon.length} Pokémon</p>
        <ul class="card-grid">
          {pokemon.map((entry) => (
            <PokemonCard id={entry.id} name={entry.speciesName} />
          ))}
        </ul>
      </Section>

      <Section headingId="moves-heading" heading="Moves">
        <p class="result-count">{moves.length} moves</p>
        <ul class="link-grid">
          {moves.map((move: any) => (
            <li><a href={`/moves/${move.name}`}>{move.label}</a></li>
          ))}
        </ul>
      </Section>
    </article>
  )}
</Layout>
