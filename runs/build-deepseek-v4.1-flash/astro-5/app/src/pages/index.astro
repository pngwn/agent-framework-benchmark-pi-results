---
import Layout from '../layouts/Layout.astro';
import PokemonCard from '../components/PokemonCard.astro';
import { humanize, getPokedexData, mediaUrl } from '../lib/pokeapi';

export const prerender = false;

const { species, types, generations } = await getPokedexData();
const typeOptions = types.map((type) => ({ name: type.name, label: type.englishName }));
const generationOptions = generations.map((generation) => ({
  name: generation.name,
  label: generation.englishName,
}));

const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim();
const requestedType = params.get('type') ?? '';
const requestedGeneration = params.get('generation') ?? '';
const type = typeOptions.some((option) => option.name === requestedType) ? requestedType : '';
const generation = generationOptions.some((option) => option.name === requestedGeneration)
  ? requestedGeneration
  : '';

const PAGE_SIZE = 48;
const allSpecies = species.map((entry) => ({
  ...entry,
  sprite: mediaUrl(`/media/sprites/pokemon/${entry.id}.png`),
}));

const normalizedQuery = q.toLowerCase();
const filtered = allSpecies.filter((entry) => {
  if (normalizedQuery && !humanize(entry.name).toLowerCase().includes(normalizedQuery)) return false;
  if (type && !entry.types.includes(type)) return false;
  if (generation && entry.generation !== generation) return false;
  return true;
});

const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const rawPage = Number.parseInt(params.get('page') ?? '1', 10);
const page = Math.min(Math.max(Number.isFinite(rawPage) ? rawPage : 1, 1), totalPages);
const pageItems = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

function hrefForPage(targetPage: number) {
  const next = new URLSearchParams();
  if (q) next.set('q', q);
  if (type) next.set('type', type);
  if (generation) next.set('generation', generation);
  if (targetPage > 1) next.set('page', String(targetPage));
  const query = next.toString();
  return next.size ? `/?${query}` : '/';
}

const payload = {
  species: allSpecies,
  types: typeOptions,
  generations: generationOptions,
  pageSize: PAGE_SIZE,
};
---

<Layout title="Pokémon" isHome={true}>
  <h1 class="compact-heading">Pokémon</h1>

  <div class="filters" data-home-filters>
    <div class="field">
      <label for="search">Search</label>
      <input id="search" name="q" type="search" value={q} autocomplete="off" />
    </div>
    <div class="field">
      <label for="type">Type</label>
      <select id="type" name="type">
        <option value="">All types</option>
        {typeOptions.map((option) => (
          <option value={option.name} selected={option.name === type}>{option.label}</option>
        ))}
      </select>
    </div>
    <div class="field">
      <label for="generation">Generation</label>
      <select id="generation" name="generation">
        <option value="">All generations</option>
        {generationOptions.map((option) => (
          <option value={option.name} selected={option.name === generation}>{option.label}</option>
        ))}
      </select>
    </div>
  </div>

  <p class="result-count" id="result-count">{filtered.length} Pokémon</p>

  {filtered.length === 0 ? (
    <p class="no-results" id="no-results">No Pokémon found</p>
  ) : (
    <p class="no-results" id="no-results" hidden>No Pokémon found</p>
  )}

  <ul
    class="card-grid"
    id="pokemon-list"
    hidden={filtered.length === 0}
  >
    {pageItems.map((entry) => (
      <PokemonCard
        id={entry.id}
        name={entry.name}
        types={entry.types}
        showTypes={true}
        sprite={entry.sprite}
      />
    ))}
  </ul>

  <nav
    class="pagination"
    id="pagination"
    aria-label="Pagination"
    hidden={filtered.length === 0}
  >
    <span id="page-status">Page {page} of {totalPages}</span>
    {page > 1 && <a id="previous-page" href={hrefForPage(page - 1)}>Previous page</a>}
    {page < totalPages && <a id="next-page" href={hrefForPage(page + 1)}>Next page</a>}
  </nav>

  <script type="application/json" id="pokedex-data" set:html={JSON.stringify(payload)} />
</Layout>

<script>
  const dataNode = document.getElementById('pokedex-data');
  const searchInput = document.getElementById('search');
  const typeSelect = document.getElementById('type');
  const generationSelect = document.getElementById('generation');
  const countNode = document.getElementById('result-count');
  const listNode = document.getElementById('pokemon-list');
  const noResultsNode = document.getElementById('no-results');
  const pagination = document.getElementById('pagination');

  if (dataNode && searchInput && typeSelect && generationSelect && countNode && listNode && noResultsNode && pagination) {
    const payload = JSON.parse(dataNode.textContent || '{}');
    const species = payload.species || [];
    const types = payload.types || [];
    const generations = payload.generations || [];
    const pageSize = payload.pageSize || 48;
    const typeNames = new Set(types.map((entry) => entry.name));
    const generationNames = new Set(generations.map((entry) => entry.name));

    const humanize = (name) =>
      String(name)
        .split('-')
        .map((word) => (word ? word[0].toUpperCase() + word.slice(1) : word))
        .join(' ');

    function readUrl() {
      const params = new URLSearchParams(window.location.search);
      const requestedType = params.get('type') || '';
      const requestedGeneration = params.get('generation') || '';
      return {
        q: (params.get('q') || '').trim(),
        type: typeNames.has(requestedType) ? requestedType : '',
        generation: generationNames.has(requestedGeneration) ? requestedGeneration : '',
        page: Math.max(1, Number.parseInt(params.get('page') || '1', 10) || 1),
      };
    }

    let state = readUrl();

    function writeControls() {
      searchInput.value = state.q;
      typeSelect.value = state.type;
      generationSelect.value = state.generation;
    }

    function urlForState(targetPage = state.page) {
      const params = new URLSearchParams();
      if (state.q) params.set('q', state.q);
      if (state.type) params.set('type', state.type);
      if (state.generation) params.set('generation', state.generation);
      if (targetPage > 1) params.set('page', String(targetPage));
      const query = params.toString();
      return query ? `/?${query}` : '/';
    }

    function writeUrl(mode) {
      const url = urlForState();
      if (mode === 'push') window.history.pushState({}, '', url);
      else window.history.replaceState({}, '', url);
    }

    function createCard(entry) {
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.className = 'pokemon-card';
      link.href = `/pokemon/${entry.name}`;

      const image = document.createElement('img');
      image.className = 'card-sprite';
      image.src = entry.sprite || '';
      image.alt = '';
      image.width = 96;
      image.height = 96;
      image.loading = 'lazy';
      image.decoding = 'async';

      const id = document.createElement('span');
      id.className = 'card-id';
      id.textContent = `#${String(entry.id).padStart(4, '0')}`;

      const name = document.createElement('span');
      name.className = 'card-name';
      name.textContent = humanize(entry.name);

      const badges = document.createElement('span');
      badges.className = 'card-badges';
      for (const type of entry.types || []) {
        const badge = document.createElement('span');
        badge.className = 'badge';
        badge.dataset.type = type;
        badge.textContent = humanize(type);
        badges.appendChild(badge);
      }

      link.append(image, id, name, badges);
      li.appendChild(link);
      return li;
    }

    function render() {
      const query = state.q.toLowerCase();
      const filtered = species.filter((entry) => {
        if (query && !humanize(entry.name).toLowerCase().includes(query)) return false;
        if (state.type && !(entry.types || []).includes(state.type)) return false;
        if (state.generation && entry.generation !== state.generation) return false;
        return true;
      });

      const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
      state.page = Math.min(Math.max(state.page, 1), totalPages);
      const pageItems = filtered.slice((state.page - 1) * pageSize, state.page * pageSize);

      countNode.textContent = `${filtered.length} Pokémon`;
      noResultsNode.hidden = filtered.length !== 0;
      listNode.hidden = filtered.length === 0;
      pagination.hidden = filtered.length === 0;

      listNode.replaceChildren(...pageItems.map(createCard));

      pagination.replaceChildren();
      const status = document.createElement('span');
      status.textContent = `Page ${state.page} of ${totalPages}`;
      pagination.appendChild(status);

      if (state.page > 1) {
        const previous = document.createElement('a');
        previous.textContent = 'Previous page';
        previous.href = urlForState(state.page - 1);
        previous.addEventListener('click', (event) => {
          event.preventDefault();
          state.page -= 1;
          writeUrl('push');
          render();
          window.scrollTo({ top: 0 });
        });
        pagination.appendChild(previous);
      }

      if (state.page < totalPages) {
        const next = document.createElement('a');
        next.textContent = 'Next page';
        next.href = urlForState(state.page + 1);
        next.addEventListener('click', (event) => {
          event.preventDefault();
          state.page += 1;
          writeUrl('push');
          render();
          window.scrollTo({ top: 0 });
        });
        pagination.appendChild(next);
      }
    }

    let searchTimer;
    searchInput.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        state.q = searchInput.value.trim();
        state.page = 1;
        writeUrl('replace');
        render();
      }, 200);
    });

    typeSelect.addEventListener('change', () => {
      state.type = typeSelect.value;
      state.page = 1;
      writeUrl('replace');
      render();
    });

    generationSelect.addEventListener('change', () => {
      state.generation = generationSelect.value;
      state.page = 1;
      writeUrl('replace');
      render();
    });

    window.addEventListener('popstate', () => {
      state = readUrl();
      writeControls();
      render();
    });

    writeControls();
    render();
  }
</script>
