---
import Layout from '../../layouts/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import EvolutionNode from '../../components/EvolutionNode.astro';
import { getPokemonPageData } from '../../lib/api';

let data: Awaited<ReturnType<typeof getPokemonPageData>> | null = null;
try {
  data = await getPokemonPageData(Astro.params.name ?? '');
} catch (error: any) {
  if (error?.status === 404) {
    Astro.response.status = 404;
  } else {
    throw error;
  }
}

const requestedGame = new URL(Astro.request.url).searchParams.get('game') ?? '';
const selectedGame = data
  ? data.games.some((game) => game.name === requestedGame)
    ? requestedGame
    : data.defaultGroup
  : null;

const title = data ? `${data.name} – Pokédex` : 'Not found – Pokédex';

function barWidth(value: number, total = false) {
  const scaled = total ? value / 6 : value;
  return `${Math.min(100, Math.max(0, (scaled / 255) * 100)).toFixed(2)}%`;
}

function sortNumber(value: string) {
  return value === '—' ? '' : value;
}
---

<Layout title={title}>
  {data ? (
    <>
      <div class="pokemon-summary">
        <div class="artwork">
          {data.artwork && <img src={data.artwork} alt={data.name} width="256" height="256" />}
        </div>
        <div class="summary">
          <p class="summary-dex">#{String(data.id).padStart(4, '0')}</p>
          <h1 class="summary-heading">{data.name}</h1>
          {data.genus && <p class="genus">{data.genus}</p>}
          <div class="badges summary-types">
            {data.types.map((type) => (
              <a class={`badge type-${type.name}`} href={`/types/${type.name}`}>{type.display}</a>
            ))}
          </div>
          <dl class="measurements">
            <div>
              <dt>Height</dt>
              <dd>{data.height}</dd>
            </div>
            <div>
              <dt>Weight</dt>
              <dd>{data.weight}</dd>
            </div>
          </dl>
          <p class="flavor">{data.flavor}</p>
        </div>
      </div>

      <section class="panel" aria-labelledby="stats-heading">
        <h2 id="stats-heading">Base stats</h2>
        <table class="stats-table">
          <tbody>
            {data.stats.map((stat) => (
              <tr>
                <th scope="row">{stat.label}</th>
                <td class="stat-value">{stat.value}</td>
                <td>
                  <div class="stat-track">
                    <div class="stat-fill" style={`width: ${barWidth(stat.value)}`}></div>
                  </div>
                </td>
              </tr>
            ))}
            <tr>
              <th scope="row">Total</th>
              <td class="stat-value">{data.total}</td>
              <td>
                <div class="stat-track">
                  <div class="stat-fill" style={`width: ${barWidth(data.total, true)}`}></div>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="panel" aria-labelledby="abilities-heading">
        <h2 id="abilities-heading">Abilities</h2>
        <ul class="ability-list">
          {data.abilities.map((ability) => (
            <li>
              <a href={`/abilities/${ability.name}`}>{ability.display}</a>{ability.hidden ? ' (hidden)' : ''}
            </li>
          ))}
        </ul>
      </section>

      <section class="panel" aria-labelledby="evolution-heading">
        <h2 id="evolution-heading">Evolution</h2>
        {data.evolution ? (
          <ul class="evolution-tree">
            <EvolutionNode node={data.evolution} />
          </ul>
        ) : (
          <p>—</p>
        )}
      </section>

      <section class="panel" id="moves" aria-labelledby="moves-heading">
        <h2 id="moves-heading">Moves</h2>

        {data.games.length > 0 ? (
          <>
            <div class="moves-controls">
              <label for="game-select">Game</label>
              <select id="game-select" data-game-select>
                {data.games.map((game) => (
                  <option value={game.name} selected={game.name === selectedGame}>{game.display}</option>
                ))}
              </select>
            </div>

            {data.games.map((game) => (
              <div class="game-panel" data-game-panel data-game={game.name} hidden={game.name !== selectedGame}>
                {game.tables.map((table) => (
                  <div class="table-wrap">
                    <table class="move-table">
                      <caption>{table.display}</caption>
                      <colgroup>
                        {table.isLevelUp && <col class="col-level" />}
                        <col class="col-move" />
                        <col class="col-type" />
                        <col class="col-category" />
                        <col class="col-power" />
                        <col class="col-accuracy" />
                        <col class="col-pp" />
                      </colgroup>
                      <thead>
                        <tr>
                          {table.isLevelUp && (
                            <th data-col="0" data-sort-type="number">
                              <button class="sort-button" type="button">Level</button>
                            </th>
                          )}
                          <th data-col={table.isLevelUp ? '1' : '0'} data-sort-type="text">
                            <button class="sort-button" type="button">Move</button>
                          </th>
                          <th data-col={table.isLevelUp ? '2' : '1'} data-sort-type="text">
                            <button class="sort-button" type="button">Type</button>
                          </th>
                          <th data-col={table.isLevelUp ? '3' : '2'} data-sort-type="text">
                            <button class="sort-button" type="button">Category</button>
                          </th>
                          <th data-col={table.isLevelUp ? '4' : '3'} data-sort-type="number">
                            <button class="sort-button" type="button">Power</button>
                          </th>
                          <th data-col={table.isLevelUp ? '5' : '4'} data-sort-type="number">
                            <button class="sort-button" type="button">Accuracy</button>
                          </th>
                          <th data-col={table.isLevelUp ? '6' : '5'} data-sort-type="number">
                            <button class="sort-button" type="button">PP</button>
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {table.rows.map((row) => (
                          <tr data-move={row.moveDisplay}>
                            {table.isLevelUp && (
                              <th scope="row" data-sort={row.level === null ? '' : String(row.level)}>{row.level}</th>
                            )}
                            <td data-sort={row.moveDisplay}>
                              <a href={`/moves/${row.moveName}`}>{row.moveDisplay}</a>
                            </td>
                            <td data-sort={row.typeDisplay}>
                              <a class={`badge type-${row.type}`} href={`/types/${row.type}`}>{row.typeDisplay}</a>
                            </td>
                            <td data-sort={row.category === '—' ? '' : row.category}>{row.category}</td>
                            <td data-sort={sortNumber(row.power)}>{row.power}</td>
                            <td data-sort={sortNumber(row.accuracy)}>{row.accuracy}</td>
                            <td data-sort={sortNumber(row.pp)}>{row.pp}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ))}
              </div>
            ))}
          </>
        ) : (
          <p>—</p>
        )}
      </section>
    </>
  ) : (
    <NotFound />
  )}
</Layout>

<script>
  const gameSelect = document.querySelector('[data-game-select]');
  const gamePanels = Array.from(document.querySelectorAll('[data-game-panel]'));

  gameSelect?.addEventListener('change', () => {
    const value = gameSelect.value;
    for (const panel of gamePanels) {
      panel.hidden = panel.getAttribute('data-game') !== value;
    }
    const url = new URL(window.location.href);
    url.searchParams.set('game', value);
    history.replaceState(null, '', url);
  });

  function compareValues(a, b, type) {
    if (type === 'number') return Number(a) - Number(b);
    return String(a).localeCompare(String(b));
  }

  function sortTable(table, column, type, direction) {
    const tbody = table.tBodies[0];
    if (!tbody) return;
    const rows = Array.from(tbody.rows);
    rows.sort((rowA, rowB) => {
      const valuesA = Array.from(rowA.querySelectorAll('[data-sort]'));
      const valuesB = Array.from(rowB.querySelectorAll('[data-sort]'));
      const a = valuesA[column]?.getAttribute('data-sort') ?? '';
      const b = valuesB[column]?.getAttribute('data-sort') ?? '';
      const aMissing = a === '';
      const bMissing = b === '';
      if (aMissing && bMissing) return (rowA.dataset.move || '').localeCompare(rowB.dataset.move || '');
      if (aMissing) return 1;
      if (bMissing) return -1;
      const result = compareValues(a, b, type);
      if (result === 0) return (rowA.dataset.move || '').localeCompare(rowB.dataset.move || '');
      return direction === 'ascending' ? result : -result;
    });
    for (const row of rows) tbody.appendChild(row);
  }

  for (const table of document.querySelectorAll('.move-table')) {
    const headers = Array.from(table.querySelectorAll('th[data-col]'));
    for (const header of headers) {
      const button = header.querySelector('button');
      button?.addEventListener('click', () => {
        const direction = header.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
        for (const other of headers) other.removeAttribute('aria-sort');
        header.setAttribute('aria-sort', direction);
        sortTable(
          table,
          Number(header.getAttribute('data-col')),
          header.getAttribute('data-sort-type') || 'text',
          direction,
        );
      });
    }
  }
</script>
