---
import Layout from '../../layouts/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { getTypePageData } from '../../lib/api';

let data: Awaited<ReturnType<typeof getTypePageData>> | null = null;
try {
  data = await getTypePageData(Astro.params.name ?? '');
} catch (error: any) {
  if (error?.status === 404) Astro.response.status = 404;
  else throw error;
}

const title = data ? `${data.name} – Pokédex` : 'Not found – Pokédex';
---

<Layout title={title}>
  {data ? (
    <>
      <h1>{data.name}</h1>

      <section class="panel" aria-labelledby="damage-relations-heading">
        <h2 id="damage-relations-heading">Damage relations</h2>
        <dl class="damage-relations">
          {data.relations.map((relation) => (
            <div>
              <dt>{relation.label}</dt>
              <dd>
                {relation.types.length > 0 ? (
                  <span class="badge-row">
                    {relation.types.map((type) => (
                      <a class={`badge type-${type.name}`} href={`/types/${type.name}`}>{type.display}</a>
                    ))}
                  </span>
                ) : (
                  'None'
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="panel" aria-labelledby="pokemon-heading">
        <h2 id="pokemon-heading">Pokémon</h2>
        <p class="count-text">{data.pokemon.length} Pokémon</p>
        <ul class="card-grid">
          {data.pokemon.map((card) => <PokemonCard card={card} />)}
        </ul>
      </section>

      <section class="panel" aria-labelledby="moves-heading">
        <h2 id="moves-heading">Moves</h2>
        <p class="count-text">{data.moves.length} moves</p>
        <ul>
          {data.moves.map((move) => (
            <li><a href={`/moves/${move.name}`}>{move.display}</a></li>
          ))}
        </ul>
      </section>
    </>
  ) : (
    <NotFound />
  )}
</Layout>
