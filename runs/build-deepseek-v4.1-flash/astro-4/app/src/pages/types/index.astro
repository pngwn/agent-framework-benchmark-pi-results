---
import Layout from '../../layouts/Layout.astro';
import { getTypesPageData } from '../../lib/api';

const types = await getTypesPageData();
---

<Layout title="Types – Pokédex">
  <h1>Types</h1>
  <ul class="type-list">
    {types.map((type) => (
      <li class={`type-${type.name}`}>
        <a href={`/types/${type.name}`}>{type.display}</a>
      </li>
    ))}
  </ul>
</Layout>
