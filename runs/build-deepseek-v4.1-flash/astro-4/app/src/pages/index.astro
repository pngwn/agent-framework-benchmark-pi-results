---
import Layout from '../layouts/Layout.astro';
import PokemonCard from '../components/PokemonCard.astro';
import { getDexData } from '../lib/api';

const PAGE_SIZE = 48;
const data = await getDexData();
const url = new URL(Astro.request.url);

const q = (url.searchParams.get('q') ?? '').trim();
const requestedType = (url.searchParams.get('type') ?? '').trim();
const requestedGeneration = (url.searchParams.get('generation') ?? '').trim();
const selectedType = data.types.some((type) => type.name === requestedType) ? requestedType : '';
const selectedGeneration = data.generations.some((generation) => generation.name === requestedGeneration)
  ? requestedGeneration
  : '';

const matching = data.species.filter((species) => {
  if (q && !species.display.toLowerCase().includes(q.toLowerCase())) return false;
  if (selectedType && !pokemonHasType(species, selectedType)) return false;
  if (selectedGeneration && species.generation !== selectedGeneration) return false;
  return true;
});

const totalPages = Math.max(1, Math.ceil(matching.length / PAGE_SIZE));
const requestedPage = Number.parseInt(url.searchParams.get('page') ?? '1', 10);
const page = Number.isFinite(requestedPage) ? Math.min(Math.max(1, requestedPage), totalPages) : 1;
const pageSpecies = matching.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

function pokemonHasType(species: { types: { name: string }[] }, typeName: string) {
  return species.types.some((type) => type.name === typeName);
}

function pageHref(targetPage: number) {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (selectedType) params.set('type', selectedType);
  if (selectedGeneration) params.set('generation', selectedGeneration);
  if (targetPage > 1) params.set('page', String(targetPage));
  const search = params.toString();
  return search ? `/?${search}` : '/';
}

const clientData = {
  species: data.species,
  types: data.types.map((type) => ({ name: type.name, display: type.display })),
  generations: data.generations.map((generation) => ({ name: generation.name, display: generation.display })),
  initial: { q, type: selectedType, generation: selectedGeneration, page },
};
---

<Layout title="Pokédex">
  <h1>Pokémon</h1>

  <div class="filters">
    <div class="field">
      <label for="search-filter">Search</label>
      <input id="search-filter" name="q" type="search" autocomplete="off" value={q} />
    </div>
    <div class="field">
      <label for="type-filter">Type</label>
      <select id="type-filter" name="type">
        <option value="">All types</option>
        {data.types.map((type) => (
          <option value={type.name} selected={type.name === selectedType}>{type.display}</option>
        ))}
      </select>
    </div>
    <div class="field">
      <label for="generation-filter">Generation</label>
      <select id="generation-filter" name="generation">
        <option value="">All generations</option>
        {data.generations.map((generation) => (
          <option value={generation.name} selected={generation.name === selectedGeneration}>
            {generation.display}
          </option>
        ))}
      </select>
    </div>
  </div>

  <p class="result-count" data-result-count>{matching.length} Pokémon</p>

  <div data-results>
    {matching.length === 0 ? (
      <p class="no-results" data-no-results>No Pokémon found</p>
    ) : (
      <ul class="card-grid" data-card-grid>
        {pageSpecies.map((species) => <PokemonCard card={species} showTypes />)}
      </ul>
    )}
  </div>

  <nav class="pagination" aria-label="Pagination" data-pagination hidden={matching.length === 0}>
    <span data-page-label>Page {page} of {totalPages}</span>
    {page > 1 && <a href={pageHref(page - 1)} data-prev>Previous page</a>}
    {page < totalPages && <a href={pageHref(page + 1)} data-next>Next page</a>}
  </nav>

  <script type="application/json" id="dex-data" set:html={JSON.stringify(clientData).replace(/</g, '\\u003c')}></script>
  <script>
    const payload = JSON.parse(document.getElementById('dex-data').textContent);
    const allSpecies = Array.isArray(payload.species) ? payload.species : [];
    const types = Array.isArray(payload.types) ? payload.types : [];
    const generations = Array.isArray(payload.generations) ? payload.generations : [];
    const params = new URLSearchParams(window.location.search);
    const state = {
      q: (params.get('q') || '').trim(),
      type: params.get('type') || '',
      generation: params.get('generation') || '',
      page: Number.parseInt(params.get('page') || '1', 10) || 1,
    };
    if (!types.some((type) => type.name === state.type)) state.type = '';
    if (!generations.some((generation) => generation.name === state.generation)) state.generation = '';

    const searchInput = document.getElementById('search-filter');
    const typeSelect = document.getElementById('type-filter');
    const generationSelect = document.getElementById('generation-filter');
    const countNode = document.querySelector('[data-result-count]');
    const resultsNode = document.querySelector('[data-results]');
    const paginationNode = document.querySelector('[data-pagination]');
    const PAGE_SIZE = 48;

    searchInput.value = state.q;
    typeSelect.value = state.type;
    generationSelect.value = state.generation;

    function escapeHtml(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    function matches(species) {
      if (state.q && !species.display.toLowerCase().includes(state.q.toLowerCase())) return false;
      if (state.type && !species.types.some((type) => type.name === state.type)) return false;
      if (state.generation && species.generation !== state.generation) return false;
      return true;
    }

    function queryForPage(page) {
      const params = new URLSearchParams();
      if (state.q) params.set('q', state.q);
      if (state.type) params.set('type', state.type);
      if (state.generation) params.set('generation', state.generation);
      if (page > 1) params.set('page', String(page));
      const search = params.toString();
      return search ? `/?${search}` : '/';
    }

    function updateUrl() {
      const url = new URL(window.location.href);
      const params = new URLSearchParams();
      if (state.q) params.set('q', state.q);
      if (state.type) params.set('type', state.type);
      if (state.generation) params.set('generation', state.generation);
      if (state.page > 1) params.set('page', String(state.page));
      url.search = params.toString();
      history.replaceState(null, '', url);
    }

    function cardHtml(species) {
      const badges = species.types.length
        ? `<span class="badges">${species.types
            .map((type) => `<span class="badge type-${escapeHtml(type.name)}">${escapeHtml(type.display)}</span>`)
            .join('')}</span>`
        : '';
      return `<li class="card"><a href="/pokemon/${encodeURIComponent(species.name)}"><img src="${escapeHtml(species.sprite)}" alt="" width="96" height="96" loading="lazy" onerror="this.style.visibility='hidden'"><span class="card-dex">#${String(species.id).padStart(4, '0')}</span><span class="card-name">${escapeHtml(species.display)}</span>${badges}</a></li>`;
    }

    function render() {
      const matching = allSpecies.filter(matches);
      const totalPages = Math.max(1, Math.ceil(matching.length / PAGE_SIZE));
      if (state.page > totalPages) state.page = totalPages;
      if (state.page < 1) state.page = 1;
      const visible = matching.slice((state.page - 1) * PAGE_SIZE, state.page * PAGE_SIZE);

      countNode.textContent = `${matching.length} Pokémon`;

      if (matching.length === 0) {
        resultsNode.innerHTML = '<p class="no-results" data-no-results>No Pokémon found</p>';
        paginationNode.hidden = true;
        return;
      }

      resultsNode.innerHTML = `<ul class="card-grid" data-card-grid>${visible.map(cardHtml).join('')}</ul>`;
      paginationNode.hidden = false;
      paginationNode.innerHTML = `<span data-page-label>Page ${state.page} of ${totalPages}</span>${
        state.page > 1 ? `<a href="${queryForPage(state.page - 1)}" data-prev>Previous page</a>` : ''
      }${state.page < totalPages ? `<a href="${queryForPage(state.page + 1)}" data-next>Next page</a>` : ''}`;
    }

    function applyFilterChange() {
      state.page = 1;
      render();
      updateUrl();
    }

    searchInput.addEventListener('input', () => {
      state.q = searchInput.value.trim();
      applyFilterChange();
    });

    typeSelect.addEventListener('change', () => {
      state.type = typeSelect.value;
      applyFilterChange();
    });

    generationSelect.addEventListener('change', () => {
      state.generation = generationSelect.value;
      applyFilterChange();
    });

    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      state.q = (params.get('q') || '').trim();
      state.type = params.get('type') || '';
      state.generation = params.get('generation') || '';
      state.page = Number.parseInt(params.get('page') || '1', 10) || 1;
      if (!types.some((type) => type.name === state.type)) state.type = '';
      if (!generations.some((generation) => generation.name === state.generation)) state.generation = '';
      searchInput.value = state.q;
      typeSelect.value = state.type;
      generationSelect.value = state.generation;
      render();
    });

    // Keep the initial server-rendered page in place; the client only re-renders on changes.
  </script>
</Layout>
