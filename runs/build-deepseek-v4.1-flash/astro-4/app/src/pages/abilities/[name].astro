---
import Layout from '../../layouts/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import PokemonCard from '../../components/PokemonCard.astro';
import { getAbilityPageData } from '../../lib/api';

let data: Awaited<ReturnType<typeof getAbilityPageData>> | null = null;
try {
  data = await getAbilityPageData(Astro.params.name ?? '');
} catch (error: any) {
  if (error?.status === 404) Astro.response.status = 404;
  else throw error;
}

const title = data ? `${data.name} – Pokédex` : 'Not found – Pokédex';
---

<Layout title={title}>
  {data ? (
    <>
      <h1>{data.name}</h1>

      <section class="panel" aria-labelledby="effect-heading">
        <h2 id="effect-heading">Effect</h2>
        <p>{data.effect}</p>
      </section>

      <section class="panel" aria-labelledby="pokemon-heading">
        <h2 id="pokemon-heading">Pokémon</h2>
        <p class="count-text">{data.pokemon.length} Pokémon</p>
        <ul class="card-grid">
          {data.pokemon.map((card) => <PokemonCard card={card} />)}
        </ul>
      </section>
    </>
  ) : (
    <NotFound />
  )}
</Layout>
