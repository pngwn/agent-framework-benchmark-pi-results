---
import type { SpeciesCard } from '../lib/api';

interface Props {
  card: SpeciesCard;
  showTypes?: boolean;
}

const { card, showTypes = false } = Astro.props;
const dex = `#${String(card.id).padStart(4, '0')}`;
---

<li class="card">
  <a href={`/pokemon/${card.name}`}>
    <img
      src={card.sprite}
      alt=""
      width="96"
      height="96"
      loading="lazy"
      onerror="this.style.visibility='hidden'"
    />
    <span class="card-dex">{dex}</span>
    <span class="card-name">{card.display}</span>
    {showTypes && card.types.length > 0 && (
      <span class="badges">
        {card.types.map((type) => (
          <span class={`badge type-${type.name}`}>{type.display}</span>
        ))}
      </span>
    )}
  </a>
  {card.hidden && <span class="hidden-ability">Hidden ability</span>}
</li>
