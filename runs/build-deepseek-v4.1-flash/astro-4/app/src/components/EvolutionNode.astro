---
import EvolutionNode from './EvolutionNode.astro';

interface Props {
  node: {
    name: string;
    display: string;
    children: any[];
  };
}

const { node } = Astro.props;
---

<li>
  <a href={`/pokemon/${node.name}`}>{node.display}</a>
  {node.children.length > 0 && (
    <ul>
      {node.children.map((child) => <EvolutionNode node={child} />)}
    </ul>
  )}
</li>
