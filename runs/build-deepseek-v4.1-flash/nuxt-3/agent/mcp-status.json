{
  "servers": [
    {
      "name": "nuxt",
      "scope": "global",
      "source": "/home/agent/.pi/agent/mcp.json",
      "enabled": true,
      "exposure": "direct",
      "transport": "https://nuxt.com/mcp",
      "state": "connected",
      "tools": [
        "get-blog-post",
        "list-blog-posts",
        "get-changelog",
        "get-deploy-provider",
        "list-deploy-providers",
        "get-documentation-page",
        "get-getting-started-guide",
        "list-documentation-pages",
        "get-module",
        "list-modules",
        "get-nuxter",
        "list-nuxters"
      ],
      "resources": true
    }
  ],
  "errors": []
}
