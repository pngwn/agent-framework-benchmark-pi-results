{
  "servers": [
    {
      "name": "angular-cli",
      "scope": "global",
      "source": "/home/agent/.pi/agent/mcp.json",
      "enabled": true,
      "exposure": "direct",
      "transport": "npx -y @angular/cli@22.2.5 mcp",
      "state": "connected",
      "tools": [
        "ai_tutor",
        "get_best_practices",
        "search_documentation",
        "list_projects",
        "onpush_zoneless_migration",
        "run_target",
        "devserver_start",
        "devserver_stop",
        "devserver_wait_for_build"
      ],
      "resources": true
    }
  ],
  "errors": []
}
