+function attackTypes(types: ApiType[]): AttackType[] {
+  return types.map((type) => ({
+    name: type.name,
+    label: englishName(type.names, type.name),
+    doubleDamageTo: (type.damage_relations['double_damage_to'] ?? []).map((r) => r.name),
+    halfDamageTo: (type.damage_relations['half_damage_to'] ?? []).map((r) => r.name),
+    noDamageTo: (type.damage_relations['no_damage_to'] ?? []).map((r) => r.name),
+  }));
+}
+
+/** Builds the team page from the browser's team, at request time. */
+export async function loadTeam(requested: readonly string[]): Promise<TeamVM> {
+  const names = normalizeTeam(requested).slice(0, MAX_TEAM_SIZE);
+  const [types, members] = await Promise.all([
+    allTypes(),
+    Promise.all(
+      names.map(async (name) => {
+        const species = await apiFind<ApiSpecies>(`pokemon-species/${encodeURIComponent(name.toLowerCase())}`);
+        if (!species) return null;
+        const pokemon = await apiFind<ApiPokemon>(`pokemon/${species.id}`);
+        if (!pokemon) return null;
+        return {
+          id: species.id,
+          name: species.name,
+          typeNames: [...pokemon.types]
+            .sort((a, b) => a.slot - b.slot)
+            .map((t) => t.type.name),
+        };
+      }),
+    ),
+  ]);
+
+  const labels = new Map(types.map((t) => [t.name, englishName(t.names, t.name)]));
+  const team = members
+    .filter((member): member is NonNullable<typeof member> => member !== null)
+    .map<TeamMember>((member) => ({
+      id: member.id,
+      name: member.name,
+      types: member.typeNames.map((name) => typeRef(name, labels)),
+    }));
+  const attacks = attackTypes(types);
+
+  return { members: team, attackTypes: attacks, coverage: coverageRows(attacks, team) };
+}
