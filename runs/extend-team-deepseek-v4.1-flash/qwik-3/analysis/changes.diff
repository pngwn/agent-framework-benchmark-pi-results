+// ---------------------------------------------------------------------------
+// Team
+
+export interface TeamCard extends Card {
+  types: TypeRef[];
+}
+
+async function attackTypes(): Promise<AttackType[]> {
+  const types = await mainTypes();
+  const names = (list: { name: string }[] | undefined) => (list ?? []).map((t) => t.name);
+  return types.map((t) => ({
+    name: t.name,
+    label: t.label,
+    double: names(t.record.damage_relations?.double_damage_to),
+    half: names(t.record.damage_relations?.half_damage_to),
+    none: names(t.record.damage_relations?.no_damage_to),
+  }));
+}
+
+/** Team members in the order they were added, with live species and type data. */
+export async function teamPage(names: string[]) {
+  if (names.length === 0) return { cards: [] as TeamCard[], attacks: [] as AttackType[] };
+
+  const [attacks, cards] = await Promise.all([
+    attackTypes(),
+    Promise.all(
+      names.map(async (name): Promise<TeamCard | null> => {
+        if (!isValidName(name)) return null;
+        const species = await find(`pokemon-species/${name}`);
+        if (!species) return null;
+        const variety = species.varieties?.find((v: any) => v.is_default) ?? species.varieties?.[0];
+        const pokemon = await get(variety ? variety.pokemon.url : `pokemon/${species.id}`);
+        const types = await Promise.all(
+          (pokemon.types ?? [])
+            .slice()
+            .sort((a: any, b: any) => a.slot - b.slot)
+            .map((t: any) => typeRef(t.type.name)),
+        );
+        return {
+          id: species.id as number,
+          name: species.name as string,
+          label: humanize(species.name),
+          sprite: spriteUrl(species.id),
+          types,
+        };
+      }),
+    ),
+  ]);
+
+  return {
+    cards: cards.filter((card): card is TeamCard => card !== null),
+    attacks,
+  };
+}
