+/** The attacking type's multiplier against a defending type. */
+function attackMultiplier(attacker: ApiType, defender: string): number {
+  const relations = attacker.damage_relations;
+  if ((relations['double_damage_to'] ?? []).some((r) => r.name === defender)) return 2;
+  if ((relations['half_damage_to'] ?? []).some((r) => r.name === defender)) return 0.5;
+  if ((relations['no_damage_to'] ?? []).some((r) => r.name === defender)) return 0;
+  return 1;
+}
+
+/**
+ * The team view model for a list of species names, in the order they were added. The
+ * species' default Pokémon supplies the types used on the cards and for type coverage.
+ */
+export async function loadTeam(names: string[]): Promise<TeamVM> {
+  const [types, species] = await Promise.all([allTypes(), speciesNames()]);
+  const labels = new Map(types.map((t) => [t.name, englishName(t.names, t.name)]));
+  const idByName = new Map([...species].map(([id, name]) => [name, id] as const));
+
+  const wanted = [...new Set(names)].slice(0, 6);
+  const loaded = await Promise.all(
+    wanted.map(async (name): Promise<TeamMember | null> => {
+      const id = idByName.get(name);
+      if (id === undefined) return null;
+      const pokemon = await apiGet<ApiPokemon>(`pokemon/${id}`);
+      return {
+        id,
+        name,
+        types: [...pokemon.types].sort((a, b) => a.slot - b.slot).map((t) => typeRef(t.type.name, labels)),
+      };
+    }),
+  );
+  const members = loaded.filter((member): member is TeamMember => member !== null);
+
+  const coverage: CoverageRow[] = types.map((type) => {
+    let weak = 0;
+    let resistant = 0;
+    for (const member of members) {
+      const multiplier = member.types.reduce(
+        (product, memberType) => product * attackMultiplier(type, memberType.name),
+        1,
+      );
+      if (multiplier > 1) weak++;
+      else if (multiplier < 1) resistant++;
+    }
+    return { name: type.name, label: englishName(type.names, type.name), weak, resistant };
+  });
+
+  return { members, coverage };
+}
+
