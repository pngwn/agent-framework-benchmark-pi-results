 const METHOD_ORDER = ["level-up", "machine", "egg", "tutor"];
 
+export async function teamDetails(names: string[]): Promise<TeamResult> {
+  const team = [...new Set(names.filter((name) => /^[a-z0-9][a-z0-9-]*$/.test(name)))].slice(0, 6);
+  const types = await allTypes();
+  const labels = new Map(types.map((t) => [t.name, englishName(t)]));
+
+  const members = (
+    await mapLimit(team, 6, async (name) => {
+      const found = await speciesAndPokemon(name);
+      if (!found) return null;
+      const { species, pokemon } = found;
+      const speciesTypes = [...pokemon.types]
+        .sort((a: any, b: any) => a.slot - b.slot)
+        .map((t: any) => t.type.name as string);
+      return {
+        card: {
+          id: species.id,
+          name: species.name,
+          label: humanize(species.name),
+          sprite: `${apiBase()}/media/sprites/pokemon/${species.id}.png`,
+          types: speciesTypes.map((type) => typeNamed(labels, type)),
+        },
+        types: speciesTypes,
+      };
+    })
+  ).filter((member): member is NonNullable<typeof member> => member !== null);
+
+  const coverage = types.map((type) => {
+    const relations = type.damage_relations ?? {};
+    const double = new Set<string>((relations.double_damage_to ?? []).map((t: { name: string }) => t.name));
+    const half = new Set<string>((relations.half_damage_to ?? []).map((t: { name: string }) => t.name));
+    const none = new Set<string>((relations.no_damage_to ?? []).map((t: { name: string }) => t.name));
+
+    let weak = 0;
+    let resistant = 0;
+    for (const member of members) {
+      const multiplier = member.types.reduce((product, memberType) => {
+        if (double.has(memberType)) return product * 2;
+        if (half.has(memberType)) return product * 0.5;
+        if (none.has(memberType)) return product * 0;
+        return product;
+      }, 1);
+      if (multiplier > 1) weak++;
+      else if (multiplier < 1) resistant++;
+    }
+
+    return { type: typeNamed(labels, type.name), weak, resistant };
+  });
+
+  return { members: members.map((member) => member.card), coverage };
+}
