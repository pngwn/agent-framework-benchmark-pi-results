 // Server-only access to the PokeAPI server. Every response is fetched at request time
 // and kept in a short-lived in-memory cache (with in-flight de-duplication).
+import { getCookie } from "@solidjs/start/http";
 import { humanize } from "../format";
+import { parseTeamCookie, TEAM_COOKIE } from "../team-store";
 import type {
   AbilityDetail,
   Card,
@@ -12,6 +14,7 @@ import type {
   MoveTableData,
   Named,
   PokemonDetail,
+  TeamDetail,
   TypeDetail,
 } from "../types";
 
@@ -380,3 +383,54 @@ export async function typeDetail(name: string): Promise<TypeDetail | null> {
       .sort((a: Named, b: Named) => a.label.localeCompare(b.label)),
   };
 }
+
+// ---------------------------------------------------------------------------
+// Team
+
+/** Species names stored in the browser's team cookie. */
+export function teamNames(): string[] {
+  return parseTeamCookie(getCookie(TEAM_COOKIE));
+}
+
+const typeMultiplier = (attacking: any, defendingName: string): number => {
+  const relations = attacking.damage_relations ?? {};
+  if ((relations.no_damage_to ?? []).some((t: { name: string }) => t.name === defendingName)) return 0;
+  if ((relations.double_damage_to ?? []).some((t: { name: string }) => t.name === defendingName)) return 2;
+  if ((relations.half_damage_to ?? []).some((t: { name: string }) => t.name === defendingName)) return 0.5;
+  return 1;
+};
+
+export async function teamDetail(names: string[]): Promise<TeamDetail> {
+  const [types, species] = await Promise.all([allTypes(), speciesNames()]);
+  const labels = new Map(types.map((t) => [t.name, englishName(t)]));
+
+  const members = (
+    await mapLimit(names, 6, async (name) => {
+      const found = await speciesAndPokemon(name);
+      if (!found) return null;
+      const { species: record, pokemon } = found;
+      return {
+        ...card(record.id, species, record.name),
+        types: [...pokemon.types]
+          .sort((a: any, b: any) => a.slot - b.slot)
+          .map((t: any) => typeNamed(labels, t.type.name)),
+      } satisfies Card;
+    })
+  ).filter((member): member is Card => member !== null);
+
+  const coverage = types.map((attacking) => {
+    let weak = 0;
+    let resistant = 0;
+    for (const member of members) {
+      const multiplier = (member.types ?? []).reduce(
+        (product, defending) => product * typeMultiplier(attacking, defending.name),
+        1,
+      );
+      if (multiplier > 1) weak++;
+      else if (multiplier < 1) resistant++;
+    }
+    return { type: typeNamed(labels, attacking.name), weak, resistant };
+  });
+
+  return { members, coverage };
+}
