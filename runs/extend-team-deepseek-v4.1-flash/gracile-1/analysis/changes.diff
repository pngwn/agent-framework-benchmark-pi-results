+/** Turns the ordered species names stored in the team cookie into cards. */
+export async function getTeamCards(names: string[]): Promise<Card[]> {
+	const typeLabels = await getTypeLabels();
+	const cards = await Promise.all(
+		names.map(async (name): Promise<Card | null> => {
+			const species = await getSpecies(name);
+			if (!species || species.name !== name) return null;
+			const pokemon = await getDefaultPokemon(species);
+			return {
+				id: species.id,
+				name: species.name,
+				label: humanize(species.name),
+				types: [...pokemon.types]
+					.sort((a, b) => a.slot - b.slot)
+					.map((t) => ({
+						name: t.type.name,
+						label: typeLabels.get(t.type.name) ?? humanize(t.type.name),
+					})),
+			};
+		}),
+	);
+	return cards.filter((card): card is Card => card !== null);
+}
+
+export type CoverageRow = {
+	name: string;
+	label: string;
+	weak: number;
+	resistant: number;
+};
+
+/**
+ * Counts, for each of the 18 attacking types, how many team members are weak
+ * to or resist it. Damage is the product of the multipliers against each of a
+ * member's types, so a double weakness and a resistance can cancel out.
+ */
+export async function getTypeCoverage(cards: Card[]): Promise<CoverageRow[]> {
+	const types = await getTypes();
+	const relations = (type: ApiType) => type.damage_relations;
+	const includes = (refs: Ref[], name: string) =>
+		refs.some((ref) => ref.name === name);
+
+	return types.map((attack) => {
+		let weak = 0;
+		let resistant = 0;
+		for (const card of cards) {
+			let multiplier = 1;
+			for (const defender of card.types ?? []) {
+				const rel = relations(attack.record);
+				if (includes(rel.double_damage_to, defender.name)) multiplier *= 2;
+				else if (includes(rel.half_damage_to, defender.name)) multiplier *= 0.5;
+				else if (includes(rel.no_damage_to, defender.name)) multiplier *= 0;
+			}
+			if (multiplier > 1) weak++;
+			else if (multiplier < 1) resistant++;
+		}
+		return {
+			name: attack.name,
+			label: attack.label,
+			weak,
+			resistant,
+		};
+	});
+}
+
