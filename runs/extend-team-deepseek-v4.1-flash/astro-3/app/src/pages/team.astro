---
import Base from '../layouts/Base.astro';
import CardList from '../components/CardList.astro';
import Section from '../components/Section.astro';
import { getHomeEntries, getTypes } from '../lib/pokedex';
import { MAX_TEAM, readTeam, removeFromTeam } from '../lib/team';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'remove') removeFromTeam(Astro.cookies, String(form.get('species') ?? ''));
  return Astro.redirect('/team', 303);
}

const team = readTeam(Astro.cookies);
const [entries, types] = await Promise.all([getHomeEntries(), getTypes()]);
const entriesByName = new Map(entries.map((entry) => [entry.name, entry]));
const members = team.map((name) => entriesByName.get(name)).filter((entry) => entry !== undefined);
const cards = members.map(({ id, name, types: memberTypes }) => ({ id, name, types: memberTypes }));

type DamageRelations = {
  double_damage_to: { name: string }[];
  half_damage_to: { name: string }[];
  no_damage_to: { name: string }[];
};

const multiplier = (relations: DamageRelations, defender: string) => {
  if (relations.no_damage_to.some((type) => type.name === defender)) return 0;
  if (relations.double_damage_to.some((type) => type.name === defender)) return 2;
  if (relations.half_damage_to.some((type) => type.name === defender)) return 0.5;
  return 1;
};

// One row per attacking type, in API order.
const coverage = types.map((attacking) => {
  let weak = 0;
  let resistant = 0;
  for (const member of members) {
    const damage = member.types.reduce(
      (product, defender) => product * multiplier(attacking.record.damage_relations as DamageRelations, defender.name),
      1,
    );
    if (damage > 1) weak++;
    else if (damage < 1) resistant++;
  }
  return { label: attacking.label, weak, resistant };
});
---

<Base title="Team">
  <h1>Team</h1>
  <p class="count">{team.length} of {MAX_TEAM}</p>

  {
    team.length === 0 ? (
      <div class="empty-team">
        <p>Your team is empty</p>
        <a href="/">Browse Pokémon</a>
      </div>
    ) : (
      <>
        <CardList cards={cards} removable />
        <Section title="Type coverage">
          <div class="table-scroll">
            <table class="coverage-table">
              <thead>
                <tr>
                  <th scope="col">Type</th>
                  <th scope="col">Weak</th>
                  <th scope="col">Resistant</th>
                </tr>
              </thead>
              <tbody>
                {coverage.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>{row.weak}</td>
                    <td>{row.resistant}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Section>
      </>
    )
  }
</Base>
