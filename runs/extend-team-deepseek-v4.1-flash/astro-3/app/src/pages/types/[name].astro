---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import Section from '../../components/Section.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import CardList from '../../components/CardList.astro';
import { api } from '../../lib/api';
import { cardsForPokemon, englishName, getTypeLabels, humanize } from '../../lib/pokedex';

const name = (Astro.params.name ?? '').toLowerCase();
const type = await api(`type/${encodeURIComponent(name)}`);
if (!type) Astro.response.status = 404;

const [typeLabel, cards] = type
  ? await Promise.all([getTypeLabels(), cardsForPokemon(type.pokemon ?? [])])
  : [null, []];

const RELATIONS: [string, string][] = [
  ['Super effective against', 'double_damage_to'],
  ['Not very effective against', 'half_damage_to'],
  ['No effect against', 'no_damage_to'],
  ['Weak to', 'double_damage_from'],
  ['Resists', 'half_damage_from'],
  ['Immune to', 'no_damage_from'],
];
const relations = type
  ? RELATIONS.map(([label, key]) => ({
      label,
      types: (type.damage_relations?.[key] ?? []) as { name: string }[],
    }))
  : [];
const moves = type
  ? (type.moves ?? [])
      .map((m: { name: string }) => ({ name: m.name, label: humanize(m.name) }))
      .sort((a: { label: string }, b: { label: string }) => a.label.localeCompare(b.label))
  : [];
---

{
  !type ? (
    <NotFound />
  ) : (
    <Base title={englishName(type)}>
      <h1>{englishName(type)}</h1>

      <Section title="Damage relations">
        <dl class="relations">
          {relations.map((r) => (
            <div>
              <dt>{r.label}</dt>
              <dd>
                {r.types.length
                  ? r.types.map((t) => <TypeBadge name={t.name} label={typeLabel!(t.name)} />)
                  : 'None'}
              </dd>
            </div>
          ))}
        </dl>
      </Section>

      <Section title="Pokémon">
        <p class="count">{cards.length} Pokémon</p>
        <CardList cards={cards} />
      </Section>

      <Section title="Moves">
        <p class="count">{moves.length} moves</p>
        <ul class="move-columns">
          {moves.map((m: { name: string; label: string }) => (
            <li>
              <a href={`/moves/${m.name}`}>{m.label}</a>
            </li>
          ))}
        </ul>
      </Section>
    </Base>
  )
}
