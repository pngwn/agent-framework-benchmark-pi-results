---
import Base from '../../layouts/Base.astro';
import { getTypes } from '../../lib/pokedex';

const types = await getTypes();
---

<Base title="Types">
  <h1>Types</h1>
  <ul class="type-grid">
    {
      types.map((t) => (
        <li>
          <a class="type-tile" href={`/types/${t.name}`} style={`--badge-bg: var(--type-${t.name})`}>
            {t.label}
          </a>
        </li>
      ))
    }
  </ul>
</Base>
