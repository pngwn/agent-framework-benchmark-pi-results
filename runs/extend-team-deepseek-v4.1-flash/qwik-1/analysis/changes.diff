+// ---------------------------------------------------------------------------
+// Team
+
+export interface TeamEntry {
+  name: string;
+  card: Card;
+  /** Damage multiplier from each attacking type, keyed by type API name. */
+  damage: Record<string, number>;
+}
+
+export interface TeamPageData {
+  names: string[];
+  entries: TeamEntry[];
+  types: CoverageType[];
+  coverage: CoverageRow[];
+}
+
+async function defaultPokemon(species: any) {
+  const variety = species.varieties?.find((v: any) => v.is_default) ?? species.varieties?.[0];
+  return variety ? get(variety.pokemon.url) : get(`pokemon/${species.id}`);
+}
+
+/** Team members and type coverage, with all Pokémon data fetched at request time. */
+export async function teamPage(names: string[]): Promise<TeamPageData> {
+  const types = await mainTypes();
+  const coverageTypes: CoverageType[] = types.map((t) => ({ name: t.name, label: t.label }));
+
+  // For each attacking type, the multiplier applied to a defending type.
+  const multipliers = new Map<string, Map<string, number>>();
+  for (const type of types) {
+    const map = new Map<string, number>();
+    const relations = type.record.damage_relations ?? {};
+    for (const r of relations.double_damage_to ?? []) map.set(r.name, 2);
+    for (const r of relations.half_damage_to ?? []) map.set(r.name, 0.5);
+    for (const r of relations.no_damage_to ?? []) map.set(r.name, 0);
+    multipliers.set(type.name, map);
+  }
+
+  const entries = (
+    await Promise.all(
+      names.map(async (name): Promise<TeamEntry | null> => {
+        if (!isValidName(name)) return null;
+        const species = await find(`pokemon-species/${name.toLowerCase()}`);
+        if (!species) return null;
+        const pokemon = await defaultPokemon(species);
+        const memberTypes: TypeRef[] = await Promise.all(
+          [...pokemon.types]
+            .sort((a: any, b: any) => a.slot - b.slot)
+            .map((t: any) => typeRef(t.type.name)),
+        );
+
+        const damage: Record<string, number> = {};
+        for (const type of types) {
+          const relations = multipliers.get(type.name)!;
+          let multiplier = 1;
+          for (const memberType of memberTypes) multiplier *= relations.get(memberType.name) ?? 1;
+          damage[type.name] = multiplier;
+        }
+
+        return {
+          name: species.name as string,
+          card: {
+            id: species.id as number,
+            name: species.name as string,
+            label: humanize(species.name),
+            sprite: (pokemon.sprites?.front_default as string | null) ?? spriteUrl(species.id),
+            types: memberTypes,
+          },
+          damage,
+        };
+      }),
+    )
+  ).filter((entry): entry is TeamEntry => entry !== null);
+
+  return {
+    names: entries.map((entry) => entry.name),
+    entries,
+    types: coverageTypes,
+    coverage: typeCoverage(entries, coverageTypes),
+  };
+}
