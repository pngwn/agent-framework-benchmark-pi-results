diff --git a/app/app/pages/team.vue b/app/app/pages/team.vue
new file mode 100644
index 0000000..765489f
--- /dev/null
+++ b/app/app/pages/team.vue
@@ -0,0 +1,69 @@
+<script setup lang="ts">
+interface TeamData {
+  members: {
+    id: number;
+    name: string;
+    sprite: string;
+    types: { name: string; label: string }[];
+  }[];
+  coverage: { name: string; label: string; weak: number; resistant: number }[];
+}
+
+const { members, remove } = useTeam();
+const names = computed(() => members.value.join(','));
+const memberNames = computed(() => new Set(members.value));
+
+const { data } = await useAsyncData<TeamData>(
+  'team',
+  () => $fetch('/api/team', { query: { names: names.value } }),
+  { watch: [names] },
+);
+
+const shownMembers = computed(() =>
+  (data.value?.members ?? []).filter((member) => memberNames.value.has(member.name)),
+);
+
+usePageTitle('Team');
+</script>
+
+<template>
+  <h1>Team</h1>
+  <p class="count">{{ members.length }} of 6</p>
+
+  <template v-if="members.length">
+    <ul class="card-grid team-grid">
+      <li v-for="member in shownMembers" :key="member.id" class="team-card">
+        <PokemonCard v-bind="member" />
+        <button type="button" class="team-card__remove" @click="remove(member.name)">
+          Remove {{ humanize(member.name) }}
+        </button>
+      </li>
+    </ul>
+
+    <PageSection title="Type coverage">
+      <div class="table-scroll">
+        <table class="coverage-table">
+          <thead>
+            <tr>
+              <th scope="col">Type</th>
+              <th scope="col">Weak</th>
+              <th scope="col">Resistant</th>
+            </tr>
+          </thead>
+          <tbody>
+            <tr v-for="row in data?.coverage ?? []" :key="row.name">
+              <th scope="row">{{ row.label }}</th>
+              <td>{{ row.weak }}</td>
+              <td>{{ row.resistant }}</td>
+            </tr>
+          </tbody>
+        </table>
+      </div>
+    </PageSection>
+  </template>
+
+  <template v-else>
+    <p>Your team is empty</p>
+    <p><NuxtLink to="/">Browse Pokémon</NuxtLink></p>
+  </template>
+</template>
diff --git a/app/server/api/team.get.ts b/app/server/api/team.get.ts
new file mode 100644
index 0000000..7ea2dbc
--- /dev/null
+++ b/app/server/api/team.get.ts
@@ -0,0 +1,78 @@
+interface TeamMember {
+  id: number;
+  name: string;
+  sprite: string;
+  types: { name: string; label: string }[];
+}
+
+function damageMultiplier(attacking: any, defending: string): number {
+  if (attacking.damage_relations.double_damage_to.some((t: any) => t.name === defending)) return 2;
+  if (attacking.damage_relations.half_damage_to.some((t: any) => t.name === defending)) return 0.5;
+  if (attacking.damage_relations.no_damage_to.some((t: any) => t.name === defending)) return 0;
+  return 1;
+}
+
+export default defineEventHandler((event) =>
+  withNotFound(async () => {
+    const query = getQuery(event);
+    const requested = String(query.names ?? '')
+      .split(',')
+      .map((name) => name.trim().toLowerCase())
+      .filter(Boolean);
+    const names = [...new Set(requested)].slice(0, 6);
+
+    const [typeRecords, labels, speciesRecords] = await Promise.all([
+      allTypes(),
+      typeLabels(),
+      Promise.all(
+        names.map(async (name) => {
+          try {
+            return await api(`pokemon-species/${encodeURIComponent(name)}`);
+          } catch (err) {
+            if (err instanceof NotFound) return null;
+            throw err;
+          }
+        }),
+      ),
+    ]);
+
+    const members = (
+      await Promise.all(
+        speciesRecords.map(async (species): Promise<TeamMember | null> => {
+          if (!species) return null;
+          const variety = species.varieties.find((v: any) => v.is_default) ?? species.varieties[0];
+          if (!variety) return null;
+          const pokemon = await api(variety.pokemon.url);
+          return {
+            id: species.id,
+            name: species.name,
+            sprite: spriteUrl(species.id),
+            types: pokemon.types
+              .slice()
+              .sort((a: any, b: any) => a.slot - b.slot)
+              .map((t: any) => ({
+                name: t.type.name,
+                label: labels[t.type.name] ?? humanize(t.type.name),
+              })),
+          };
+        }),
+      )
+    ).filter((member): member is TeamMember => member !== null);
+
+    const coverage = typeRecords.map((type) => {
+      let weak = 0;
+      let resistant = 0;
+      for (const member of members) {
+        const multiplier = member.types.reduce(
+          (product, t) => product * damageMultiplier(type, t.name),
+          1,
+        );
+        if (multiplier > 1) weak++;
+        else if (multiplier < 1) resistant++;
+      }
+      return { name: type.name, label: englishName(type), weak, resistant };
+    });
+
+    return { members, coverage };
+  }),
+);
