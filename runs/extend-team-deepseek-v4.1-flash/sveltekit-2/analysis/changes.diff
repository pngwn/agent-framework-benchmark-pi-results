+// --- Team page ----------------------------------------------------------------------------
+
+export type TeamMember = {
+	id: number;
+	name: string;
+	label: string;
+	sprite: string;
+	types: TypeRef[];
+	typeNames: string[];
+};
+
+export type CoverageRow = { name: string; label: string; weak: number; resistant: number };
+
+export async function getTeamPage(names: string[]) {
+	const types = await getTypes();
+	const labels = new Map(types.map((t) => [t.name, englishName(t)]));
+
+	const members = (
+		await mapLimit(names, 6, async (name): Promise<TeamMember | null> => {
+			const species = await get<ApiSpecies>(`pokemon-species/${encodeURIComponent(name.toLowerCase())}/`);
+			if (!species) return null;
+
+			const variety = species.varieties.find((v) => v.is_default)?.pokemon;
+			const pokemon = await getOrThrow<ApiPokemon>(variety ? variety.url : `pokemon/${species.id}/`);
+			const typeNames = [...pokemon.types].sort((a, b) => a.slot - b.slot).map((t) => t.type.name);
+
+			return {
+				id: species.id,
+				name: species.name,
+				label: englishName(species),
+				sprite: spriteUrl(species.id),
+				types: typeNames.map((typeName) => typeRef(labels, typeName)),
+				typeNames
+			};
+		})
+	).filter((member): member is TeamMember => member !== null);
+
+	const coverage: CoverageRow[] = types.map((type) => {
+		const relations = type.damage_relations;
+		const names = (key: string) => new Set((relations[key] ?? []).map((ref) => ref.name));
+		const doubleTo = names('double_damage_to');
+		const halfTo = names('half_damage_to');
+		const noneTo = names('no_damage_to');
+
+		let weak = 0;
+		let resistant = 0;
+		for (const member of members) {
+			let multiplier = 1;
+			for (const defender of member.typeNames) {
+				if (noneTo.has(defender)) multiplier = 0;
+				else if (doubleTo.has(defender)) multiplier *= 2;
+				else if (halfTo.has(defender)) multiplier *= 0.5;
+			}
+			if (multiplier > 1) weak++;
+			else if (multiplier < 1) resistant++;
+		}
+
+		return { name: type.name, label: englishName(type), weak, resistant };
+	});
+
+	return { members, coverage };
+}
