+			name: member.name,
+			sprite: spriteUrl(member.id),
+			types: (slots.get(member.id) ?? []).map((entry) => entry.type)
+		});
+	}
+
+	// Treat each type as the attacking type and multiply its effectiveness against every
+	// type of every member's default Pokémon.
+	const coverage: CoverageRow[] = types.map((attacking) => {
+		const double = new Set(attacking.damage_relations.double_damage_to?.map((type) => type.name) ?? []);
+		const half = new Set(attacking.damage_relations.half_damage_to?.map((type) => type.name) ?? []);
