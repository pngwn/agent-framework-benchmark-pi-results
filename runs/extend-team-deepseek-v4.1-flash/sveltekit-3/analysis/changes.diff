+	let { data }: PageProps = $props();
+
+	const members = $derived(data.members);
+	const count = $derived(members.length);
+	let removing = $state<string | null>(null);
+
+	async function remove(name: string) {
+		if (removing) return;
+		removing = name;
+		try {
+			removeTeamMember(data.team, name);
+			await invalidateAll();
+		} finally {
+			removing = null;
