+
+		let weak = 0;
+		let resistant = 0;
+		for (const member of members) {
+			let multiplier = 1;
+			for (const type of member.types ?? []) {
+				if (none.has(type.name)) {
+					multiplier = 0;
+					break;
+				}
+				if (half.has(type.name)) multiplier *= 0.5;
+				else if (double.has(type.name)) multiplier *= 2;
+			}
+			if (multiplier > 1) weak++;
+			else if (multiplier < 1) resistant++;
+		}
+
+		return { name: attacking.name, label: englishName(attacking), weak, resistant };
+	});
+
+	return { members, coverage };
