---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const docTitle = title ? `${title} – Pokédex` : 'Pokédex';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href="/">Pokédex</a>
        <nav aria-label="Main">
          <ul>
            <li><a href="/">Pokémon</a></li>
            <li><a href="/types">Types</a></li>
            <li><a href="/team">Team</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="container">Data from PokéAPI. Pokémon and Pokémon character names are trademarks of Nintendo.</p>
    </footer>

    <script>
      const TEAM_COOKIE = 'team';
      const MAX_TEAM_SIZE = 6;

      function readTeam(): string[] {
        const part = document.cookie
          .split('; ')
          .find((cookie) => cookie.startsWith(`${TEAM_COOKIE}=`));
        if (!part) return [];
        try {
          const parsed = JSON.parse(decodeURIComponent(part.slice(TEAM_COOKIE.length + 1)));
          return Array.isArray(parsed) ? parsed.filter((name): name is string => typeof name === 'string') : [];
        } catch {
          return [];
        }
      }

      function writeTeam(team: string[]) {
        document.cookie = `${TEAM_COOKIE}=${encodeURIComponent(JSON.stringify(team))}; Path=/; Max-Age=31536000; SameSite=Lax`;
      }

      document.addEventListener('click', (event) => {
        const button =
          event.target instanceof Element
            ? event.target.closest<HTMLButtonElement>('[data-team-add], [data-team-remove]')
            : null;
        if (!button || button.disabled) return;

        const name = button.dataset.teamAdd ?? button.dataset.teamRemove;
        if (!name) return;

        const team = readTeam();
        if (button.dataset.teamAdd) {
          if (team.includes(name) || team.length >= MAX_TEAM_SIZE) return;
          team.push(name);
        } else {
          if (!team.includes(name)) return;
          team.splice(team.indexOf(name), 1);
        }
        writeTeam(team);
        location.reload();
      });
    </script>
  </body>
</html>
