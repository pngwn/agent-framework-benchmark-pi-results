---
import { humanize } from '../lib/pokedex';

type Link = { species: { name: string }; evolves_to: Link[] };
interface Props {
  nodes: Link[];
  current: string;
}
const { nodes, current } = Astro.props;
---

<ul class="evolution">
  {
    nodes.map((node) => (
      <li>
        <a href={`/pokemon/${node.species.name}`} aria-current={node.species.name === current ? 'page' : undefined}>
          {humanize(node.species.name)}
        </a>
        {node.evolves_to.length > 0 && <Astro.self nodes={node.evolves_to} current={current} />}
      </li>
    ))
  }
</ul>
