---
interface Props {
  title: string;
  id?: string;
}
const { title, id } = Astro.props;
const slug = id ?? title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const headingId = `${slug}-heading`;
---

<section class="panel" id={id} aria-labelledby={headingId}>
  <h2 id={headingId}>{title}</h2>
  <slot />
</section>
