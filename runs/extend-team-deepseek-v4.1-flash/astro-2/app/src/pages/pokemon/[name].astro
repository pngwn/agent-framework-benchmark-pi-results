---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import Section from '../../components/Section.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import Evolution from '../../components/Evolution.astro';
import MovesSection from '../../components/MovesSection.astro';
import { MAX_TEAM_SIZE, getTeamFromCookies } from '../../lib/team';
import { api, apiPath } from '../../lib/api';
import {
  MAX_SPECIES_ID,
  dexNumber,
  englishName,
  getTypeLabels,
  humanize,
  latestEnglishFlavorText,
} from '../../lib/pokedex';

const name = (Astro.params.name ?? '').toLowerCase();
const species = await api(`pokemon-species/${encodeURIComponent(name)}`);
const variety = species?.varieties?.find((v: any) => v.is_default) ?? species?.varieties?.[0];
const [pokemon, chain, typeLabel] = species && species.id < MAX_SPECIES_ID
  ? await Promise.all([
      api(variety ? apiPath(variety.pokemon.url) : `pokemon/${species.id}`),
      species.evolution_chain ? api(apiPath(species.evolution_chain.url)) : null,
      getTypeLabels(),
    ])
  : [null, null, null];

if (!pokemon) Astro.response.status = 404;

const STAT_LABELS: Record<string, string> = {
  hp: 'HP',
  attack: 'Attack',
  defense: 'Defense',
  'special-attack': 'Sp. Atk',
  'special-defense': 'Sp. Def',
  speed: 'Speed',
};
const MAX_STAT = 255;

const title = species ? englishName(species) : '';
const genus = species?.genera?.find((g: any) => g.language.name === 'en')?.genus;
const flavor = species ? latestEnglishFlavorText(species.flavor_text_entries) : null;
const types = pokemon ? [...pokemon.types].sort((a: any, b: any) => a.slot - b.slot) : [];
const artwork: string | null =
  pokemon?.sprites?.other?.['official-artwork']?.front_default ?? pokemon?.sprites?.front_default ?? null;
const stats: { label: string; value: number }[] = (pokemon?.stats ?? []).map((s: any) => ({
  label: STAT_LABELS[s.stat.name] ?? humanize(s.stat.name),
  value: s.base_stat,
}));
const total = stats.reduce((sum, s) => sum + s.value, 0);
const abilities = pokemon ? [...pokemon.abilities].sort((a: any, b: any) => a.slot - b.slot) : [];
const pct = (value: number, max: number) => `${Math.min(100, (value / max) * 100).toFixed(1)}%`;
const team = getTeamFromCookies(Astro.cookies);
const onTeam = species ? team.includes(species.name) : false;
const teamFull = team.length >= MAX_TEAM_SIZE;
---

{
  !pokemon ? (
    <NotFound />
  ) : (
    <Base title={title}>
      <div class="pokemon-summary">
        <div class="artwork">
          {artwork ? (
            <img src={artwork} alt={title} width="288" height="288" />
          ) : (
            <span class="artwork-missing">—</span>
          )}
        </div>
        <div class="summary-info">
          <p class="dex-number">{dexNumber(species.id)}</p>
          <h1>{title}</h1>
          <p class="team-action">
            {onTeam ? (
              <button type="button" class="action-button" data-team-remove={species.name}>Remove from team</button>
            ) : (
              <>
                <button type="button" class="action-button" data-team-add={species.name} disabled={teamFull}>
                  Add to team
                </button>
                {teamFull && <span class="team-status">Team is full</span>}
              </>
            )}
          </p>
          {genus && <p class="genus">{genus}</p>}
          <p class="types">
            {types.map((t: any) => (
              <TypeBadge name={t.type.name} label={typeLabel!(t.type.name)} />
            ))}
          </p>
          <dl class="measurements">
            <div>
              <dt>Height</dt>
              <dd>{(pokemon.height / 10).toFixed(1)} m</dd>
            </div>
            <div>
              <dt>Weight</dt>
              <dd>{(pokemon.weight / 10).toFixed(1)} kg</dd>
            </div>
          </dl>
          {flavor && <p class="flavor">{flavor}</p>}
        </div>
      </div>

      <Section title="Base stats">
        <table class="stats">
          <tbody>
            {stats.map((s) => (
              <tr>
                <th scope="row">{s.label}</th>
                <td class="stat-value">{s.value}</td>
                <td class="stat-bar" aria-hidden="true">
                  <span class="bar">
                    <span style={`width: ${pct(s.value, MAX_STAT)}`} />
                  </span>
                </td>
              </tr>
            ))}
            <tr class="stat-total">
              <th scope="row">Total</th>
              <td class="stat-value">{total}</td>
              <td class="stat-bar" aria-hidden="true">
                <span class="bar">
                  <span style={`width: ${pct(total, MAX_STAT * Math.max(1, stats.length))}`} />
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </Section>

      <Section title="Abilities">
        <ul class="plain-list">
          {abilities.map((a: any) => (
            <li>
              <a href={`/abilities/${a.ability.name}`}>{humanize(a.ability.name)}</a>
              {a.is_hidden && ' (hidden)'}
            </li>
          ))}
        </ul>
      </Section>

      <Section title="Evolution">
        {chain ? (
          <Evolution nodes={[chain.chain]} current={species.name} />
        ) : (
          <ul class="evolution">
            <li>
              <a href={`/pokemon/${species.name}`}>{humanize(species.name)}</a>
            </li>
          </ul>
        )}
      </Section>

      <MovesSection pokemon={pokemon} game={Astro.url.searchParams.get('game')} />
    </Base>
  )
}
