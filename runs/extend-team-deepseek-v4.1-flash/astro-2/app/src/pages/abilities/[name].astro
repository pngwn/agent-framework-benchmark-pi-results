---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import Section from '../../components/Section.astro';
import CardList from '../../components/CardList.astro';
import { api } from '../../lib/api';
import { DASH, cardsForPokemon, englishName, englishShortEffect, latestEnglishFlavorText } from '../../lib/pokedex';

const name = (Astro.params.name ?? '').toLowerCase();
const ability = await api(`ability/${encodeURIComponent(name)}`);
if (!ability) Astro.response.status = 404;

const cards = ability
  ? await cardsForPokemon(ability.pokemon ?? [], (p: any) => (p.is_hidden ? 'Hidden ability' : undefined))
  : [];
const effect = ability
  ? (englishShortEffect(ability.effect_entries) ?? latestEnglishFlavorText(ability.flavor_text_entries) ?? DASH)
  : DASH;
---

{
  !ability ? (
    <NotFound />
  ) : (
    <Base title={englishName(ability)}>
      <h1>{englishName(ability)}</h1>

      <Section title="Effect">
        <p>{effect}</p>
      </Section>

      <Section title="Pokémon">
        <p class="count">{cards.length} Pokémon</p>
        <CardList cards={cards} />
      </Section>
    </Base>
  )
}
