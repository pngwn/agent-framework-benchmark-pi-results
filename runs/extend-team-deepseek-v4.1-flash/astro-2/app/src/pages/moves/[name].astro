---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import Section from '../../components/Section.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import CardList from '../../components/CardList.astro';
import { api } from '../../lib/api';
import {
  DASH,
  cardsForPokemon,
  englishName,
  englishShortEffect,
  getTypeLabels,
  humanize,
  latestEnglishFlavorText,
} from '../../lib/pokedex';

const name = (Astro.params.name ?? '').toLowerCase();
const move = await api(`move/${encodeURIComponent(name)}`);
if (!move) Astro.response.status = 404;

const [typeLabel, cards] = move
  ? await Promise.all([
      getTypeLabels(),
      cardsForPokemon((move.learned_by_pokemon ?? []).map((p: any) => ({ pokemon: p }))),
    ])
  : [null, []];

const show = (v: unknown) => (v === null || v === undefined ? DASH : String(v));
const effect = move
  ? (englishShortEffect(move.effect_entries) ?? latestEnglishFlavorText(move.flavor_text_entries) ?? DASH)
  : DASH;
---

{
  !move ? (
    <NotFound />
  ) : (
    <Base title={englishName(move)}>
      <h1>{englishName(move)}</h1>
      <dl class="facts panel">
        <div>
          <dt>Type</dt>
          <dd>{move.type ? <TypeBadge name={move.type.name} label={typeLabel!(move.type.name)} /> : DASH}</dd>
        </div>
        <div>
          <dt>Category</dt>
          <dd>{move.damage_class ? humanize(move.damage_class.name) : DASH}</dd>
        </div>
        <div>
          <dt>Power</dt>
          <dd>{show(move.power)}</dd>
        </div>
        <div>
          <dt>Accuracy</dt>
          <dd>{show(move.accuracy)}</dd>
        </div>
        <div>
          <dt>PP</dt>
          <dd>{show(move.pp)}</dd>
        </div>
      </dl>

      <Section title="Effect">
        <p>{effect}</p>
      </Section>

      <Section title="Learned by">
        <p class="count">{cards.length} Pokémon</p>
        <CardList cards={cards} />
      </Section>
    </Base>
  )
}
