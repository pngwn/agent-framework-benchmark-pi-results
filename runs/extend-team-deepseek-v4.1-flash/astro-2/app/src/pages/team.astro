---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CardList from '../components/CardList.astro';
import { getTeamMembers, getTypeCoverage, getTypes } from '../lib/pokedex';
import { getTeamFromCookies, MAX_TEAM_SIZE } from '../lib/team';

const team = getTeamFromCookies(Astro.cookies);
const [members, types] = await Promise.all([
  team.length ? getTeamMembers(team) : Promise.resolve([]),
  team.length ? getTypes() : Promise.resolve([]),
]);
const coverage = getTypeCoverage(types, members);
---

<Base title="Team">
  <h1>Team</h1>
  <p class="count">{team.length} of {MAX_TEAM_SIZE}</p>

  {
    team.length === 0 ? (
      <div class="empty-team panel">
        <p>Your team is empty</p>
        <p><a href="/">Browse Pokémon</a></p>
      </div>
    ) : (
      <>
        <CardList cards={members} removable />
        <Section title="Type coverage">
          <div class="table-scroll">
            <table class="coverage-table">
              <thead>
                <tr>
                  <th scope="col">Type</th>
                  <th scope="col">Weak</th>
                  <th scope="col">Resistant</th>
                </tr>
              </thead>
              <tbody>
                {coverage.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>{row.weak}</td>
                    <td>{row.resistant}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Section>
      </>
    )
  }
</Base>
