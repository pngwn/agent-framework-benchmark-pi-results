+
+        const name = button.dataset.teamAdd ?? button.dataset.teamRemove;
+        if (!name) return;
+
+        const team = readTeam();
+        if (button.dataset.teamAdd) {
+          if (team.includes(name) || team.length >= MAX_TEAM_SIZE) return;
