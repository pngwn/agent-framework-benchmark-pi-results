---
interface Props {
  name: string;
  label: string;
  link?: boolean;
}
const { name, label, link = true } = Astro.props;
const style = `--badge-bg: var(--type-${name}, var(--color-text-muted))`;
---

{
  link ? (
    <a class="type-badge" href={`/types/${name}`} style={style}>
      {label}
    </a>
  ) : (
    <span class="type-badge" style={style}>
      {label}
    </span>
  )
}
