---
interface Props {
  name: string;
  inTeam: boolean;
  full: boolean;
}
const { name, inTeam, full } = Astro.props;
const disabled = full && !inTeam;
---

<div class="team-actions">
  <button type="button" class="team-button" data-team-toggle data-team-name={name} disabled={disabled}>
    {inTeam ? 'Remove from team' : 'Add to team'}
  </button>
  {disabled && <span class="team-full">Team is full</span>}
</div>

<script>
  const TEAM_SIZE = 6;

  function readTeam(): string[] {
    const entry = document.cookie.split('; ').find((part) => part.startsWith('team='));
    return entry ? entry.slice('team='.length).split(',').filter(Boolean) : [];
  }

  function writeTeam(names: string[]) {
    document.cookie = `team=${names.join(',')}; Path=/; Max-Age=31536000; SameSite=Lax`;
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('[data-team-toggle]');
    if (!button) return;

    const name = button.dataset.teamName;
    if (!name) return;

    let team = readTeam();
    if (team.includes(name)) {
      team = team.filter((member) => member !== name);
    } else {
      if (team.length >= TEAM_SIZE) return;
      team = [...team, name];
    }
    writeTeam(team);

    const inTeam = team.includes(name);
    const full = team.length >= TEAM_SIZE;
    button.textContent = inTeam ? 'Remove from team' : 'Add to team';
    button.disabled = !inTeam && full;

    const actions = button.closest('.team-actions');
    let note = actions?.querySelector('.team-full');
    if (full && !inTeam) {
      if (!note && actions) {
        note = document.createElement('span');
        note.className = 'team-full';
        note.textContent = 'Team is full';
        actions.append(note);
      }
    } else {
      note?.remove();
    }
  });
</script>
