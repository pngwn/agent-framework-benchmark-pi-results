---
import Base from '../layouts/Base.astro';
import CardList from '../components/CardList.astro';
import Section from '../components/Section.astro';
import { getTypes } from '../lib/pokedex';
import { TEAM_COOKIE, getTeamMembers, parseTeam } from '../lib/team';

const names = parseTeam(Astro.cookies.get(TEAM_COOKIE)?.value);
const [members, types] = await Promise.all([getTeamMembers(names), getTypes()]);

const coverage = types.map((type) => {
  const relations = type.record.damage_relations ?? {};
  const namesIn = (key: string): Set<string> =>
    new Set((relations[key] ?? []).map((related: { name: string }) => related.name));

  const doubles = namesIn('double_damage_to');
  const halves = namesIn('half_damage_to');
  const none = namesIn('no_damage_to');

  let weak = 0;
  let resistant = 0;
  for (const member of members) {
    let multiplier = 1;
    for (const defender of member.types) {
      if (none.has(defender.name)) multiplier = 0;
      else if (doubles.has(defender.name)) multiplier *= 2;
      else if (halves.has(defender.name)) multiplier *= 0.5;
    }
    if (multiplier > 1) weak++;
    else if (multiplier < 1) resistant++;
  }

  return { name: type.name, label: type.label, weak, resistant };
});
---

<Base title="Team">
  <h1>Team</h1>
  <div id="team-content">
    <p class="team-count">{members.length} of 6</p>
    {
      members.length === 0 ? (
        <>
          <p>Your team is empty</p>
          <p><a href="/">Browse the Pokédex</a></p>
        </>
      ) : (
        <>
          <CardList cards={members} removable />
          <Section title="Type coverage">
            <div class="table-scroll">
              <table class="coverage">
                <thead>
                  <tr>
                    <th scope="col">Type</th>
                    <th scope="col">Weak</th>
                    <th scope="col">Resistant</th>
                  </tr>
                </thead>
                <tbody>
                  {coverage.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      <td>{row.weak}</td>
                      <td>{row.resistant}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </Section>
        </>
      )
    }
  </div>
</Base>

<script>
  const TEAM_COOKIE = 'team';

  function readTeam(): string[] {
    const entry = document.cookie.split('; ').find((part) => part.startsWith(`${TEAM_COOKIE}=`));
    return entry ? entry.slice(TEAM_COOKIE.length + 1).split(',').filter(Boolean) : [];
  }

  function writeTeam(names: string[]) {
    document.cookie = `${TEAM_COOKIE}=${names.join(',')}; Path=/; Max-Age=31536000; SameSite=Lax`;
  }

  async function refreshTeam() {
    try {
      const res = await fetch(location.pathname, { cache: 'no-store' });
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      const next = doc.getElementById('team-content');
      const current = document.getElementById('team-content');
      if (next && current) current.replaceWith(next);
      else location.reload();
    } catch {
      location.reload();
    }
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('[data-team-remove]');
    if (!button) return;

    const name = button.dataset.teamRemove;
    if (!name) return;

    writeTeam(readTeam().filter((member) => member !== name));
    void refreshTeam();
  });
</script>
