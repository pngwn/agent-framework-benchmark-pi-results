---
import Base from '../layouts/Base.astro';
import CardList from '../components/CardList.astro';
import { getHomeEntries, getTypes, getGenerations, humanize } from '../lib/pokedex';

const PAGE_SIZE = 48;

const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim();
const type = params.get('type') ?? '';
const generation = params.get('generation') ?? '';
const requestedPage = Math.max(1, parseInt(params.get('page') ?? '1', 10) || 1);

const [entries, types, generations] = await Promise.all([getHomeEntries(), getTypes(), getGenerations()]);

const needle = q.toLowerCase();
const matches = entries.filter(
  (e) =>
    (!needle || humanize(e.name).toLowerCase().includes(needle)) &&
    (!type || e.types.some((t) => t.name === type)) &&
    (!generation || e.generation === generation),
);

const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
const page = Math.min(requestedPage, totalPages);
const shown = matches.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

function pageHref(n: number) {
  const p = new URLSearchParams();
  if (q) p.set('q', q);
  if (type) p.set('type', type);
  if (generation) p.set('generation', generation);
  if (n > 1) p.set('page', String(n));
  const s = p.toString();
  return s ? `/?${s}` : '/';
}
---

<Base>
  <h1>Pokémon</h1>
  <form class="filters" method="get" action="/" data-filters>
    <div class="field field-search">
      <label for="filter-q">Search</label>
      <input id="filter-q" type="search" name="q" value={q} autocomplete="off" spellcheck="false" />
    </div>
    <div class="field">
      <label for="filter-type">Type</label>
      <select id="filter-type" name="type">
        <option value="">All types</option>
        {types.map((t) => <option value={t.name} selected={t.name === type}>{t.label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="filter-generation">Generation</label>
      <select id="filter-generation" name="generation">
        <option value="">All generations</option>
        {generations.map((g) => <option value={g.name} selected={g.name === generation}>{g.label}</option>)}
      </select>
    </div>
  </form>

  <div id="results">
    {
      matches.length === 0 ? (
        <p class="count">No Pokémon found</p>
      ) : (
        <>
          <p class="count">{matches.length} Pokémon</p>
          <CardList cards={shown} />
          <nav class="pagination" aria-label="Pagination">
            {page > 1 && <a href={pageHref(page - 1)}>Previous page</a>}
            <span>
              Page {page} of {totalPages}
            </span>
            {page < totalPages && <a href={pageHref(page + 1)}>Next page</a>}
          </nav>
        </>
      )
    }
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const search = form.querySelector<HTMLInputElement>('input[name="q"]')!;
  let controller: AbortController | undefined;
  let timer: ReturnType<typeof setTimeout> | undefined;

  function urlFromForm() {
    const params = new URLSearchParams();
    for (const [key, value] of new FormData(form)) {
      const v = String(value).trim();
      if (v) params.set(key, v);
    }
    const s = params.toString();
    return s ? `/?${s}` : '/';
  }

  async function load(url: string) {
    controller?.abort();
    controller = new AbortController();
    try {
      const res = await fetch(url, { signal: controller.signal });
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      const next = doc.getElementById('results');
      const current = document.getElementById('results');
      if (next && current) current.replaceWith(next);
    } catch (err) {
      if ((err as Error).name !== 'AbortError') location.assign(url);
    }
  }

  function apply(push: boolean) {
    clearTimeout(timer);
    const url = urlFromForm();
    if (url !== location.pathname + location.search) {
      history[push ? 'pushState' : 'replaceState'](null, '', url);
    }
    load(url);
  }

  search.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => apply(false), 200);
  });
  form.addEventListener('change', (event) => {
    if (event.target instanceof HTMLSelectElement) apply(true);
  });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    apply(false);
  });

  window.addEventListener('popstate', () => {
    const params = new URLSearchParams(location.search);
    for (const el of form.elements) {
      if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) el.value = params.get(el.name) ?? '';
    }
    load(location.pathname + location.search);
  });
</script>
